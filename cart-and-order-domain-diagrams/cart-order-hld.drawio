        <mxCell id="4C6fnufZI3ALLGgQdooV-26" parent="4C6fnufZI3ALLGgQdooV-19" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B21B6;" value="Three consumes, each ending in an Ack. A same version is a no-op. No store.changed: the store is read live. Own-app checkout never enters through Kafka." vertex="1">
          <mxGeometry height="56" width="304" x="40" y="268" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-27" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FEF9C3;strokeColor=#EAB308;" value="3. Cart &amp; Order engine · Go" vertex="1">
          <mxGeometry height="1008" width="780" x="1304" y="406" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-28" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" value="&lt;b&gt;PlaceOrder&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;gRPC · idempotency_key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;shopper waits · no Ack&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="16" y="148" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-29" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" value="&lt;b&gt;Cart&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;GetCart · UpdateCart · version&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;lines + coupons · priced live&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-30" parent="4C6fnufZI3ALLGgQdooV-27" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" value="One open cart per brand and customer. No stored price or discount: GetCart and UpdateCart call PriceLines, then EvaluateBasket, live. PlaceOrder checks out the cart and rejects a total the shopper did not see. A guest cart stays on the device; at login the app merges it in with one UpdateCart." vertex="1">
          <mxGeometry height="68" width="480" x="284" y="44" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-31" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Check, price, then pay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;ResolveStore · PriceLines · GetQuote&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;reserve deals · CreateTransaction&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="16" y="248" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-32" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;authorize_url&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;card or QR: returns on the gRPC&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;wallet: none, held at once&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="16" y="348" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-33" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;State machine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;rows in Postgres&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;status is the recovery point&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="284" y="148" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-34" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Auth, then capture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;hold at authorize&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;capture only after POS accepts&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="284" y="248" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-35" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;POS dispatch worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;outbox · calls BSL proxy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;gRPC · not a topic&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="212" x="552" y="248" as="geometry" />
        </mxCell>
        <mxCell id="4C6fnufZI3ALLGgQdooV-36" parent="4C6fnufZI3ALLGgQdooV-27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Checkout sweeper · cron&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;unpaid checkout · silent POS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;close, then void via the outbox&lt;/font&gt;" vertex="1">

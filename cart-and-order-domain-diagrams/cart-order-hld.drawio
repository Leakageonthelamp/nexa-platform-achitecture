        <mxCell id="4C6fnufZI3ALLGgQdooV-25" parent="4C6fnufZI3ALLGgQdooV-24" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">

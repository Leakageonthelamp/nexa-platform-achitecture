        <mxCell id="n2" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0F172A;fontStyle=1;" value="Cart &amp; Order — the shopper waits on gRPC, the bus carries what already happened" vertex="1">

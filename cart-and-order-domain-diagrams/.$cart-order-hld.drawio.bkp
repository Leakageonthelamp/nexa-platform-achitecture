        </mxCell>
        <mxCell id="n66" parent="n63" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;carts · orders · price lines · status · POS ticket · outbox&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;The status row is the saga. Valkey is not the cart (D-04).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;No workflow engine and no internal topic for the POS call.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="612" x="14" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n67" parent="n66" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1">

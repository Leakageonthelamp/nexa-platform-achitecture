        <mxCell id="n10" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;fillColor=#FEF9C3;strokeColor=#EAB308;swimlaneFillColor=#FEF9C3;strokeWidth=1.5;" value="3. Cart &amp;amp; Order engine · Go" vertex="1">
          <mxGeometry height="992" width="1000" x="348" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n27" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" value="&lt;b&gt;PlaceOrder · GetCart · UpdateCart&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;gRPC · the shopper waits · no Ack&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;cart_version · expected_total_satang · quote_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;lines only, one cart per brand and customer (P-31)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="968" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Check, price, then pay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;ResolveStore, then PriceLines. A different total is price_changed. Nothing is committed.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;GetQuote for a delivery order (P-22). CreateTransaction on Payment (D-02).&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;A new key cancels the previous pending order and voids its hold (P-32).&lt;/font&gt;" vertex="1">
          <mxGeometry height="270" width="968" x="16" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;authorize_url&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;card or QR: returned on the gRPC&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;wallet: none, held at once (D-09)&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="310" x="16" y="422" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Auth, then capture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;hold at authorize&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;capture only after the POS accepts&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="310" x="342" y="422" as="geometry" />
        </mxCell>
        <mxCell id="n31" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;State machine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;rows in Postgres&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;status is the recovery point&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="316" x="668" y="422" as="geometry" />
        </mxCell>
        <mxCell id="n32" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Checkout sweeper&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;every minute · unpaid or silent POS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;close, then void (P-10)&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="310" x="16" y="526" as="geometry" />
        </mxCell>
        <mxCell id="n33" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;POS dispatch worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;outbox, then the BSL proxy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;gRPC · not a topic&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="310" x="342" y="526" as="geometry" />
        </mxCell>
        <mxCell id="n34" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Outbox relay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;state and outbox, one commit&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;facts leave after the commit&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="316" x="668" y="526" as="geometry" />
        </mxCell>
        <mxCell id="n35" parent="n10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;" value="&lt;b&gt;order.requested&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;apply if newer, then the state machine&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;aggregator is placed at create (P-09)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="780" x="16" y="680" as="geometry" />
        </mxCell>

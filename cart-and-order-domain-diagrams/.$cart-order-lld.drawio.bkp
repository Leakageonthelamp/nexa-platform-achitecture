        </mxCell>
        <mxCell id="n12" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;3 · Aurora · commit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;replace the lines&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;version + 1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;insert when version = 0&lt;/font&gt;" vertex="1">

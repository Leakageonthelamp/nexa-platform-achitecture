        <mxCell id="n2" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#0F172A;fontStyle=1;" value="Cart &amp;amp; Order LLD 7 — GetCart and UpdateCart, priced live" vertex="1">
          <mxGeometry height="32" width="1920" x="24" y="12" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;" value="The shopper adds, changes, or removes a line. customer-bff calls UpdateCart with the whole cart and the version it last saw. Order saves the lines and prices them with PriceLines (P-31). Nothing is Kafka, so there is no Ack." vertex="1">
          <mxGeometry height="36" width="1920" x="24" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#EA580C;fillColor=#FFF7ED;strokeColor=#EA580C;" value="gRPC  ·  sync, the caller waits" vertex="1">

          <mxGeometry height="400" width="410" x="1906" y="988" as="geometry" />
        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-39" parent="bJqr_Ron0BRTAvgHyiJd-38" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Safe twice: the version check skips an order another run or a late webhook already moved.&lt;br&gt;• A late authorized after a timeout hits LLD 2 as an illegal transition, so it is voided.&lt;br&gt;• Forbid stops two runs overlapping; SKIP LOCKED stops a run blocking a live consumer.&lt;br&gt;• Schedule and flow also go in the Cart &amp; Order service’s docs/cron-flow.md." vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-40" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
          <mxGeometry height="400" width="460" x="2332" y="988" as="geometry" />
        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-41" parent="bJqr_Ron0BRTAvgHyiJd-40" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-10: timeouts are a sweeper, not a timer service.&lt;br&gt;• P-07: cron mode is a Kubernetes CronJob.&lt;br&gt;• ponytail: precision is the cron interval. Upgrade: Temporal when a step needs a durable timer.&lt;br&gt;• O-04: the pay window and the POS window are business decisions." vertex="1">
          <mxGeometry height="344" width="428" x="16" y="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

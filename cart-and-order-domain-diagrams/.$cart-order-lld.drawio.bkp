        <mxCell id="n7" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#059669;fillColor=#ECFDF5;strokeColor=#059669;" value="Kafka fact  ·  after the commit" vertex="1">
          <mxGeometry height="28" width="400" x="1092" y="86" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" value="Failure exit  ·  status or DLQ" vertex="1">

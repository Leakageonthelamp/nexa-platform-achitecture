        <mxCell id="n16" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;cannot save&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;version moved → ABORTED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;plus the current cart&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;bad line → INVALID_ARGUMENT&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="210" x="442.5" y="168" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;cannot price&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;the cart is still saved&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;sold out → sku_ids flagged&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;down → priced = false&lt;/font&gt;" vertex="1">

      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="IR2pni44WlJNj3Vr41bI-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Cart &amp; Order LLD 2 — Payment result: payment.events moves the order" vertex="1">
          <mxGeometry height="32" width="1920" x="416" y="776" as="geometry" />
        </mxCell>
        <mxCell id="IR2pni44WlJNj3Vr41bI-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="Payment publishes authorized, failed, captured, or voided. Order applies it to the order it owns, then Acks. authorized is the moment an order becomes placed.  Draft LLD: field names and status values are to be aligned with the business." vertex="1">

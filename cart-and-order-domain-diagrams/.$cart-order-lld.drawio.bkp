        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-37" parent="bJqr_Ron0BRTAvgHyiJd-36" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="orders&lt;br&gt;&amp;nbsp;&amp;nbsp;status · version + 1 · closed_reason&lt;br&gt;&lt;br&gt;outbox (same transaction)&lt;br&gt;&amp;nbsp;&amp;nbsp;payment.requested{void}&lt;br&gt;&amp;nbsp;&amp;nbsp;order.events{cancelled | rejected}&lt;br&gt;&lt;br&gt;audit&lt;br&gt;&amp;nbsp;&amp;nbsp;actor = system:sweeper" vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>

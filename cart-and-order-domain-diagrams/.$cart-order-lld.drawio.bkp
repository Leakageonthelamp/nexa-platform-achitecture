        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-40" parent="hQj3xvluMVmtVNeUAmoi-39" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic order.requested  key brand_id:order_id&lt;br&gt;&lt;br&gt;message OrderRequested {&lt;br&gt;&amp;nbsp;&amp;nbsp;string order_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;oneof request {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Create    create     = 10;  // aggregator&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Replace   replace    = 11;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Cancel    cancel     = 12;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PosStatus pos_status = 13;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;message PosStatus {&lt;br&gt;&amp;nbsp;&amp;nbsp;string pos_ticket_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string status        = 2;   // accepted | rejected&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ready | completed&lt;br&gt;&amp;nbsp;&amp;nbsp;string reason        = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  pos_at_unix   = 4;&lt;br&gt;}&lt;br&gt;&lt;br&gt;topic payment.requested key brand_id:transaction_id&lt;br&gt;&amp;nbsp;&amp;nbsp;oneof capture{amount_satang} | void{reason}" vertex="1">
          <mxGeometry height="344" width="568" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-41" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">
          <mxGeometry height="400" width="410" x="1544" y="1004" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-42" parent="hQj3xvluMVmtVNeUAmoi-41" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="processed_event&lt;br&gt;&amp;nbsp;&amp;nbsp;event_id PK · topic · applied_at&lt;br&gt;&lt;br&gt;orders&lt;br&gt;&amp;nbsp;&amp;nbsp;status · version + 1 · pos_ticket_id&lt;br&gt;&lt;br&gt;outbox (same transaction)&lt;br&gt;&amp;nbsp;&amp;nbsp;order.events{accepted | rejected}&lt;br&gt;&amp;nbsp;&amp;nbsp;payment.requested{capture}  accepted&lt;br&gt;&amp;nbsp;&amp;nbsp;payment.requested{void}     rejected&lt;br&gt;&lt;br&gt;pos_job (LLD 2 → worker)&lt;br&gt;&amp;nbsp;&amp;nbsp;order_id · attempts · next_at" vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-43" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1">
          <mxGeometry height="400" width="410" x="1970" y="1004" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-44" parent="hQj3xvluMVmtVNeUAmoi-43" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Command, so dedupe on event_id: INSERT into processed_event in the same transaction.&lt;br&gt;• Key brand_id:order_id keeps create, cancel, and POS status for one order in order.&lt;br&gt;• POS worker: gRPC to the BSL proxy with a deadline; retry 3× with backoff, then reject and void.&lt;br&gt;• If the POS never answers, the sweeper rejects and voids (LLD 4)." vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-45" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
          <mxGeometry height="400" width="460" x="2396" y="1004" as="geometry" />
        </mxCell>
        <mxCell id="hQj3xvluMVmtVNeUAmoi-46" parent="hQj3xvluMVmtVNeUAmoi-45" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Accepted + capture command commit together, so a crash can’t leave food accepted with no capture.&lt;br&gt;• The POS call is a worker, not a topic (§10 guardrails).&lt;br&gt;• ready and completed follow the same path without a payment command.&lt;br&gt;• BSL only; Promise and VIVI are the same worker with another proxy." vertex="1">
          <mxGeometry height="344" width="428" x="16" y="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 · Checkout sweeper cron" id="lld-3">
    <mxGraphModel dx="3142" dy="2102" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Cart &amp; Order LLD 4 — Checkout sweeper: close what never got an answer" vertex="1">
          <mxGeometry height="32" width="1920" x="872" y="456" as="geometry" />
        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="A Kubernetes CronJob in Order’s cron mode. It closes unpaid checkouts and POS tickets that never got an answer, and sends a void for the held money. No workflow engine.  Draft LLD: field names and status values are to be aligned with the business." vertex="1">
          <mxGeometry height="34" width="1920" x="872" y="490" as="geometry" />

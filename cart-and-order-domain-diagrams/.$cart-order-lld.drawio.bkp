        <mxCell id="hQj3xvluMVmtVNeUAmoi-39" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields (draft)" vertex="1">

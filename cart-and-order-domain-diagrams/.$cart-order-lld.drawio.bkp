        <mxCell id="bJqr_Ron0BRTAvgHyiJd-35" parent="bJqr_Ron0BRTAvgHyiJd-34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="cron: &quot;* * * * *&quot;  timeZone Asia/Bangkok&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; every minute, on the minute&lt;br&gt;&lt;br&gt;SELECT order_id, version, status&lt;br&gt;FROM   orders&lt;br&gt;WHERE  brand_id = $brand&lt;br&gt;&amp;nbsp;&amp;nbsp;AND ( (status = &#39;pending_payment&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AND created_at &amp;lt; now() - $pay_window)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OR (status = &#39;sent_to_pos&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AND sent_at    &amp;lt; now() - $pos_window) )&lt;br&gt;ORDER  BY created_at&lt;br&gt;LIMIT  500&lt;br&gt;FOR UPDATE SKIP LOCKED;&lt;br&gt;&lt;br&gt;$pay_window, $pos_window: O-04 (open)" vertex="1">
          <mxGeometry height="344" width="568" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bJqr_Ron0BRTAvgHyiJd-36" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">

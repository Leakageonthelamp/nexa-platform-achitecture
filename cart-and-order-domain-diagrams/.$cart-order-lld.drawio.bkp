        <mxCell id="jtHBeP4A4pdCOwk4VGgD-29" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields (draft)" vertex="1">
          <mxGeometry height="400" width="600" x="1232" y="1364" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-30" parent="jtHBeP4A4pdCOwk4VGgD-29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic delivery.events   key brand_id:delivery_id&lt;br&gt;headers event_id · event_type · brand_id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;occurred_at · version · traceparent&lt;br&gt;&lt;br&gt;message DeliveryEvent {&lt;br&gt;&amp;nbsp;&amp;nbsp;string delivery_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string order_id&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 2;   // empty for FAAS&lt;br&gt;&amp;nbsp;&amp;nbsp;oneof event {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Dispatched&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dispatched&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 10;  // Ack&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RiderAssigned rider_assigned = 11;  // Ack&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PickedUp&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;picked_up&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 12;  // Ack&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Delivered&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;delivered&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 13;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Failed&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;failed&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 14;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Cancelled&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cancelled&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= 15;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;// Delivered carries the timeline, distance, and fees.&lt;br&gt;// No rider phone, no customer address (P-24)." vertex="1">
          <mxGeometry height="344" width="568" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-31" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">
          <mxGeometry height="400" width="410" x="1848" y="1364" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-32" parent="jtHBeP4A4pdCOwk4VGgD-31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="orders&lt;br&gt;&amp;nbsp;&amp;nbsp;status · version + 1&lt;br&gt;&amp;nbsp;&amp;nbsp;delivery_id · delivery_version&lt;br&gt;&lt;br&gt;outbox (same transaction)&lt;br&gt;&amp;nbsp;&amp;nbsp;order.events{completed}&amp;nbsp;&amp;nbsp;on delivered&lt;br&gt;&lt;br&gt;csc_queue (until O-14 is decided)&lt;br&gt;&amp;nbsp;&amp;nbsp;order_id · reason&amp;nbsp;&amp;nbsp;on failed or cancelled&lt;br&gt;&lt;br&gt;processed by: Outbox relay" vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1">
          <mxGeometry height="400" width="410" x="2274" y="1364" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-34" parent="jtHBeP4A4pdCOwk4VGgD-33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Fact, so dedupe on version: apply only when record.version &amp;gt; orders.delivery_version.&lt;br&gt;• order_id is empty for a FAAS delivery: Ack with no work.&lt;br&gt;• Ack = commit the offset after the Postgres commit. Auto-commit is off.&lt;br&gt;• Retry 3× with backoff inside the app, then order.dlq, then Ack.&lt;br&gt;• completed already set (pickup or a POS completed first): same status, Ack with no work." vertex="1">
          <mxGeometry height="344" width="378" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
          <mxGeometry height="400" width="460" x="2700" y="1364" as="geometry" />
        </mxCell>
        <mxCell id="jtHBeP4A4pdCOwk4VGgD-36" parent="jtHBeP4A4pdCOwk4VGgD-35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-21: dispatch starts on order.events{accepted}, so this topic only follows an accepted order.&lt;br&gt;• P-20: delivered and cancelled never change; a later record for them is a no-op.&lt;br&gt;• O-14 is open: when every provider fails, auto-cancel and refund, or wait for CSC.&lt;br&gt;• Notification messages the shopper from delivery.events itself. Order does not send a second message.&lt;br&gt;• P-05 relay · P-06 consumer rules." vertex="1">
          <mxGeometry height="344" width="428" x="16" y="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7 · Cart: GetCart and UpdateCart" id="lld-6">
    <mxGraphModel grid="1" page="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />

        <mxCell id="n25" parent="n24" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="rpc GetCart(GetCartRequest) returns (Cart);&lt;br&gt;rpc UpdateCart(UpdateCartRequest) returns (Cart);&lt;br&gt;message UpdateCartRequest {&lt;br&gt;  int64 version = 1;  // 0 = new cart&lt;br&gt;  string store_id = 2;&lt;br&gt;  repeated Line lines = 5;  // sku_id · qty · modifier_ids&lt;br&gt;}&lt;br&gt;// No price column on the request. A price sent here is ignored." vertex="1">
          <mxGeometry height="348" width="576" x="12" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n26" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;" value="Writes  ·  tables and outbox" vertex="1">
          <mxGeometry height="400" width="410" x="632" y="540" as="geometry" />
        </mxCell>
        <mxCell id="n27" parent="n26" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="carts&lt;br&gt;  PK(brand_id, customer_id)  one open cart&lt;br&gt;  lines jsonb · version · updated_at&lt;br&gt;No price column. The price is derived on every read.&lt;br&gt;outbox: nothing. A cart is not a fact.&lt;br&gt;Deleted when its order is placed (LLD 2)." vertex="1">
          <mxGeometry height="348" width="386" x="12" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;" value="Dedupe  ·  deadline  ·  retry" vertex="1">
          <mxGeometry height="400" width="410" x="1058" y="540" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="n28" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• Dedupe is the version (P-01). A lost response retries as ABORTED with the cart that already holds the change.&lt;br&gt;• UpdateCart sends the whole cart.&lt;br&gt;• There is no expiry (P-31). An abandoned cart stays until the next checkout.&lt;br&gt;• GetCart is steps 4 and 5 on the stored cart. It writes nothing." vertex="1">
          <mxGeometry height="348" width="386" x="12" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;" value="Notes  ·  decisions cited" vertex="1">
          <mxGeometry height="400" width="460" x="1484" y="540" as="geometry" />
        </mxCell>
        <mxCell id="n31" parent="n30" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• P-31: lines only. Catalog prices them live.&lt;br&gt;• P-32: PlaceOrder checks out this cart by version and expected total (LLD 1).&lt;br&gt;• A guest cart stays on the device. guest-bff has no cart. After login the app sends it with UpdateCart.&lt;br&gt;• O-21: deal stacking is not on this path." vertex="1">
          <mxGeometry height="348" width="436" x="12" y="40" as="geometry" />
        </mxCell>
      </root>

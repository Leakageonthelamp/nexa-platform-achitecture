        <mxCell id="n24" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;" value="Contract  ·  fields (draft)" vertex="1">
          <mxGeometry height="400" width="600" x="16" y="540" as="geometry" />

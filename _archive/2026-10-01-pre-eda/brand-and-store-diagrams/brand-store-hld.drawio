        <mxCell id="st-c" parent="seng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#5B21B6;" value="&lt;b&gt;Contract&lt;/b&gt;  Admin BFF writes  ·  guest-bff and customer-bff read ResolveStore and ListNearest  ·  facts after commit  ·  import is the only command" vertex="1">

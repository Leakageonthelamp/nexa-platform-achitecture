          <mxGeometry height="68" width="728" x="16" y="476" as="geometry" />
        </mxCell>
        <mxCell id="seng-n" parent="seng" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#A16207;" value="One store, one brand_id. Store Engine reads brand live from Brand Engine. Never calls Azure. Never mints a session." vertex="1">
          <mxGeometry height="28" width="728" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="st-f-st" parent="seng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;" value="&lt;b&gt;Facts after commit&lt;/b&gt;  store.upserted · store.group.upserted · hours · status · zone · availability&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#A16207&quot;&gt;store key = brand_id:store_id · group key = brand_id:group_id · each fact carries version&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="728" x="16" y="360" as="geometry" />
        </mxCell>
        <mxCell id="seng-dep" parent="seng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;" value="&lt;b&gt;brand.published effects&lt;/b&gt;  newer version only&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#047857&quot;&gt;live → Catalog shows the brand, store writes and shopper reads turn on&lt;br&gt;not-live → Catalog hides it, writes reject, reads omit · store rows stay&lt;/font&gt;" vertex="1">

        <mxCell id="n27" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="The lead time is open (O-13). An order with no due time never enters pending; LLD 2 dispatches it at accepted." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n29" parent="n28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="Reads deliveries where&lt;br&gt;status = pending and&lt;br&gt;due_at minus the lead is past.&lt;br&gt;&lt;br&gt;Same provider Create as LLD 2.&lt;br&gt;Same dispatched fact." vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n31" parent="n30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;deliveries&lt;/b&gt; — status pending → dispatching, or failed. version + 1.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;delivery_status&lt;/b&gt; — the transition.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — dispatched or failed." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n33" parent="n32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Same claim as the sweeper: update where status=pending and version matches.&lt;br&gt;&lt;br&gt;• A second run finds nothing to do." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n34" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n35" parent="n34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-21: scheduled orders wait here. Everything else waits for accepted.&lt;br&gt;&lt;br&gt;• One cron, two queries: no-rider (LLD 4) and due pending (here). No separate scheduler.&lt;br&gt;&lt;br&gt;• The quote TTL is not re-checked. GetQuote already ran at PlaceOrder, and the fee is on the order." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>
      </root>

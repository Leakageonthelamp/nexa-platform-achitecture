        <mxCell id="n27" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="Safe to run twice. A row already moved on is skipped. The wait and the max attempts are open (O-13). There is no timer service." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n29" parent="n28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="No new message. Reads deliveries where&lt;br&gt;status = dispatching and&lt;br&gt;updated_at older than the wait.&lt;br&gt;&lt;br&gt;Publishes delivery.events&lt;br&gt;dispatched { attempt } or failed." vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n31" parent="n30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;deliveries&lt;/b&gt; — attempt + 1 and the new provider, or status=failed.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;delivery_status&lt;/b&gt; — the cancel and the new create.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — one fact.&lt;br&gt;&lt;br&gt;&lt;br&gt;No processed_event. This is a cron." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n33" parent="n32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Claim the row with UPDATE ... WHERE status=dispatching AND version=?. A second runner gets zero rows.&lt;br&gt;&lt;br&gt;• Provider cancel and create use delivery_id plus attempt as the idempotency key.&lt;br&gt;&lt;br&gt;• Schedule is a Kubernetes CronJob, Forbid, Asia/Bangkok (P-07). The interval is open with O-13." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n34" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n35" parent="n34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-19: timeout fallback is the same list as create-fail fallback.&lt;br&gt;&lt;br&gt;• ponytail: a sweeper, not a durable timer. Ceiling: precision is the cron interval. Upgrade: a timer service, if the wait must be exact.&lt;br&gt;&lt;br&gt;• Do not mark failed while the cancel itself failed. The provider may still hold the job." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>

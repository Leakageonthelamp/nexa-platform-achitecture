        <mxCell id="n36" parent="n35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Fact: version. Command from admin: idempotency_key, unique.&lt;br&gt;&lt;br&gt;• A cancel of an already cancelled delivery returns the row. It does not call the provider again." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n37" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n38" parent="n37" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-20: cancelled is terminal. A later provider update cannot revive it.&lt;br&gt;&lt;br&gt;• The admin grant is checked by admin-bff before this call." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>

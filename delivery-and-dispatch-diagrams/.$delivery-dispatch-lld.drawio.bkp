        <mxCell id="n34" parent="n33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;earnings&lt;/b&gt; — brand_id=mfg. A trip row points at delivery_id, with payout_id and payout_status=sending.&lt;br&gt;&lt;br&gt;&lt;br&gt;The amount never changes. payout_status is the only field that moves.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — delivery.events delivered, and payment.requested payout." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>

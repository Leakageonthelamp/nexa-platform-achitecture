        <mxCell id="n32" parent="n31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc Cancel(CancelRequest) returns (Delivery);&lt;br&gt;message CancelRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string delivery_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 version = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string reason = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;string idempotency_key = 4;&lt;br&gt;}&lt;br&gt;order.events cancelled { order_id }" vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n34" parent="n33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;deliveries&lt;/b&gt; — status=cancelled, version + 1, cancel_reason.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;delivery_status&lt;/b&gt; — cancelled.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — delivery.events cancelled.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;audit&lt;/b&gt; — on the admin path, in the same commit." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>

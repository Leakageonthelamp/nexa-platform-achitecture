        <mxCell id="n26" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="fail" edge="1" source="n14" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=center;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" value="&lt;b&gt;GetRider down&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;retry 3, then DLQ&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;status not committed&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="172" width="216" height="84" as="geometry"/></mxCell>
        <mxCell id="n28" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="fail" edge="1" source="n16" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=center;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" value="&lt;b&gt;Outbox relay · worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay per domain&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;after the commit&lt;/font&gt;" vertex="1"><mxGeometry x="1072" y="172" width="216" height="84" as="geometry"/></mxCell>
        <mxCell id="n30" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="async" edge="1" source="n18" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=left;spacingLeft=62;fillColor=#ECFDF5;strokeColor=#059669;" value="&lt;b&gt;delivery.events&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;the new status&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;as a fact&lt;/font&gt;" vertex="1"><mxGeometry x="1336" y="172" width="216" height="84" as="geometry"/></mxCell>
        <mxCell id="n32" parent="n31" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n33" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="publish" edge="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n34" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="Sub-steps (at store, at customer) are timestamps on delivery_status, not states (P-20). A delivered row writes the trip earnings row, with its payout, in this same commit (LLD 12)." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n36" parent="n35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="provider_update {&lt;br&gt;&amp;nbsp;&amp;nbsp;string delivery_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string provider_code = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string canonical = 3;  // assigned|picked_up|delivered|failed|cancelled&lt;br&gt;&amp;nbsp;&amp;nbsp;string rider_ref = 4;  // no name, no phone&lt;br&gt;&amp;nbsp;&amp;nbsp;int32 distance_m = 5;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 occurred_at = 6;&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n37" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n38" parent="n37" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;deliveries&lt;/b&gt; — status, version + 1, rider_id, timestamps.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;delivery_status&lt;/b&gt; — append the canonical status and the raw code.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;earnings&lt;/b&gt; — one trip row when canonical is delivered, payout_status=sending (LLD 12).&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — delivery.events for the new status. On delivered, also payment.requested payout.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;processed_event&lt;/b&gt; — event_id." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n39" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n40" parent="n39" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Commands dedupe on event_id. The insert is in the same transaction as the status change.&lt;br&gt;&lt;br&gt;• A lower rank, or a repeat of delivered or cancelled, is an Ack with no write. This is the UNB-1811 guard (P-20).&lt;br&gt;&lt;br&gt;• GetRider failure does not commit, so the redelivery tries again." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n41" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n42" parent="n41" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-18: the mapping from ZEEK codes and Grab codes happens in partner-adapter, once.&lt;br&gt;&lt;br&gt;• P-24: a ZEEK rider_ref must already be in the registry. A Grab rider is fetched here and stored by ref, without a phone on the bus.&lt;br&gt;&lt;br&gt;• delivered carries the timeline, the distance, and the fees. Not the address." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

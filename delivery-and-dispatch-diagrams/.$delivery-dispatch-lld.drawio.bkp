        <mxCell id="n35" parent="n34" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n36" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="publish" edge="1" source="n32" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="Pickup orders never enter this flow. A FAAS delivery starts at LLD 8 instead of steps 2 and 3. The rider is paid in the delivered commit, not by a later cron." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n38" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n39" parent="n38" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="Spine only. Field shapes are on&lt;br&gt;LLD 1 to LLD 13.&lt;br&gt;&lt;br&gt;Shopper waits: steps 1 and 2.&lt;br&gt;After accepted, nobody waits.&lt;br&gt;Each consume Acks after its&lt;br&gt;own commit (LLD 2, LLD 3)." vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n40" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n41" parent="n40" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="quotes, then deliveries, then delivery_status, then earnings with its payout status.&lt;br&gt;&lt;br&gt;&lt;br&gt;Each commit is on its own page. This page adds no table." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n42" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n43" parent="n42" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• quote_id is used once, at PlaceOrder.&lt;br&gt;&lt;br&gt;• delivery_id is the provider idempotency key.&lt;br&gt;&lt;br&gt;• A redelivered status is an Ack (P-20)." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n44" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n45" parent="n44" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-21 and P-22: quote first, dispatch at accepted.&lt;br&gt;&lt;br&gt;• P-18: swapping ZEEK for another provider changes a package and a mapper. This spine does not change.&lt;br&gt;&lt;br&gt;• ponytail: we do not allocate the rider. The provider does." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="n28" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="GetQuote(quote_id) is a read of the same row. Expired, used, or wrong brand is FAILED_PRECONDITION. A gRPC path has no Ack." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n29" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n30" parent="n29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc Quote(QuoteRequest) returns (Quote);&lt;br&gt;rpc GetQuote(GetQuoteRequest) returns (Quote);&lt;br&gt;&lt;br&gt;message QuoteRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string idempotency_key = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string store_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;double drop_lat = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;double drop_lng = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;string address_id = 5;  // Identity ref, no street text&lt;br&gt;}&lt;br&gt;message Quote {&lt;br&gt;&amp;nbsp;&amp;nbsp;string quote_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 fee_satang = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32 distance_m = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32 eta_min = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;string distance_type = 5;  // geo | road&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n31" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n32" parent="n31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;quotes&lt;/b&gt; — quote_id, brand_id, store_id, address_id, drop lat/lng, distance_m, distance_type, fee_satang, eta_min, expires_at, idempotency_key.&lt;br&gt;&lt;br&gt;&lt;br&gt;No outbox row. A quote is not a fact.&lt;br&gt;&lt;br&gt;&lt;br&gt;GetQuote writes nothing." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n34" parent="n33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Dedupe: UNIQUE(brand_id, idempotency_key). A repeat returns the first quote.&lt;br&gt;&lt;br&gt;• Deadline: passed on to ResolveStore and to Google. Not reset.&lt;br&gt;&lt;br&gt;• Retry: only UNAVAILABLE, and only with the same key.&lt;br&gt;&lt;br&gt;• ETA is distance over a configured speed (P-29). It firms up at rider_assigned." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n36" parent="n35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-22: Order calls GetQuote at PlaceOrder and stores quote_id. The fee on the order is the fee quoted here.&lt;br&gt;&lt;br&gt;• P-29: no fleet call on this path. The shopper does not wait on ZEEK.&lt;br&gt;&lt;br&gt;• O-15: TTL, max distance, road threshold, and the fee scheme are still open. The row can hold them.&lt;br&gt;&lt;br&gt;• No personal data. address_id only." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="n23" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="fail" edge="1" source="n11" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n24" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=center;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" value="&lt;b&gt;store not orderable&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;FAILED_PRECONDITION&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;or UNAVAILABLE&lt;/font&gt;" vertex="1"><mxGeometry x="544" y="172" width="216" height="84" as="geometry"/></mxCell>
        <mxCell id="n25" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="fail" edge="1" source="n13" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n26" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=center;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" value="&lt;b&gt;too far&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;FAILED_PRECONDITION&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;Google down: UNAVAILABLE&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="172" width="216" height="84" as="geometry"/></mxCell>

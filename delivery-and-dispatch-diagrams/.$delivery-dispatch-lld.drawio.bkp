        <mxCell id="n28" parent="n9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="Delivery never calls TrueMoney (P-25). A row that stays sending, or ends failed, is picked up by the reconcile cron (LLD 16). It does not send money, and it does not open a second payout." vertex="1"><mxGeometry x="16" y="292" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="n29" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="n30" parent="n29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="payment.requested payout {&lt;br&gt;&amp;nbsp;&amp;nbsp;string payout_id = 1;  // we choose it&lt;br&gt;&amp;nbsp;&amp;nbsp;string delivery_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string rider_id = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 amount_satang = 4;&lt;br&gt;}&lt;br&gt;// brand_id header is mfg&lt;br&gt;payment.events paid_out | payout_failed" vertex="1"><mxGeometry x="16" y="44" width="568" height="340" as="geometry"/></mxCell>
        <mxCell id="n31" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n32" parent="n31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="&lt;b&gt;earnings&lt;/b&gt; — the trip row. payout_id and payout_status=sending in the delivered commit; paid or failed on settle. No separate payouts table.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox&lt;/b&gt; — payment.requested payout, same commit as delivered.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;processed_event&lt;/b&gt; — the payment.events version." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry"/></mxCell>
        <mxCell id="n34" parent="n33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• UNIQUE(delivery_id) where kind=trip. A second delivered update cannot pay the trip twice.&lt;br&gt;&lt;br&gt;• paid_out dedupes on version. A repeat does not mark the payout twice." vertex="1"><mxGeometry x="16" y="44" width="378" height="340" as="geometry"/></mxCell>
        <mxCell id="n35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry"/></mxCell>
        <mxCell id="n36" parent="n35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-25: Payment owns the TrueMoney call and publishes the result.&lt;br&gt;&lt;br&gt;• O-16: the TrueMoney merchant account is still open. There is no schedule and no minimum.&lt;br&gt;&lt;br&gt;• The other payment.events variants are an Ack with no work." vertex="1"><mxGeometry x="16" y="44" width="428" height="340" as="geometry"/></mxCell>

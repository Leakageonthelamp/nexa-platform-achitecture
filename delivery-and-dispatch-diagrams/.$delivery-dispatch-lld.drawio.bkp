        <mxCell id="n31" parent="n9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;spacingRight=8;strokeWidth=1.5;align=left;spacingLeft=62;fillColor=#ECFDF5;strokeColor=#059669;" value="&lt;b&gt;delivery.events&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;dispatched, or failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;key brand_id:delivery_id&lt;/font&gt;" vertex="1"><mxGeometry x="1336" y="172" width="216" height="84" as="geometry"/></mxCell>

    <mxCell id="n1" value="&lt;b&gt;Same person, other brands:&lt;/b&gt; disabling Brand B does not touch the Minor ID or the memberships in other brands. A customer who stays in one brand is a Minor ID with one enabled membership." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">

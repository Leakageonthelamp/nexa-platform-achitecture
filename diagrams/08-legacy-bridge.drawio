     </mxGeometry>
    </mxCell>
    <mxCell id="tbl" value="&lt;b&gt;The capability route table (owned by the domain that has the legacy adapter)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#475569&quot;&gt;brand_id, capability: what is routed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#475569&quot;&gt;mode: legacy, shadow, canary or native&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#475569&quot;&gt;canary: a list of stores (assumption: by store, so one store behaves the same all day)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#475569&quot;&gt;version and audit: same rules as other brand configuration&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=13;fontColor=#0F172A;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="430" width="820" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="chk" value="&lt;b&gt;Check before moving on&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#854D0E&quot;&gt;legacy to shadow: the legacy adapter passes the same contract tests as the native one (assumption: one suite per port)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#854D0E&quot;&gt;shadow to canary: the recorded differences are explained, the owner accepts the rest&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#854D0E&quot;&gt;canary to native: every store ran on native through a full trading day, including a peak&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#854D0E&quot;&gt;native to done: no calls to legacy for the agreed period (assumption: 30 days)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=13;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="880" y="430" width="840" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="rb" value="&lt;b&gt;Rollback has a cost: decide it before the canary step (O-31)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#B91C1C&quot;&gt;Going back is safe only while data written by native can still be read by legacy, or while no native-only data exists.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#B91C1C&quot;&gt;Otherwise rollback means a reverse sync or a freeze window. Each capability must say which one it is.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=13;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="620" width="1696" height="100" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

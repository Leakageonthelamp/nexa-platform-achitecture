      <Array as="points">
       <mxPoint x="1325.6" y="410"/>
       <mxPoint x="1640" y="410"/>
      </Array>
     </mxGeometry>
    </mxCell>
    <mxCell id="n1" value="&lt;b&gt;Three promises.&lt;/b&gt; 1) Commit, then the fact: state and the outbox row commit together, the fact leaves after. 2) Every consumer is idempotent: a redelivery does nothing. 3) Food is authorized first and captured only after the POS accepts the ticket." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="470" width="720" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="n2" value="&lt;b&gt;Variants:&lt;/b&gt; aggregator orders skip steps 1 to 7 (the aggregator already took the money). Wallet orders use the same steps, Payment holds the wallet balance instead of calling the gateway. See page 6." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="600" width="1700" height="60" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

    <mxCell id="e.ord.bff" value="authorize_url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.8743;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8743;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="ord" target="bff">

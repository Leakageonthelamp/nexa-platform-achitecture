    <mxCell id="ft" value="&lt;b&gt;What goes wrong, and what happens&lt;/b&gt; (docs/architecture.md section 7)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="624" width="800" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="fa0" value="&lt;b&gt;Store hidden, not live or closed at step 2&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="654" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb0" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;PlaceOrder returns FAILED_PRECONDITION. Nothing is committed.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="654" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa1" value="&lt;b&gt;Live total differs from the total the shopper saw&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="700" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb1" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;FAILED_PRECONDITION (price_changed). Nothing is committed. The app re-reads the cart.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="700" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa2" value="&lt;b&gt;Brand and Store, Catalog, Delivery or Voucher down at step 2 or 3&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="746" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;UNAVAILABLE. Nothing is committed. The app retries with the same idempotency_key.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="746" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa3" value="&lt;b&gt;Quote expired, used, or for another brand&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="792" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb3" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;FAILED_PRECONDITION. Nothing is committed.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="792" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa4" value="&lt;b&gt;Payment down at step 4&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="838" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb4" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;The order stays unplaced. A retry with the same key returns the same order and calls CreateTransaction again.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="838" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa5" value="&lt;b&gt;Shopper abandons 3DS&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="884" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb5" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;No authorized arrives. The sweeper closes the order after the payment window and sends void.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="884" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa6" value="&lt;b&gt;payment.events {failed}&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="930" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb6" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Order commits cancelled (payment_failed) and publishes order.events {cancelled}.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="930" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa7" value="&lt;b&gt;POS never answers&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="976" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb7" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;The sweeper rejects the ticket after the POS window and sends a void.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="976" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa8" value="&lt;b&gt;POS update is a duplicate, late or out of order&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="1022" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb8" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Dropped or recorded as stale. A lower rank never moves a ticket backward.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="1022" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa9" value="&lt;b&gt;POS total differs from the priced order&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="1068" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb9" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Price lines never change. Reconciliation row and CSC queue entry. The rule is open (O-32).&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="1068" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa10" value="&lt;b&gt;The store's POS cannot take this fulfillment&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="1114" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb10" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;FAILED_PRECONDITION (fulfillment_not_supported). Nothing is committed.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="1114" width="1120" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fa11" value="&lt;b&gt;Crash anywhere&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="1160" width="520" height="38" as="geometry"/>
    </mxCell>
    <mxCell id="fb11" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;The step resumes from the last committed status. A redelivered record is a no-op.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="556" y="1160" width="1120" height="38" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
</mxfile>

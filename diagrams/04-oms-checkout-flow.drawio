    <mxCell id="f1" value="&lt;b&gt;Submit fails or the POS never answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;The POS worker retries from the outbox. After the POS window the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;sweeper rejects the ticket and sends a void (P-10, O-04).&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="560" width="400" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="f2" value="&lt;b&gt;Duplicate, late or lower-rank update&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;Dropped or recorded as stale. A lower rank never moves&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;a ticket backward. A zero total after a good one is an anomaly.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="450" y="560" width="400" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="f3" value="&lt;b&gt;POS total differs from the priced order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;Price lines never change. A reconciliation row and a CSC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;queue entry are written. The fix rule is open (O-32).&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="876" y="560" width="400" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="n1" value="The shopper is not waiting here. The payload log is not a step: adapters and Order capture payloads in memory and a writer sends them to MongoDB later. A log failure never touches the order. Details: 05-oms-pos-adapters and 06-order-payload-log-mongo." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="700" width="1640" height="60" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

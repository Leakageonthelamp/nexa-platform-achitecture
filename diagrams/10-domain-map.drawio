     <mxGeometry x="275" y="50" width="235" height="180" as="geometry"/>
    </mxCell>
    <mxCell id="n1" value="Every domain app runs in modes from one image: &lt;b&gt;api&lt;/b&gt; (gRPC), &lt;b&gt;consumer&lt;/b&gt; (Kafka), &lt;b&gt;worker&lt;/b&gt; (outbox relay and background jobs) and &lt;b&gt;cron&lt;/b&gt;. Each mode is its own Kubernetes workload. Statement is a mode of the Payment app, and Brand and Store are one app. A second domain that needs data calls the owner over gRPC, live." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="660" width="1650" height="100" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

    <mxCell id="e.idn.not" value="SendOtp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="idn" target="not">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="e.not.idn" value="reads contacts live" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.7000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="not" target="idn">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="n1" value="Rules: no chain of sync calls longer than two hops on the shopper's path; every call carries x-brand-id, x-principal-id, x-roles, traceparent and a deadline that is passed on, never reset." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="800" width="480" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="n2" value="Wallet is gRPC, not a topic: Payment is waiting for the hold, so a command could not return it (D-09). Notification reads contacts from Identity at send time, so no phone number or email rides on the bus." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1300" y="780" width="380" height="150" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

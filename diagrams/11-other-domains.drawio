    <mxCell id="nt0" value="&lt;b&gt;Rule:&lt;/b&gt; food is authorized first and captured only after the POS accepts the ticket; a refund is gRPC because an admin waits." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">

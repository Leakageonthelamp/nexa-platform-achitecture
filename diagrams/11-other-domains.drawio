    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="hl" value="&lt;b&gt;Calls it, someone waits (gRPC)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#C2410C;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="84" width="320" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="hm" value="&lt;b&gt;Goes out&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1186" y="84" width="490" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="eng" value="&lt;b&gt;Payment &amp;amp; Billing: one Go app (modes api, consumer, worker, cron; Statement is a mode)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#854D0E;strokeColor=#EAB308;fillColor=#FEF9C3;strokeWidth=1.5;" vertex="1" parent="1">
     <mxGeometry x="470" y="100" width="640" height="640" as="geometry"/>
    </mxCell>
    <mxCell id="e0" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;CreateTransaction: Omise charge and authorize_url,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;or Wallet Hold with no page for a wallet order&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="40" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="&lt;b&gt;Capture, void, payout, webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;one command, same key, so they stay in order; match the ref, then the outbox&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="158.8" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="&lt;b&gt;Gateway worker and refund&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;calls Omise or TrueMoney after the commit; 2C2P is a port, not shipped&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="277.6" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="&lt;b&gt;Statement mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;tax invoice and receipt after capture; FAAS invoice from delivered&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="396.4" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Aurora: one transactions table (brand_id is a column), attempts, brand config with gateway keys,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;outbox, processed_event, audit. S3: invoices and receipts&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">

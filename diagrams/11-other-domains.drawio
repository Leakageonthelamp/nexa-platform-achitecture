    <mxCell id="hm" value="&lt;b&gt;Goes out&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1186" y="84" width="490" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="eng" value="&lt;b&gt;Admin &amp;amp; Partner: one Go domain, two engines; zero topics&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#854D0E;strokeColor=#EAB308;fillColor=#FEF9C3;strokeWidth=1.5;" vertex="1" parent="1">
     <mxGeometry x="470" y="100" width="640" height="640" as="geometry"/>
    </mxCell>
    <mxCell id="e0" value="&lt;b&gt;Admin engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;principal (IdP subject, email, name), grant, session; Admin JWT iss=admin, ES512, short TTL, roles fixed until the next token&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="40" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="&lt;b&gt;Partner engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;OAuth client with a public key only; Partner JWT 5 minutes, no refresh token; register, rotate, suspend&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="158.8" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="&lt;b&gt;Azure adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;the only call to Azure AD (D-01); the port stays, only Azure is shipped&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="277.6" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;audit_log in the same transaction as the write; the data lake reads Postgres, not the bus&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="396.4" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Aurora schemas admin and partner. Valkey: refresh family, one-time code, PKCE verifier. Vault: admin-es512, partner-es512&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="515.2" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="c0" value="&lt;b&gt;admin-bff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;auth code with PKCE, grant, revoke, session&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">

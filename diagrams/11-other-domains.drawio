 <diagram id="p4" name="4 Loyalty and MemberCard">
  <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1032" math="0" shadow="0">
   <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="hl" value="&lt;b&gt;Calls it, someone waits (gRPC)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#C2410C;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="84" width="320" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="hm" value="&lt;b&gt;Goes out&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1186" y="84" width="490" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="eng" value="&lt;b&gt;Loyalty &amp;amp; MemberCard: one Go app, one profile per (brand_id, customer_id)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#854D0E;strokeColor=#EAB308;fillColor=#FEF9C3;strokeWidth=1.5;" vertex="1" parent="1">
     <mxGeometry x="470" y="100" width="640" height="640" as="geometry"/>
    </mxCell>
    <mxCell id="e0" value="&lt;b&gt;Earn consumer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;enrols the member on the first completed order; a guest earns nothing&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="40" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="&lt;b&gt;Redeem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;debits oldest points first, then Voucher.IssueReward and waits; same redemption id on a retry&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="158.8" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="&lt;b&gt;Member, card and points ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;card and QR, level on the member row; append-only postings, balance = sum of postings, expiry buckets&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="277.6" width="600" height="104.8" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="&lt;b&gt;Nightly crons&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;expire points 01:00, recompute tier 02:00 (Asia/Bangkok), Forbid&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=11;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="eng">
     <mxGeometry x="20" y="396.4" width="600" height="104.8" as="geometry"/>

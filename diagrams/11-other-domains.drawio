    <mxCell id="nt0" value="&lt;b&gt;Rules:&lt;/b&gt; a token on the bus would be a secret to redact, so a grant, revoke, rotate or login is gRPC and the audit row is the record. A revoked session lives until its access token expires (5 minutes)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="760" width="1650" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="nt1" value="&lt;b&gt;Not this domain:&lt;/b&gt; the customer, the Minor ID and the customer key (Identity), headers downstream (Kong injects them)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="788" width="1650" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="title" value="NEXA &amp;#8211; Admin &amp;amp; Partner: login is synchronous, and the bus is not involved" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1">
     <mxGeometry x="24" y="12" width="1652" height="32" as="geometry"/>

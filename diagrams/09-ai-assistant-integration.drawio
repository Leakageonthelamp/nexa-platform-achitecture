    <mxCell id="no" value="&lt;b&gt;What the assistant cannot do (proposed token scope)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;It cannot place an order or pay: the shopper does that with the normal PlaceOrder.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;It cannot change a menu, a price, stock, a store or a deal.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B91C1C&quot;&gt;It carries a token that names the customer and the allowed operations, such as read menu, read order history, UpdateCart.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#DC2626;fillColor=#FEF2F2;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
     <mxGeometry x="360" y="600" width="640" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="n1" value="Manual and AI orders share &lt;b&gt;one cart and one price&lt;/b&gt; (P-34), so whatever the assistant adds, the shopper sees and edits like any other line." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="600" width="300" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="n2" value="No new Kafka topic: every AI read is a gRPC read and the write is UpdateCart (P-35). The shopper is waiting, so none of it is a topic." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1080" y="650" width="596" height="100" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>

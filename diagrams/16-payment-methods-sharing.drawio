    <mxCell id="title" value="NEXA &amp;#8211; Saved payment methods: not shared by default, shared only if the customer opts in and the gateway allows it" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1">

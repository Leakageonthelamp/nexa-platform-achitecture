    </mxCell>
    <mxCell id="h1" value="&lt;b&gt;Commands&lt;/b&gt; (purple): one per domain, named domain.requested. A command asks the owner to do something; the owner consumes it." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#6D28D9;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">

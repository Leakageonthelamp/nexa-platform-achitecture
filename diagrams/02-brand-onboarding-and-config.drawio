    <mxCell id="readiness" value="&lt;b&gt;Readiness check (proposed)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;admin-bff asks each owning domain one read-only question, 'is this brand ready?', and shows all answers on one page.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Examples: every store has a valid pos_connection; a menu version exists; a gateway key exists.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;A set of gRPC reads. No topic and no new service. The name CheckBrandReadiness is a placeholder.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=12;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
     <mxGeometry x="866" y="646" width="810" height="120" as="geometry"/>
    </mxCell>

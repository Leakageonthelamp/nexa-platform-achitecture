    <mxCell id="n1" value="The log is not on the shopper path and no other domain reads it. If Mongo is down, orders still work. No Kafka topic carries a payload (principle 8, 1 MB limit)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="770" width="600" height="120" as="geometry"/>

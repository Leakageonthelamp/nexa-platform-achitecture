    <mxCell id="idx" value="&lt;b&gt;Indexes (a starting set)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;{ order_id, seq }: read an order's trace   |   { correlation_id, seq }: read the adapter side   |   { external_ref }: find by aggregator or POS reference&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;{ brand_id, captured_at desc }: support and clean-up by brand   |   { ttl_at } with expireAfterSeconds 0: each document expires at its own date&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#64748B;fillColor=#F8FAFC;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="40" y="700" width="1600" height="90" as="geometry"/>

    <mxCell id="lg.t12" value="Log write, best effort" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="legend">
     <mxGeometry x="382" y="76" width="144" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="questions" value="&lt;b&gt;Open questions and assumptions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;&amp;#8226; O-28: all BSL values are the owner's UAT observations (October 2026), not vendor documentation&lt;br&gt;&amp;#8226; O-32: the rule for a total that disagrees is open&lt;br&gt;&amp;#8226; Nothing is hardcoded as 'BSL logic': it is vendor profile data and generic rules&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fontSize=11;fontColor=#0F172A;strokeColor=#CBD5E1;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;dashed=1;dashPattern=4 3;fillColor=#FFFBEB;strokeColor=#D97706;" vertex="1" parent="1">
     <mxGeometry x="928" y="980" width="748" height="104" as="geometry"/>
    </mxCell>
    <mxCell id="h1" value="&lt;b&gt;Observed with BSL (UAT, October 2026)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="84" width="760" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="h2" value="&lt;b&gt;How the design absorbs it&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="924" y="84" width="752" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="o0" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;1&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;Status webhooks arrive within about a second, and some are duplicated&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="118" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m0" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;R1: dedupe on a deterministic event_id (UUIDv5 of vendor, vendor_ref, status, version)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="118" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o0.m0" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o0" target="m0">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o1" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;2&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;Updates can arrive out of order&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="206" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m1" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;R2, R3, R4: rank, terminal states, skipped ranks are fine. status_updates_ordered = false&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="206" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o1.m1" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o1" target="m1">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o2" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;3&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;A late update can overwrite the total, and an empty check can reset the net total to 0 (the till bill stayed correct)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="294" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;R5, R6, R7: reported totals kept apart from price lines, applied by version, regression guard; reconciliation&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="294" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o2.m2" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o2" target="m2">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o3" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;4&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;Some promotions are silently dropped, so the POS total can differ from our priced order&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="382" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m3" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;promo_mode (passthrough, flatten, discount_line) and the reconciliation result promo_dropped&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="382" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o3.m3" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o3" target="m3">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o4" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;5&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;The vendor needs per-store routing values (an enterprise unit and an organization); a wrong default unit never reached the POS&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="470" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m4" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;pos_connection.routing, validated against the vendor schema; a missing value never falls back to a default unit&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="470" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o4.m4" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o4" target="m4">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o5" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;6&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;Pickup works. Delivery is not available yet&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="558" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m5" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;supports_pickup = true, supports_delivery = false in the BSL profile; flip the flag when the vendor ships delivery&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="558" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o5.m5" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o5" target="m5">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o6" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;7&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;Status names run OrderPlaced, ReceivedForFulfillment, InFulfillment, ReadyForPickup&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="646" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m6" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;The BSL mapper table to canonical submitted, received, in_progress, ready&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="646" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o6.m6" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o6" target="m6">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="o7" value="&lt;b style=&quot;background-color:#0F172A;color:#FFFFFF;border-radius:9px;padding:0px 6px;&quot;&gt;8&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1D4ED8&quot;&gt;A short reference on the till slip matches the vendor's reference&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#2563EB;fillColor=#EFF6FF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="24" y="734" width="760" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="m7" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#854D0E&quot;&gt;Stored as vendor_ref and shown to CSC&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=10;fontSize=12;fontColor=#0F172A;strokeColor=#EAB308;fillColor=#FFFFFF;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="924" y="734" width="752" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e.o7.m7" value="absorbed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#C2410C;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;jettySize=auto;" edge="1" parent="1" source="o7" target="m7">
     <mxGeometry relative="1" as="geometry" x="0.0000">
     </mxGeometry>
    </mxCell>
    <mxCell id="n1" value="A new vendor gets its own row of observations like this one. The list is the checklist for a new adapter: list its sensitive paths for masking, its status table, its routing values, its capability flags." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="830" width="1650" height="60" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
 <diagram id="p4" name="4 Per-brand selection and capability flags">

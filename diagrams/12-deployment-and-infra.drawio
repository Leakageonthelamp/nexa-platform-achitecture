    <mxCell id="n1" value="Core infrastructure is fixed by DevOps and DevOps builds it. A new tool needs a decision row with a reason, a cost and a named DevOps owner; it may be non-AWS when clearly better." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">

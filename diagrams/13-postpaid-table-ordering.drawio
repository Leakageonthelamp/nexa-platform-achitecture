    <mxCell id="n1" value="&lt;b&gt;Split bill.&lt;/b&gt; First draft: one person pays the whole bill. Next: equal split, one payment per share, the tab closes when all are paid. Later: by item (O-40)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="1304" y="125" width="360" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="n2" value="Unpaid tabs: staff flag a walk-out (MarkTabUnpaid). With a card hold (P-48) it may be captured only under the terms the diner saw. No timer closes a tab." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#475569;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">
     <mxGeometry x="24" y="885" width="1650" height="40" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>

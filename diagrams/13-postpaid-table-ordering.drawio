    <mxCell id="t2" value="&lt;b&gt;Other way to finish: pay at the counter&lt;/b&gt; (the universal fallback)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1D4ED8;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1">

;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;x-principal-id, brand_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;idempotency_key · deadline 2 s&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;principal is a customer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;x-brand-id present&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Load + check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer must be ACTIVE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer_brand by pair&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apply rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;insert customer_brand ACTIVE&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Commit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;pair + audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;no fact published&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;customer_id, brand_id, joined_at&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1616" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor
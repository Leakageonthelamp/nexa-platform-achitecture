dArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b11" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b style=&quot;font-size:12px&quot;&gt;Pair already ACTIVE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;return OK · nothing new to write&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="338" width="200" height="80" as="geometry" /></mxCell><mxCell id="e23" value="no change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.15;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b12" target="b22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane28" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t29" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;JoinBrandRequest { brand_id, idempotency_key }&lt;/li&gt;&lt;li&gt;JoinBrandResponse { customer_id, brand_id, joined_at }&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane30" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t31" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;customer_brand(customer_id, brand_id UNIQUE, status ACTIVE)&lt;/li&gt;&lt;li&gt;audit&lt;/li&gt;&lt;li&gt;No outbox row&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane32" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t33" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;idempotency_key + UNIQUE(pair)&lt;/li&gt;&lt;li&gt;Retry on UNAVAILABLE ≤ 2&lt;/li&gt;&lt;li&gt;Deadline 2 s&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane34" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t35" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Loyalty is not told. It consumes order.events only, and its HLD is not drawn&lt;/li&gt;&lt;li&gt;A membership therefore opens on the first order, not on the join&lt;/li&gt;&lt;li&gt;Whether JoinBrand is its own call, or VerifyOtp in the new brand app covers it, is still O-06&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t36" value="Identity &amp; Customer LLD v1 (draft) · 3 · JoinBrand · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-4" name="4 · UpdateProfile"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-4-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="4 · UpdateProfile — customer self-service or CSC support edit" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="customer-bff (own profile) or admin-bff (grant customer.edit). A phone change needs a fresh OTP proof and revokes sessions." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill7" value="&lt;b&gt;Failure exit&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="916" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;customer-bff / admin-bff → UpdateProfile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;fields, expected version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;idempotency_key · deadline 3 s&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Validate + authorize&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;field rules · self or grant&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;phone change needs otp_proof&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Load + check version&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer must be ACTIVE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;version = expected&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apply rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;diff fields · bump version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;phone → update credential&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Commit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer + credential + audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;no fact published&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Return · revoke if phone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;profile, version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;delete refresh family in Valkey&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1616" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b style=&quot;font-size:12px&quot;&gt;INVALID_ARGUMENT / PERMISSION_DENIED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;bad field → 400&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;no grant → 403&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e21" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b10" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b style=&quot;font-size:12px&quot;&gt;ABORTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;stale version → 409, reload&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e23" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b11" target="b22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b style=&quot;font-size:12px&quot;&gt;No field changed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;return OK · nothing new to write&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="338" width="200" height="80" as="geometry" /></mxCell><mxCell id="e25" value="no change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.15;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b12" target="b24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane30" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t31" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;UpdateProfileRequest { customer_id, name?, email?, phone?, birthday?, otp_proof?, expected_version, idempotency_key }&lt;/li&gt;&lt;li&gt;UpdateProfileResponse { profile, version }&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane32" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t33" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;customer (version + 1)&lt;/li&gt;&lt;li&gt;credential.phone_hash when the phone changes&lt;/li&gt;&lt;li&gt;audit (actor: the customer or the admin principal)&lt;/li&gt;&lt;li&gt;No outbox. Field values never leave this schema (D-05)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane34" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t35" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;expected_version (ABORTED on stale)&lt;/li&gt;&lt;li&gt;idempotency_key for client retries&lt;/li&gt;&lt;li&gt;Retry on UNAVAILABLE ≤ 2 · deadline 3 s&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane36" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t37" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;No changed fact. The only candidate consumer was the data platform, which is not built (principle 1, O-25)&lt;/li&gt;&lt;li&gt;Address and consent writes follow this same commit. Their pages are still to add&lt;/li&gt;&lt;li&gt;A phone change deletes the refresh family. The access token can last until it expires (§8)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t38" value="Identity &amp; Customer LLD v1 (draft) · 4 · UpdateProfile · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-5" name="5 · DeleteCustomer"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-5-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="5 · DeleteCustomer — close the account and anonymize (PDPA)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="Customer (with OTP proof) or CSC (grant pdpa.delete). v0 used DELETING → Auth revoke → anonymize as a saga; now it is one commit, then token revoke." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill7" value="&lt;b&gt;Failure exit&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="916" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;customer-bff / admin-bff → DeleteCustomer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;customer_id, otp_proof or grant&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;idempotency_key · deadline 3 s&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Verify intent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;OTP proof (self) or&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;admin grant pdpa.delete&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Load&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer ACTIVE?&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apply rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;scrub name, phone, email, addresses&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;status DELETED · keep customer_id&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Commit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer + credential + address + consent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;audit · no fact published&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Revoke · return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;delete refresh family (Valkey)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;access token expires ≤ 5 min&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1616" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b style=&quot;font-size:12px&quot;&gt;UNAUTHENTICATED / PERMISSION_DENIED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;bad proof → 401&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;no grant → 403&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e21" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b10" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b style=&quot;font-size:12px&quot;&gt;UNAVAILABLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;DB down → nothing changed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;retry with same key&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e23" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b13" target="b22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b style=&quot;font-size:12px&quot;&gt;Already DELETED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;return OK · nothing new to write&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="338" width="200" height="80" as="geometry" /></mxCell><mxCell id="e25" value="no change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.15;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b11" target="b24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane30" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t31" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;DeleteCustomerRequest { customer_id, otp_proof? , reason, idempotency_key }&lt;/li&gt;&lt;li&gt;DeleteCustomerResponse { customer_id, deleted_at }&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane32" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t33" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;customer: personal data null, status DELETED, version + 1&lt;/li&gt;&lt;li&gt;credential deleted · address and consent rows deleted&lt;/li&gt;&lt;li&gt;audit keeps customer_id and the actor only&lt;/li&gt;&lt;li&gt;No outbox row&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane34" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t35" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;idempotency_key · already DELETED is a no-op&lt;/li&gt;&lt;li&gt;If Valkey revoke fails: retry in-app; worst case token lives ≤ 5 min&lt;/li&gt;&lt;li&gt;Deadline 3 s&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane36" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t37" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Nothing is told. Loyalty and the data platform do not consume an Identity fact, so they cannot undo the delete&lt;/li&gt;&lt;li&gt;If the Valkey revoke fails, the access token can last until it expires (§8)&lt;/li&gt;&lt;li&gt;O-07: how long the audit row and order history are kept under PDPA is still open&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t38" value="Identity &amp; Customer LLD v1 (draft) · 5 · DeleteCustomer · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-6" name="6 · BatchGetContacts · GetAddress"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-6-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="6 · BatchGetContacts · GetAddress — other domains read personal data live" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="Notification reads contacts at send time; Delivery reads the drop-off address when the rider job is created (D-05, P-24). Read-only: no commit, no fact." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill7" value="&lt;b&gt;Failure exit&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="916" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Notification → BatchGetContacts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;customer_ids ≤ 100, purpose, brand_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;Delivery → GetAddress (same path)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;≤ 100 ids · purpose known&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;x-brand-id present&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Load&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer, contact, consent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;(or one address row)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apply consent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;drop DELETED · drop no-consent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;other brand only with share consent&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;contacts / address&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;missing ids omitted&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e14" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b18" value="&lt;b style=&quot;font-size:12px&quot;&gt;INVALID_ARGUMENT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;too many ids / bad purpose → 400&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e19" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b10" target="b18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b style=&quot;font-size:12px&quot;&gt;NOT_FOUND&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;GetAddress: no such address&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e21" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b11" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane22" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t23" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;BatchGetContactsRequest { customer_ids[], purpose }&lt;/li&gt;&lt;li&gt;→ { contacts[ { customer_id, phone?, email?, line_user_id?, locale } ] }&lt;/li&gt;&lt;li&gt;GetAddressRequest { customer_id, address_id } → { lat, lng, text, note }&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane24" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t25" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;None (read only)&lt;/li&gt;&lt;li&gt;Optional read cache in Valkey after commit — not drawn, add only if needed (D-04)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane26" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t27" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Reads: retry on UNAVAILABLE ≤ 2&lt;/li&gt;&lt;li&gt;Deadline from caller (Notification send, Delivery dispatch)&lt;/li&gt;&lt;li&gt;If Identity is down the send or dispatch waits (D-05 cost)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane28" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t29" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;No contact copy outside Identity (§10)&lt;/li&gt;&lt;li&gt;Cross-brand read checks P-33 consent&lt;/li&gt;&lt;li&gt;Contact data never in a log or record (§8)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t30" value="Identity &amp; Customer LLD v1 (draft) · 6 · BatchGetContacts · GetAddress · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="drawio" version="24.0.0"><diagram id="lld-1" name="1 · StartSignIn"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-1-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="1 · StartSignIn — send a one-time code to a phone" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="customer-bff calls Identity while the customer waits. No Postgres write and no fact: the challenge lives in Valkey only." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill7" value="&lt;b&gt;Failure exit&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="916" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;customer-bff → StartSignIn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;gRPC · deadline 3 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;phone, brand_id (x-brand-id)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;phone is E.164&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;x-brand-id present&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Rate limit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;Valkey bucket per phone and per IP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;cap is a draft, not decided&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Generate code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;6 digits · store hash only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;Valkey otp:{challenge_id} TTL 5 min&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;OTP sender port → Notification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;gRPC SendOtp · deadline 2 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;SMS only · the code is never stored there&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;challenge_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;resend_after_s = 60&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1616" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b style=&quot;font-size:12px&quot;&gt;INVALID_ARGUMENT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;bad phone or no brand → 400&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e21" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b10" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b style=&quot;font-size:12px&quot;&gt;RESOURCE_EXHAUSTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;too many codes → 429&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e23" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b11" target="b22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b style=&quot;font-size:12px&quot;&gt;UNAVAILABLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;Notification down → 503&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;app retries; challenge stays&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e25" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b13" target="b24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane26" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t27" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;StartSignInRequest { phone, brand_id }&lt;/li&gt;&lt;li&gt;StartSignInResponse { challenge_id, resend_after_s }&lt;/li&gt;&lt;li&gt;Metadata: x-brand-id, traceparent (no principal yet)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane28" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t29" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Valkey otp:{challenge_id} = { phone_hash, code_hash, attempts:0 } TTL 300 s&lt;/li&gt;&lt;li&gt;Valkey rl:otp:{phone_hash} bucket&lt;/li&gt;&lt;li&gt;No Postgres row, no outbox, no fact&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane30" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t31" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;No idempotency_key: a repeat makes a new challenge, bounded by the rate limit&lt;/li&gt;&lt;li&gt;Deadline 3 s from the BFF, 2 s left for Notification&lt;/li&gt;&lt;li&gt;Retry: the app only, on 503&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane32" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t33" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;The code and the phone are never logged (§8)&lt;/li&gt;&lt;li&gt;Identity generates and checks the code. Notification only delivers it, via SendOtp&lt;/li&gt;&lt;li&gt;OTP is not on notification.requested, because the shopper is waiting&lt;/li&gt;&lt;li&gt;6 digits, a 5-minute TTL, and the rate-limit cap are draft numbers, not a decision&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t34" value="Identity &amp; Customer LLD v1 (draft) · 1 · StartSignIn · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-2" name="2 · VerifyOtp (sign in · register)"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-2-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="2 · VerifyOtp — sign in, or register a new Minor ID in one transaction" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="Replaces v0 registration (Customer API → Auth saga with PROVISIONING and compensation). Customer and credential are now in one schema, so it is one commit." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill7" value="&lt;b&gt;Failure exit&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#475569;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="916" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b style=&quot;font-size:12px&quot;&gt;customer-bff → VerifyOtp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;challenge_id, code, brand_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;idempotency_key · deadline 3 s&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="16" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Check code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;Valkey compare hash · attempts ≤ 5&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;delete challenge on success&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Resolve human&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;credential by phone_hash&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;found → existing · none → new&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="656" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apply rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;new: customer ACTIVE + credential&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;pair missing: customer_brand ACTIVE&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Commit (one tx)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer + credential + brand&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;audit + idempotency · no outbox&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Issue tokens · return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;access JWT 5 min (Vault key)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;refresh family in Valkey&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1616" y="168" width="270" height="110" as="geometry" /></mxCell><mxCell id="e15" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#EA580C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b style=&quot;font-size:12px&quot;&gt;UNAUTHENTICATED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;wrong or expired code → 401&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;5th miss burns the challenge&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e21" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b10" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b style=&quot;font-size:12px&quot;&gt;ABORTED / UNAVAILABLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;same phone raced → reload&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B91C1C&quot;&gt;DB down → nothing written&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1296" y="338" width="200" height="96" as="geometry" /></mxCell><mxCell id="e23" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.3;exitY=1;entryX=0.39;entryY=0;" edge="1" parent="1" source="b13" target="b22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b style=&quot;font-size:12px&quot;&gt;Pair already ACTIVE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;sign in only · nothing new to write&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="338" width="200" height="80" as="geometry" /></mxCell><mxCell id="e25" value="no change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.15;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b12" target="b24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lane30" value="Contract  ·  fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t31" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;VerifyOtpRequest { challenge_id, code, brand_id, idempotency_key }&lt;/li&gt;&lt;li&gt;VerifyOtpResponse { customer_id, access_token, refresh_token, is_new_customer, is_new_brand }&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="28" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane32" value="Writes  ·  tables" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="506" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t33" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;customer(id, status, version)&lt;/li&gt;&lt;li&gt;credential(customer_id, phone_hash UNIQUE)&lt;/li&gt;&lt;li&gt;customer_brand(customer_id, brand_id UNIQUE, status)&lt;/li&gt;&lt;li&gt;audit · idempotency(key UNIQUE, result)&lt;/li&gt;&lt;li&gt;No outbox row. Nothing is published&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane34" value="Dedupe  ·  deadline  ·  retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="996" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t35" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;idempotency_key returns the first result&lt;/li&gt;&lt;li&gt;UNIQUE(phone_hash) and UNIQUE(customer_id, brand_id) stop duplicates under a race&lt;/li&gt;&lt;li&gt;Retry on UNAVAILABLE ≤ 2 with the same key&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1008" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="lane36" value="Notes  ·  decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="1486" y="600" width="474" height="380" as="geometry" /></mxCell><mxCell id="t37" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;No fact, so no outbox (principle 1). The 2xx does not wait on a broker&lt;/li&gt;&lt;li&gt;v0 PROVISIONING / NEVER_ACTIVE and the Auth saga are cut: one schema, one commit&lt;/li&gt;&lt;li&gt;Cross-brand sharing is a separate consent purpose (P-33)&lt;/li&gt;&lt;li&gt;D-11 · §8 · O-06 is still open for how Kong sets X-Brand-Id&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1498" y="630" width="450" height="345" as="geometry" /></mxCell><mxCell id="t38" value="Identity &amp; Customer LLD v1 (draft) · 2 · VerifyOtp (sign in · register) · 2026-10-14" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fontColor=#94A3B8;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="986" width="1948" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-3" name="3 · JoinBrand"><mxGraphModel dx="1980" dy="1010" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="lld-3-flow" value="Flow  ·  gRPC  ·  the caller waits" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="420" as="geometry" /></mxCell><mxCell id="t1" value="3 · JoinBrand — an existing Minor ID joins another brand without signing up again" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="The customer is already signed in (customer JWT). Reuses the same customer_id and credential; only the brand pair is new." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#64748B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLe
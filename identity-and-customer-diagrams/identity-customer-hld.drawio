<mxfile host="drawio" version="24.0.0"><diagram id="identity-customer-hld" name="Identity &amp; Profile HLD"><mxGraphModel dx="1980" dy="1540" grid="1" gridSize="8" guides="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="root0" /><mxCell id="1" parent="root0" /><mxCell id="t1" value="Identity &amp; Profile — one Minor ID for every brand: login, tokens, profile, addresses, contacts, PDPA consent" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="12" width="1948" height="30" as="geometry" /></mxCell><mxCell id="t2" value="One Go app, one Aurora schema. Every caller is waiting, so every door is gRPC. Kong reads the customer signing key over HTTP. Notification and Delivery read contacts and addresses live; nobody keeps a copy." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="46" width="1948" height="34" as="geometry" /></mxCell><mxCell id="pill3" value="&lt;b&gt;gRPC · caller waits&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#EA580C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="16" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill4" value="&lt;b&gt;JWKS / HTTP · edge&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#2563EB;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="196" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill5" value="&lt;b&gt;Kafka command&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#7C3AED;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="376" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill6" value="&lt;b&gt;Kafka fact&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#059669;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="556" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="pill8" value="&lt;b&gt;Not shipped / proposed&lt;/b&gt;" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#94A3B8;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="736" y="86" width="170" height="28" as="geometry" /></mxCell><mxCell id="lane1" value="&lt;b style=&quot;font-size:13px&quot;&gt;1 · Callers&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8" vertex="1" parent="1"><mxGeometry x="16" y="130" width="360" height="520" as="geometry" /></mxCell><mxCell id="lane2" value="&lt;b style=&quot;font-size:13px&quot;&gt;2 · Kafka in&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F5F3FF;strokeColor=#7C3AED" vertex="1" parent="1"><mxGeometry x="16" y="670" width="360" height="404" as="geometry" /></mxCell><mxCell id="lane3" value="&lt;b style=&quot;font-size:13px&quot;&gt;3 · Engine · Go · identity app (mode: api)&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FEF9C3;strokeColor=#EAB308" vertex="1" parent="1"><mxGeometry x="392" y="130" width="780" height="944" as="geometry" /></mxCell><mxCell id="lane4" value="&lt;b style=&quot;font-size:13px&quot;&gt;4 · Facts out&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#ECFDF5;strokeColor=#059669" vertex="1" parent="1"><mxGeometry x="1188" y="130" width="320" height="552" as="geometry" /></mxCell><mxCell id="lane5" value="&lt;b style=&quot;font-size:13px&quot;&gt;5 · Consumers&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8" vertex="1" parent="1"><mxGeometry x="1524" y="130" width="440" height="552" as="geometry" /></mxCell><mxCell id="c-bff" value="&lt;b style=&quot;font-size:12px&quot;&gt;customer-bff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;Customer app · customer JWT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;sign in, profile, join brand, close account&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="168" width="328" height="76" as="geometry" /></mxCell><mxCell id="a-bff" value="&lt;b style=&quot;font-size:12px&quot;&gt;admin-bff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;Admin console · CSC · X-Roles grant&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;support edit · PDPA delete&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="260" width="328" height="76" as="geometry" /></mxCell><mxCell id="kong" value="&lt;b style=&quot;font-size:12px&quot;&gt;Kong (PEP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1D4ED8&quot;&gt;picks JWKS by iss · customer family&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1D4ED8&quot;&gt;X-Principal-Id · X-Roles · X-Brand-Id&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="352" width="328" height="76" as="geometry" /></mxCell><mxCell id="notif" value="&lt;b style=&quot;font-size:12px&quot;&gt;Notification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;reads contacts and consent at send time&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;delivers the OTP when Identity calls SendOtp&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="444" width="328" height="76" as="geometry" /></mxCell><mxCell id="deliv" value="&lt;b style=&quot;font-size:12px&quot;&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;reads the drop-off address&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;when the rider job is created&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="536" width="328" height="76" as="geometry" /></mxCell><mxCell id="c-note" value="guest-bff and partner-bff never call here. A partner token is rejected on customer routes (§8)." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="32" y="618" width="328" height="28" as="geometry" /></mxCell><mxCell id="kong-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="kong"><mxGeometry x="16" y="23" width="30" height="30" as="geometry" /></mxCell><mxCell id="d-cust" value="&lt;b style=&quot;font-size:12px&quot;&gt;Customer API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;StartSignIn · VerifyOtp · RefreshToken&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;JoinBrand · profile · addresses · consent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;StartSignIn calls Notification.SendOtp&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="416" y="168" width="320" height="76" as="geometry" /></mxCell><mxCell id="d-admin" value="&lt;b style=&quot;font-size:12px&quot;&gt;Admin API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;UpdateProfile · DeleteCustomer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;checks the grant in x-roles&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="416" y="260" width="320" height="76" as="geometry" /></mxCell><mxCell id="d-jwks" value="&lt;b style=&quot;font-size:12px&quot;&gt;JWKS endpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1D4ED8&quot;&gt;public half of the customer signing key&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="416" y="352" width="320" height="76" as="geometry" /></mxCell><mxCell id="d-contacts" value="&lt;b style=&quot;font-size:12px&quot;&gt;Contacts API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;BatchGetContacts(customer_ids, purpose)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;drops ids with no consent for that purpose&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="416" y="444" width="320" height="76" as="geometry" /></mxCell><mxCell id="d-addr" value="&lt;b style=&quot;font-size:12px&quot;&gt;Address API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C2410C&quot;&gt;GetAddress(customer_id, address_id)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="416" y="536" width="320" height="76" as="geometry" /></mxCell><mxCell id="state" value="&lt;b style=&quot;font-size:12px&quot;&gt;Identity state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;customer · credential · customer_brand&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;address · consent · audit · idempotency&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;one commit · version bumps · brand_id on every row&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="168" width="372" height="444" as="geometry" /></mxCell><mxCell id="tokens" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tokens&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;access JWT 5 min, key in Vault&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;refresh family in Valkey, revoked on delete or phone change&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;no denylist (§8)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="636" width="372" height="84" as="geometry" /></mxCell><mxCell id="social" value="&lt;b style=&quot;font-size:12px&quot;&gt;Apple · Google · LINE sign-in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;linked to the same customer, when built&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#854D0E&quot;&gt;Planned · 2029&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=138;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="784" y="748" width="372" height="84" as="geometry" /></mxCell><mxCell id="eng-note" value="No worker and no cron. Nothing is published, so there is no outbox relay and no purge. The OTP call is gRPC inside StartSignIn, because the shopper is waiting." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" vertex="1" parent="1"><mxGeometry x="416" y="760" width="340" height="80" as="geometry" /></mxCell><mxCell id="fact-note" value="No facts out. A profile change has no consumer in v1. Loyalty reads order.events, and the data platform is not built (O-25). customer.lifecycle.fact (BrandJoined, Changed, Deleted) is cut (principle 1): a join is not announced." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="1204" y="176" width="288" height="140" as="geometry" /></mxCell><mxCell id="cons-note" value="No consumers. Identity consumes nothing, and no domain consumes an Identity fact. There is nothing to Ack on this page." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1540" y="176" width="408" height="90" as="geometry" /></mxCell><mxCell id="kin-note" value="No Kafka in. Every write has a customer or an agent waiting, so it is gRPC through a BFF. No partner, POS, or gateway sends Identity a command." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#6D28D9;" vertex="1" parent="1"><mxGeometry x="32" y="708" width="328" height="90" as="geometry" /></mxCell><mxCell id="e1" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-bff" target="d-cust"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-bff" target="d-admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kong" target="d-jwks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="notif" target="d-contacts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="deliv" target="d-addr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="register · join · update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;entryX=0;entryY=0.086;" edge="1" parent="1" source="d-cust" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="update · anonymize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;entryX=0;entryY=0.293;" edge="1" parent="1" source="d-admin" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="read key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="d-jwks" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="read contacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;entryX=0;entryY=0.707;" edge="1" parent="1" source="d-contacts" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="read address" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;entryX=0;entryY=0.914;" edge="1" parent="1" source="d-addr" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="issues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="state" target="tokens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="when built" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tokens" target="social"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="commit · read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0.043;exitY=1;entryX=0.736;entryY=0;" edge="1" parent="1" source="state" target="lane6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="624" /><mxPoint x="384" y="624" /><mxPoint x="384" y="1150" /></Array></mxGeometry></mxCell><mxCell id="contract" value="&lt;b&gt;Contract&lt;/b&gt; · Identity is the only writer of the customer, the credential, brand membership, addresses, contacts, and consent. Kong, Notification, Delivery, and the BFFs read live over gRPC or HTTP. Nobody keeps a copy (D-05).&lt;br&gt;Publishes nothing and consumes nothing. Every path is synchronous, so there is no Ack. StartSignIn calls Notification.SendOtp because the shopper is waiting." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="416" y="1088" width="1548" height="48" as="geometry" /></mxCell><mxCell id="lane6" value="&lt;b style=&quot;font-size:13px&quot;&gt;6 · Data&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B" vertex="1" parent="1"><mxGeometry x="16" y="1150" width="500" height="350" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aurora PostgreSQL · schema identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;customer, credential, customer_brand, address,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;consent, audit, idempotency&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="1190" width="468" height="80" as="geometry" /></mxCell><mxCell id="vk" value="&lt;b style=&quot;font-size:12px&quot;&gt;ElastiCache Valkey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;OTP challenge (short TTL), refresh-token family,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;rate-limit buckets — never the truth&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="1288" width="468" height="80" as="geometry" /></mxCell><mxCell id="vlt" value="&lt;b style=&quot;font-size:12px&quot;&gt;Vault&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;customer token signing key&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="1386" width="468" height="72" as="geometry" /></mxCell><mxCell id="pg-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="pg"><mxGeometry x="16" y="25" width="30" height="30" as="geometry" /></mxCell><mxCell id="vk-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="vk"><mxGeometry x="16" y="25" width="30" height="30" as="geometry" /></mxCell><mxCell id="vlt-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="vlt"><mxGeometry x="16" y="21" width="30" height="30" as="geometry" /></mxCell><mxCell id="lane7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Decisions · what it costs&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B" vertex="1" parent="1"><mxGeometry x="532" y="1150" width="640" height="350" as="geometry" /></mxCell><mxCell id="dec" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;Customer and login are one domain&lt;/b&gt; (§3). Addresses and PDPA consent live in this schema, not a separate service → one commit, no saga and no compensation · cost: they deploy together&lt;/li&gt;&lt;li&gt;&lt;b&gt;Live reads, no contact copy&lt;/b&gt; (D-05, P-24) → one PDPA copy · cost: a send or a dispatch waits if Identity is down&lt;/li&gt;&lt;li&gt;&lt;b&gt;OTP in Valkey until it expires&lt;/b&gt; (D-04) → no OTP table · cost: losing Valkey cancels sign-ins in flight&lt;/li&gt;&lt;li&gt;&lt;b&gt;5-minute access token, no denylist&lt;/b&gt; (§8) · cost: a closed account's token can last until it expires&lt;/li&gt;&lt;li&gt;&lt;b&gt;One account across brands&lt;/b&gt; (D-11, P-33) → a cross-brand read checks consent · cost: that read calls Identity&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cut:&lt;/b&gt; a separate auth app, the registration saga, and customer.lifecycle.fact — no named consumer (principle 1). Loyalty reads order.events. Cost: a join is not announced&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="544" y="1184" width="616" height="300" as="geometry" /></mxCell><mxCell id="lane8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Not this domain&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8" vertex="1" parent="1"><mxGeometry x="1188" y="1150" width="776" height="350" as="geometry" /></mxCell><mxCell id="nothere" value="&lt;ul style='margin:0;padding-left:16px'&gt;&lt;li&gt;Admin and partner identity, Azure AD → &lt;b&gt;Admin &amp; Partner&lt;/b&gt; (D-01)&lt;/li&gt;&lt;li&gt;Sending SMS, push, LINE, device tokens, the message log → &lt;b&gt;Notification&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Points, tier, member card → &lt;b&gt;Loyalty&lt;/b&gt; (one profile per brand, D-11). Not drawn yet&lt;/li&gt;&lt;li&gt;Stored value → &lt;b&gt;Wallet&lt;/b&gt; · saved cards → &lt;b&gt;Payment&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Cross-brand customer view → &lt;b&gt;Data platform&lt;/b&gt; (planned, O-25). No fact feeds it until a consumer exists&lt;/li&gt;&lt;li&gt;&lt;b&gt;Open:&lt;/b&gt; O-06 how Kong sets X-Brand-Id · O-26 what a franchisor sees · O-07 how long the audit row is kept&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1200" y="1184" width="752" height="300" as="geometry" /></mxCell><mxCell id="foot" value="Identity &amp; Profile HLD v1 · sources: architecture.md, kafka-topics.md, platform-concept.md · checked against refs/customer-hld and the Identity target-architecture draft · 2026-10-19" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=top;fontSize=10;fontColor=#94A3B8;align=right;" vertex="1" parent="1"><mxGeometry x="16" y="1510" width="1948" height="20" as="geometry" /></mxCell><mxCell id="soc-apple" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" vertex="1" parent="social"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell><mxCell id="soc-google" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="social"><mxGeometry x="54" y="27" width="30" height="30" as="geometry" /></mxCell><mxCell id="soc-line" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" vertex="1" parent="social"><mxGeometry x="92" y="27" width="30" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
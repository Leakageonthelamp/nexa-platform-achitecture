        <mxCell id="n12" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#ECFDF5;strokeColor=#059669;" value="4. Facts out" vertex="1">
          <mxGeometry height="616" width="300" x="1284" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n45" parent="n12" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;brand.changed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;compacted · key = brand_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;live? and version&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;older version is a no-op&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="268" x="16" y="48" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="n45" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">
          <mxGeometry height="30" width="30" x="16" y="27" as="geometry" />
        </mxCell>
        <mxCell id="n47" parent="n12" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;store.changed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;compacted · key = brand_id:store_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;hours · status · zone · group_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;no snapshot topic&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="268" x="16" y="148" as="geometry" />
        </mxCell>
        <mxCell id="n48" parent="n47" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">

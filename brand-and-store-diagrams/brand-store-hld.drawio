        </mxCell>
        <mxCell id="n49" parent="n12" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#047857;" value="A new consumer reads the latest value per key, then Ack. It does not replay history." vertex="1">
          <mxGeometry height="48" width="268" x="16" y="248" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="5. Consumers" vertex="1">
          <mxGeometry height="616" width="376" x="1680" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n50" parent="n13" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;brand.changed · store.changed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;hides a brand that is not live&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="260" x="16" y="48" as="geometry" />
        </mxCell>
        <mxCell id="n51" parent="n13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" value="Ack" vertex="1">
          <mxGeometry height="28" width="72" x="288" y="68" as="geometry" />
        </mxCell>
        <mxCell id="n54" parent="n13" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;store.changed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;catchment only · not the fee&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="260" x="16" y="132" as="geometry" />
        </mxCell>
        <mxCell id="n55" parent="n13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" value="Ack" vertex="1">
          <mxGeometry height="28" width="72" x="288" y="152" as="geometry" />
        </mxCell>
        <mxCell id="n56" parent="n13" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1D4ED8;" value="Apply only if the version is newer, then Ack. Same version is a no-op." vertex="1">
          <mxGeometry height="40" width="344" x="16" y="216" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="6. Data · commit here, then the fact" vertex="1">
          <mxGeometry height="350" width="500" x="16" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="n57" parent="n14" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Aurora PostgreSQL · PostGIS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;brand · store · group · hours · zone&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;version · outbox · audit&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="468" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n58" parent="n57" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">
          <mxGeometry height="30" width="30" x="16" y="19" as="geometry" />
        </mxCell>
        <mxCell id="n59" parent="n14" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;hot ResolveStore · ListNearest&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;filled in-process · Postgres is the source&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="468" x="16" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n60" parent="n59" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">
          <mxGeometry height="30" width="30" x="16" y="19" as="geometry" />
        </mxCell>
        <mxCell id="n61" parent="n14" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="No snapshot topic. The compacted facts are the latest value per key." vertex="1">
          <mxGeometry height="40" width="468" x="16" y="212" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="Decisions · why this, and what it costs" vertex="1">
          <mxGeometry height="350" width="688" x="532" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="n62" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• &lt;b&gt;One engine.&lt;/b&gt; Brand and store ship as one service. Two engines would be a second deploy and a hop on every store write.&lt;br&gt;• &lt;b&gt;Two topics, not nine.&lt;/b&gt; brand.changed and store.changed are compacted. Hours, status, zone, and group ride on store.changed.&lt;br&gt;• &lt;b&gt;No open-now topic.&lt;/b&gt; A cron that publishes availability is a second source of truth. Readers derive it.&lt;br&gt;• &lt;b&gt;Import is a worker.&lt;/b&gt; It reads the file. A command topic would have one consumer: this same service.&lt;br&gt;• &lt;b&gt;Outbox in the app.&lt;/b&gt; No Debezium and no Kafka Connect cluster." vertex="1">
          <mxGeometry height="200" width="608" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n63" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="Cost: Catalog and Delivery each read a fatter store fact and ignore the fields they do not need. A new consumer rebuilds from the latest value per key." vertex="1">
          <mxGeometry height="56" width="608" x="16" y="256" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="772" x="1284" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="n64" parent="n16" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="&lt;b&gt;Catalog&lt;/b&gt; — menu and SKU. This engine stores no product.&lt;br&gt;&lt;b&gt;Order&lt;/b&gt; — cart, checkout, POS ticket. It calls ResolveStore at checkout and keeps no copy.&lt;br&gt;&lt;b&gt;Delivery&lt;/b&gt; — fee, fleet, hub. The polygon here only answers which store serves a point.&lt;br&gt;&lt;b&gt;Admin &amp;amp; Partner&lt;/b&gt; — Azure AD, the role, the grant. JWT roles[] is fixed until the next token.&lt;br&gt;&lt;b&gt;Payment&lt;/b&gt; — gateway keys.&lt;br&gt;&lt;b&gt;Left behind&lt;/b&gt; — Redbook Laravel reads, Mongo trade zones, RabbitMQ." vertex="1">
          <mxGeometry height="250" width="724" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n65" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Admin BFF writes. Guest, customer, and Order read ResolveStore and ListNearest. Facts leave after the commit. The feed is a worker, not a topic. Open-now is derived.&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="1412" x="532" y="1148" as="geometry" />
        </mxCell>
        <mxCell id="n66" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="A feed row older than the admin version is dropped. A bad row is dead-lettered inside the worker and does not blank a live store. Rows stay when a brand goes not-live." vertex="1">
          <mxGeometry height="28" width="1412" x="532" y="1200" as="geometry" />
        </mxCell>

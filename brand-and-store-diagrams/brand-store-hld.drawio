          <mxGeometry height="68" width="212" x="284" y="448" as="geometry" />
        </mxCell>
        <mxCell id="n44" parent="n11" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" value="Open-now is hours + status + now. It is not stored and it is not a topic. A reader derives it. Valkey is filled in-process after the commit, not by this service consuming its own facts." vertex="1">
          <mxGeometry height="48" width="748" x="16" y="548" as="geometry" />
        </mxCell>
        <mxCell id="b10" edge="1" parent="n11" source="n40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#A16207;fontColor=#A16207;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" target="n31" value="">

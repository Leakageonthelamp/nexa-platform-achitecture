        <mxCell id="title" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" value="&lt;b&gt;Brand &amp; Store — Admin writes, facts on Kafka, shopper only reads&lt;/b&gt;" vertex="1">

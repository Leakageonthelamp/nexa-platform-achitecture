        <mxCell id="t1" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;" value="&lt;b&gt;Notification — facts and commands in, one message log, every channel out&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="1920" x="24" y="12" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;" value="One Go engine. Notification owns the templates, the message log, the inbox, device tokens, and channel reachability. Identity owns the contact and the PDPA consent, read over gRPC at send time, so no personal data rides the bus. OTP is the only sync send. Push, SMS, email, LINE, WebSocket, and inbox. brand_id on every hop." vertex="1">
          <mxGeometry height="34" width="1920" x="24" y="46" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#EA580C;fillColor=#FFF7ED;strokeColor=#EA580C;" value="gRPC · SendOtp · inbox · RegisterDevice · templates · BatchGetContacts (client waits)" vertex="1">

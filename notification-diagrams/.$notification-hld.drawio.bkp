        <mxCell id="c1" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Identity calls SendOtp. customer-bff calls the inbox and RegisterDevice, and holds the WebSocket. admin-bff writes templates and brand config.&lt;br&gt;Kafka in: order.events, payment.events, notification.requested. No fact out. The provider calls and the Valkey publish are workers, not topics.&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="1412" x="532" y="1148" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" value="A repeated event_id is a no-op. A crash before Ack replays into the unique message row. Marketing waits for quiet hours. SendOtp and the realtime publish have no Ack." vertex="1">
          <mxGeometry height="28" width="1412" x="532" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="L6" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="6. Data · commit here, then the send" vertex="1">
          <mxGeometry height="350" width="500" x="16" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="pg" parent="L6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;templates · message log by day · inbox&lt;br&gt;devices · reachability · preferences&lt;br&gt;brand_id · audit&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="468" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="pg_l0" parent="pg" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="27" as="geometry" />
        </mxCell>
        <mxCell id="vk" parent="L6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;ElastiCache Valkey&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;token buckets · dedupe&lt;br&gt;pub/sub for the WebSocket&lt;br&gt;miss reads Postgres&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="226" x="16" y="140" as="geometry" />
        </mxCell>
        <mxCell id="vk_l0" parent="vk" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="35" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="L6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;broadcast audience files&lt;br&gt;written by Campaign&lt;br&gt;read by the worker&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="254" y="140" as="geometry" />
        </mxCell>
        <mxCell id="s3_l0" parent="s3" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="35" as="geometry" />
        </mxCell>
        <mxCell id="vault" parent="L6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Vault&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;FCM service account · APNs key · LINE token per brand&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="468" x="16" y="252" as="geometry" />
        </mxCell>
        <mxCell id="vault_l0" parent="vault" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="11" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="L6" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="No personal data on the bus. The message log keeps customer_id, not the phone or the email." vertex="1">
          <mxGeometry height="28" width="468" x="16" y="312" as="geometry" />
        </mxCell>
        <mxCell id="L7" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="Decisions · why this, and what it costs" vertex="1">
          <mxGeometry height="350" width="688" x="532" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="L7" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="• &lt;b&gt;No fact out.&lt;/b&gt; Nobody downstream acts on a delivery status. Cost: stats and CSC read over gRPC, not a stream.&lt;br&gt;• &lt;b&gt;One command topic.&lt;/b&gt; send, broadcast, and receipt share notification.requested. Cost: one wide oneof.&lt;br&gt;• &lt;b&gt;OTP is gRPC, inline.&lt;/b&gt; Identity is waiting. Cost: an SMS outage fails the login fast. No second provider.&lt;br&gt;• &lt;b&gt;Contacts read live.&lt;/b&gt; BatchGetContacts on Identity, so no PII on the bus. Cost: an Identity outage delays sends.&lt;br&gt;• &lt;b&gt;Send workers on the message log.&lt;/b&gt; A broadcast never delays an order push. Cost: the ponytail ceiling." vertex="1">
          <mxGeometry height="96" width="656" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="L7" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="• &lt;b&gt;WebSocket in customer-bff.&lt;/b&gt; Valkey pub/sub, at-most-once. Cost: a dropped frame. The app re-reads GetOrder, and push plus inbox cover it.&lt;br&gt;• &lt;b&gt;At-least-once to providers.&lt;/b&gt; The unique row stops a replay. Cost: a crash after the provider 200 can send one duplicate.&lt;br&gt;• &lt;b&gt;FCM covers iOS.&lt;/b&gt; One integration. Cost: iOS push depends on FCM.&lt;br&gt;• &lt;b&gt;Brands are rows.&lt;/b&gt; Sender ID, SES identity, LINE OA, and FCM project are config, not a stack per brand." vertex="1">
          <mxGeometry height="150" width="656" x="16" y="140" as="geometry" />
        </mxCell>
        <mxCell id="L8" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="772" x="1284" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="nd" parent="L8" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="Identity — the contact, the LINE user id, PDPA consent, and OTP generate + verify. Notification only delivers the code.&lt;br&gt;Order, Payment — read from order.events and payment.events. Notification never calls them and never moves a status.&lt;br&gt;Voucher &amp;amp; Campaign — segments and the schedule. It writes the audience file and sends broadcast.&lt;br&gt;Loyalty, Wallet — send on notification.requested until each has its own fact topic.&lt;br&gt;Delivery — rider ETA and tracking. No delivery.* topic yet. When it ships, it is one more consume here.&lt;br&gt;Aggregators — Grab, LINE MAN, Shopee Food notify their own customer. Their orders get no message from us.&lt;br&gt;POS / kitchen — store-side alerts stay in BSL.&lt;br&gt;Admin &amp;amp; Partner — admin login and grants. This engine only trusts the headers Kong injected." vertex="1">
          <mxGeometry height="290" width="740" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="data_rel" edge="1" parent="1" source="L3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0.0333;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" target="L6" value="commit · send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

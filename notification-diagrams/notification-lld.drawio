<mxCell id="lld-13-n14" parent="lld-13-n8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;no socket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;frame dropped&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;nothing is stored&lt;/font&gt;" vertex="1"><mxGeometry x="544" y="172" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="lld-13-n15" parent="lld-13-n8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;reconnect&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;ListInbox (LLD 8)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;GetOrder on Order&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="172" width="216" height="84" as="geometry" /></mxCell>

<mxCell id="lld-10-n24" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields (draft)" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry" /></mxCell>
<mxCell id="lld-10-n25" parent="lld-10-n24" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc UpsertBrandChannel(BrandChannel)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (BrandChannel);&lt;br&gt;rpc GetBrandChannel(GetBrandChannelRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (BrandChannel);&lt;br&gt;&lt;br&gt;message BrandChannel {&lt;br&gt;&amp;nbsp;&amp;nbsp;string channel = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string sender_ref = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string secret_path = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;bytes secret = 4;  // request only&lt;br&gt;}&lt;br&gt;SES and SMS leave secret empty (IAM role)&lt;br&gt;Get never returns secret bytes" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="lld-10-n26" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="lld-10-n27" parent="lld-10-n26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="brand_channels&lt;br&gt;&amp;nbsp;&amp;nbsp;brand_id · channel&lt;br&gt;&amp;nbsp;&amp;nbsp;sender_ref · secret_path&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE(brand_id, channel)&lt;br&gt;&lt;br&gt;Vault holds the bytes&lt;br&gt;audit  actor · channel · path&lt;br&gt;&amp;nbsp;&amp;nbsp;never the secret" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="lld-10-n28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="lld-10-n29" parent="lld-10-n28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Same idempotency-key returns the first save and does not rotate the secret.&lt;br&gt;• rotate=true writes a new Vault version and updates the path in the same attempt. Vault failure rolls back the row.&lt;br&gt;• GetBrandChannel is a read of Aurora. It does not call Vault." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="lld-10-n30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="lld-10-n31" parent="lld-10-n30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• SES and SMS use an IAM role, so those channels have a sender ref and no static key.&lt;br&gt;• One LINE OA and one SES identity per brand.&lt;br&gt;• Logs and the gRPC response never carry the token. The path is enough for the sender." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="12 · CSC log and resend" id="lld-11"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="lld-11-n1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Notification LLD 12 — CSC: read the message log, resend writes a new row" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
<mxCell id="lld-11-n2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="CSC uses admin-bff with the manage-notification grant. The log shows customer_id, channel, and status, never the phone or the email. Resend inserts a new message. The original row stays as it was.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

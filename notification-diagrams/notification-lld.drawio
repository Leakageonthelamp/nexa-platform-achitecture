<mxCell id="lld-15-n7" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" value="Failure exit  ·  status or DLQ" vertex="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell>

<mxCell id="p1-v28" parent="p1-v27" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc SendOtp(SendOtpRequest) returns (SendOtpResponse);&lt;br&gt;&lt;br&gt;message SendOtpRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string customer_id = 1;  // may be empty at signup&lt;br&gt;&amp;nbsp;&amp;nbsp;string phone_e164  = 2;  // used, never stored&lt;br&gt;&amp;nbsp;&amp;nbsp;string code        = 3;  // never logged&lt;br&gt;&amp;nbsp;&amp;nbsp;string locale      = 4;  // th | en&lt;br&gt;&amp;nbsp;&amp;nbsp;string purpose     = 5;  // login | signup | change&lt;br&gt;}&lt;br&gt;message SendOtpResponse { string message_id = 1; }" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v29" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v30" parent="p1-v29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="messages&lt;br&gt;&amp;nbsp;&amp;nbsp;channel = sms · template = otp&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id · status · provider_message_id&lt;br&gt;&amp;nbsp;&amp;nbsp;no phone and no code in the row&lt;br&gt;&lt;br&gt;Valkey&lt;br&gt;&amp;nbsp;&amp;nbsp;rl:{brand}:otp        token bucket&lt;br&gt;&amp;nbsp;&amp;nbsp;rl:{brand}:{hash(phone)}" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v31" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v32" parent="p1-v31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Not idempotent by key: a resend is a new code from Identity.&lt;br&gt;• One provider retry fits inside the 3 s deadline; Identity decides whether to try again.&lt;br&gt;• The OTP pool has its own workers, so a broadcast never delays a code." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v34" parent="p1-v33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Identity owns OTP generate and verify. Notification only delivers the code.&lt;br&gt;• Logs never carry an OTP or contact data (§8).&lt;br&gt;• The SMS uses an IAM role, so there is no static key." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>

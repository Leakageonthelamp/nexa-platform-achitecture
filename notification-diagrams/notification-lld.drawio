<mxCell id="lld-7-n27" parent="lld-7-n26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc ListInbox(ListInboxRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ListInboxResponse);&lt;br&gt;rpc MarkRead(MarkReadRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (MarkReadResponse);&lt;br&gt;&lt;br&gt;message InboxItem {&lt;br&gt;&amp;nbsp;&amp;nbsp;string message_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string title = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string body = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 created_at = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;bool unread = 5;&lt;br&gt;}&lt;br&gt;MarkRead message_ids empty = mark all&lt;br&gt;metadata: x-brand-id · x-principal-id" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="lld-7-n28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>

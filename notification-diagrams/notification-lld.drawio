<mxCell id="lld-8-n2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="customer-bff reads and writes channel preferences. These rows belong to Notification. PDPA consent stays in Identity and is checked again at send time. OTP and transactional cannot be turned off here.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

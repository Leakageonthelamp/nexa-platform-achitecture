<mxCell id="lld-11-n29" parent="lld-11-n28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc ListMessages(ListMessagesRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ListMessagesResponse);&lt;br&gt;rpc Resend(ResendRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ResendResponse);&lt;br&gt;&lt;br&gt;message MessageLog {&lt;br&gt;&amp;nbsp;&amp;nbsp;string message_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string customer_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string channel = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;string status = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;string template_id = 5;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 created_at = 6;&lt;br&gt;}&lt;br&gt;Resend carries message_id + idempotency_key" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="lld-11-n30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>

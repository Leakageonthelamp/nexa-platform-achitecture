<mxCell id="p0-v36" parent="p0-v35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic order.events  key brand_id:order_id&lt;br&gt;&amp;nbsp;&amp;nbsp;oneof placed · accepted · ready · completed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cancelled{reason} · rejected{reason}&lt;br&gt;&amp;nbsp;&amp;nbsp;carries customer_id, never a phone or email&lt;br&gt;&lt;br&gt;rule table (draft)&lt;br&gt;&amp;nbsp;&amp;nbsp;event_type → template_id · channels[]&lt;br&gt;&amp;nbsp;&amp;nbsp;e.g. accepted → push + inbox&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cancelled(payment_failed) → push + SMS&lt;br&gt;&lt;br&gt;rpc BatchGetContacts(ids ≤ 500)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ contact · consent · locale · line_id" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v37" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v38" parent="p0-v37" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="messages  (partitioned by day)&lt;br&gt;&amp;nbsp;&amp;nbsp;message_id · brand_id · customer_id&lt;br&gt;&amp;nbsp;&amp;nbsp;event_id · channel · template_id&lt;br&gt;&amp;nbsp;&amp;nbsp;status queued → sent → delivered | failed&lt;br&gt;&amp;nbsp;&amp;nbsp;provider_message_id&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE(event_id, customer_id, channel)&lt;br&gt;&lt;br&gt;inbox_items  customer_id · message_id · read_at&lt;br&gt;workers claim status = queued, by priority" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v39" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v40" parent="p0-v39" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Fact, so dedupe on event_id: the unique (event_id, customer_id, channel) row makes a replay a no-op. One event fans out to many recipients.&lt;br&gt;• Ack after the message rows commit; nobody waits on a provider.&lt;br&gt;• Provider 5xx: 3× with backoff, then failed.&lt;br&gt;• The contact is read at send time, so no personal data is stored or rides the bus." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v41" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v42" parent="p0-v41" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• payment.events{refunded} is LLD 6. Every other payment variant Acks with no work.&lt;br&gt;• Aggregator orders are skipped: the aggregator messages its own shopper.&lt;br&gt;• Realtime is Valkey pub/sub, at-most-once. The app re-reads on reconnect.&lt;br&gt;• Priority pools never share workers: OTP, transactional, marketing." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · SendOtp" id="lld-1"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="p1-v1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Notification LLD 2 — SendOtp: Identity waits up to 3 seconds" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
<mxCell id="p1-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="Identity owns the OTP code and the contact. It calls SendOtp and the shopper waits. Notification renders the brand template and sends the SMS inline. The code is never logged or stored.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

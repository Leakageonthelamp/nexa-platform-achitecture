<mxCell id="lld-6-n25" parent="lld-6-n24" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="message Send {&lt;br&gt;&amp;nbsp;&amp;nbsp;string customer_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string template_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated string channels = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;map&lt;string,string&gt; vars = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;string priority = 5;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// transactional | marketing&lt;br&gt;}&lt;br&gt;key brand_id:notification_id&lt;br&gt;&amp;nbsp;&amp;nbsp;vars never carry a phone, email, or line id" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>

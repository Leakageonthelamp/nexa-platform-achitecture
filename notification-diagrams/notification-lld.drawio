<mxCell id="lld-14-n7" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#B91C1C;fillColor=#FEF2F2;strokeColor=#DC2626;" value="Failure exit  ·  status or DLQ" vertex="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell>
<mxCell id="lld-14-n8" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#FFFDF5;strokeColor=#EAB308;swimlaneFillColor=#FFFDF5;strokeWidth=1.5;fontColor=#0F172A;" value="Flow  ·  send worker claims the log · nobody waits · no Ack" vertex="1"><mxGeometry x="16" y="128" width="1948" height="400" as="geometry" /></mxCell>

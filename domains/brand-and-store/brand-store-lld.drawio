<mxCell id="p0-v30" parent="p0-v29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc UpsertStore(UpsertStoreRequest) returns (Store);&lt;br&gt;&lt;br&gt;message UpsertStoreRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;Store store            = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 expected_version = 2;  // 0 = create&lt;br&gt;}&lt;br&gt;message Store {&lt;br&gt;&amp;nbsp;&amp;nbsp;string store_id = 1;  string group_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string name = 3;      Address address = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;double lat = 5;       double lng = 6;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated string service_modes = 7;&lt;br&gt;&amp;nbsp;&amp;nbsp;WeeklyHours hours = 8;&lt;br&gt;&amp;nbsp;&amp;nbsp;string status = 9;    // draft|open|paused|hidden|closed&lt;br&gt;&amp;nbsp;&amp;nbsp;string zone_geojson = 10;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  version = 11;&lt;br&gt;}&lt;br&gt;&lt;br&gt;topic store.changed  key brand_id:store_id  compacted&lt;br&gt;&amp;nbsp;&amp;nbsp;value = the whole Store" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v31" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v32" parent="p0-v31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="stores&lt;br&gt;&amp;nbsp;&amp;nbsp;store_id PK · brand_id · group_id&lt;br&gt;&amp;nbsp;&amp;nbsp;status · service_modes · version&lt;br&gt;&amp;nbsp;&amp;nbsp;location geography(Point)&lt;br&gt;&lt;br&gt;store_hours   store_id · weekday · open · close&lt;br&gt;store_zones   store_id · zone geography(Polygon)&lt;br&gt;&lt;br&gt;outbox: store.changed&lt;br&gt;audit_log: same transaction" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v34" parent="p0-v33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• expected_version stops two admins overwriting each other (ABORTED).&lt;br&gt;• Consumers apply store.changed only when version is newer; same version is a no-op.&lt;br&gt;• Hours, status, and zone use the same RPC family and the same fact." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v36" parent="p0-v35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• No command topic: the admin is waiting.&lt;br&gt;• Open-now is derived at read (LLD 2), never stored or published.&lt;br&gt;• D-07: consumers change their own rows; they keep no store copy.&lt;br&gt;• Azure AD and the grant belong to Admin &amp;amp; Partner." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>

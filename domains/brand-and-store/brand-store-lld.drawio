<mxCell id="p2-v27" parent="p2-v26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc ListNearest(ListNearestRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ListNearestResponse);&lt;br&gt;&lt;br&gt;message ListNearestRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;double lat = 1;  double lng = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;string service_mode = 3;  // delivery | pickup&lt;br&gt;&amp;nbsp;&amp;nbsp;int32  limit = 4;         // ≤ 20&lt;br&gt;}&lt;br&gt;&lt;br&gt;SELECT s.store_id, ST_Distance(s.location, $p) d&lt;br&gt;FROM   stores s JOIN store_zones z USING (store_id)&lt;br&gt;WHERE  s.brand_id = $brand&lt;br&gt;&amp;nbsp;&amp;nbsp;AND  s.status &amp;lt;&amp;gt; &#x27;hidden&#x27;&lt;br&gt;&amp;nbsp;&amp;nbsp;AND  ST_Contains(z.zone, $p)&lt;br&gt;ORDER  BY d LIMIT $limit;" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v29" parent="p2-v28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="Nothing in Postgres. Read only.&lt;br&gt;&lt;br&gt;Valkey&lt;br&gt;&amp;nbsp;&amp;nbsp;near:{brand}:{geohash7}:{mode}&lt;br&gt;&amp;nbsp;&amp;nbsp;store ids only · TTL 60 s" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v31" parent="p2-v30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Read only, safe to retry.&lt;br&gt;• A store edit can take up to 60 s to show in this list. ResolveStore at checkout is always live." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v33" parent="p2-v32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• PostGIS zones are kept on purpose.&lt;br&gt;• guest-bff may call only ListNearest and GetMenu.&lt;br&gt;• The zone answers which store serves a point; the delivery fee is Delivery’s.&lt;br&gt;• ponytail: geohash-7 cell, about 150 m. Upgrade: smaller cell if results look wrong at zone edges." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>

<mxCell id="p1-v27" parent="p1-v26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc ResolveStore(ResolveStoreRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ResolveStoreResponse);&lt;br&gt;&lt;br&gt;message ResolveStoreRequest { string store_id = 1; }&lt;br&gt;message ResolveStoreResponse {&lt;br&gt;&amp;nbsp;&amp;nbsp;Store store       = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;bool  brand_live  = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;bool  open_now    = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;bool  orderable   = 4;   // live &amp;amp;&amp;amp; open &amp;amp;&amp;amp; status=open&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated string service_modes_now = 5;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 next_open_unix = 6;&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v29" parent="p1-v28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="Nothing in Postgres. Read only.&lt;br&gt;&lt;br&gt;Valkey&lt;br&gt;&amp;nbsp;&amp;nbsp;store:{brand}:{store}  TTL 60 s&lt;br&gt;&amp;nbsp;&amp;nbsp;deleted on every write (LLD 1)" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v31" parent="p1-v30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Read only, safe to retry.&lt;br&gt;• Deadline from the caller; Order shares the PlaceOrder budget.&lt;br&gt;• The cached row has no open_now, so the TTL never makes open-now wrong." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p1-v32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p1-v33" parent="p1-v32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• D-07: Order checks the store live and keeps no copy.&lt;br&gt;• Cost: checkout fails when Brand &amp;amp; Store is down.&lt;br&gt;• Valkey is filled in-process, not by consuming store.changed." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>

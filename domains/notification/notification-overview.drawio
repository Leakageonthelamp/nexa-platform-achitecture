        <mxCell id="title" value="System overview" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=28;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="900" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Facts come in. One message log sends them on. Nothing personal rides the bus." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=14;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1200" height="24" as="geometry"/></mxCell><mxCell id="cap-spend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6E8EC;strokeWidth=1;absoluteArcSize=1;arcSize=12;shadow=0;container=1;collapsible=0;fontFamily=Arial;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="360" height="172" as="geometry"/></mxCell><mxCell id="cap-spend-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/png," vertex="1" parent="cap-spend"><mxGeometry x="16" y="14" width="28" height="28" as="geometry"/></mxCell><mxCell id="cap-spend-h" value="&lt;b&gt;Order status&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=16;fontStyle=1;" vertex="1" parent="cap-spend"><mxGeometry x="54" y="12" width="180" height="32" as="geometry"/></mxCell><mxCell id="cap-spend-list" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1E3F73&quot;&gt;Kafka from Orders&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4B5563&quot;&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;The order, and the trip&lt;/li&gt;&lt;li&gt;A push, an inbox row, a live frame&lt;/li&gt;&lt;li&gt;Aggregator orders are skipped&lt;/li&gt;&lt;li&gt;A replay never sends twice&lt;/li&gt;&lt;/ul&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;verticalAlign=top;fontSize=13;" vertex="1" parent="cap-spend"><mxGeometry x="16" y="52" width="328" height="108" as="geometry"/></mxCell><mxCell id="cap-topup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6E8EC;strokeWidth=1;absoluteArcSize=1;arcSize=12;shadow=0;container=1;collapsible=0;fontFamily=Arial;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="420" y="124" width="360" height="172" as="geometry"/></mxCell><mxCell id="cap-topup-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/png," vertex="1" parent="cap-topup"><mxGeometry x="16" y="14" width="28" height="28" as="geometry"/></mxCell><mxCell id="cap-topup-h" value="&lt;b&gt;Refund&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=16;fontStyle=1;" vertex="1" parent="cap-topup"><mxGeometry x="54" y="12" width="180" height="32" as="geometry"/></mxCell><mxCell id="cap-topup-list" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1E3F73&quot;&gt;Kafka from Payments&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4B5563&quot;&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Only a refund becomes a message&lt;/li&gt;&lt;li&gt;Other payment facts are ignored&lt;/li&gt;&lt;li&gt;The shopper is not told twice&lt;/li&gt;&lt;li&gt;The send is one row in the log&lt;/li&gt;&lt;/ul&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;verticalAlign=top;fontSize=13;" vertex="1" parent="cap-topup"><mxGeometry x="16" y="52" width="328" height="108" as="geometry"/></mxCell><mxCell id="cap-correct" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6E8EC;strokeWidth=1;absoluteArcSize=1;arcSize=12;shadow=0;container=1;collapsible=0;fontFamily=Arial;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="800" y="124" width="360" height="172" as="geometry"/></mxCell><mxCell id="cap-correct-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/png," vertex="1" parent="cap-correct"><mxGeometry x="16" y="14" width="28" height="28" as="geometry"/></mxCell><mxCell id="cap-correct-h" value="&lt;b&gt;One-time code&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=16;fontStyle=1;" vertex="1" parent="cap-correct"><mxGeometry x="54" y="12" width="180" height="32" as="geometry"/></mxCell><mxCell id="cap-correct-list" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1E3F73&quot;&gt;Identity asks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4B5563&quot;&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;The shopper is waiting on the code&lt;/li&gt;&lt;li&gt;The code itself stays in Identity&lt;/li&gt;&lt;li&gt;The phone is read at send time&lt;/li&gt;&lt;li&gt;Consent is checked first&lt;/li&gt;&lt;/ul&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;verticalAlign=top;fontSize=13;" vertex="1" parent="cap-correct"><mxGeometry x="16" y="52" width="328" height="108" as="geometry"/></mxCell><mxCell id="cap-lookup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6E8EC;strokeWidth=1;absoluteArcSize=1;arcSize=12;shadow=0;container=1;collapsible=0;fontFamily=Arial;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1180" y="124" width="360" height="172" as="geometry"/></mxCell><mxCell id="cap-lookup-ico" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/png," vertex="1" parent="cap-lookup"><mxGeometry x="16" y="14" width="28" height="28" as="geometry"/></mxCell><mxCell id="cap-lookup-h" value="&lt;b&gt;Inbox&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=16;fontStyle=1;" vertex="1" parent="cap-lookup"><mxGeometry x="54" y="12" width="180" height="32" as="geometry"/></mxCell><mxCell id="cap-lookup-list" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1E3F73&quot;&gt;Customers ask&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4B5563&quot;&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Register a phone for push&lt;/li&gt;&lt;li&gt;Read the inbox&lt;/li&gt;&lt;li&gt;A live frame can be missed&lt;/li&gt;&lt;li&gt;The app reads the inbox again&lt;/li&gt;&lt;/ul&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;verticalAlign=top;fontSize=13;" vertex="1" parent="cap-lookup"><mxGeometry x="16" y="52" width="328" height="108" as="geometry"/></mxCell><mxCell id="bus" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#E6E8EC;strokeWidth=1;absoluteArcSize=1;arcSize=16;shadow=0;container=1;collapsible=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1500" height="88" as="geometry"/></mxCell><mxCell id="bus-copy" value="&lt;b&gt;The message log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#6B7280&quot;&gt;A replay cannot send the same message twice.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="bus"><mxGeometry x="46" y="14" width="250" height="60" as="geometry"/></mxCell><mxCell id="pill-balance" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6E8
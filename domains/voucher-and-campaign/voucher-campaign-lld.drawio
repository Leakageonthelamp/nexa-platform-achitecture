age=data:image/svg+xml," vertex="1" parent="lld-4-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-4-se2" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-4-st1" target="lld-4-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-4-st3" value="&lt;b&gt;4 · Reply&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;own rows only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;no other customer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-4-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-4-se3" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-4-st2" target="lld-4-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-4-f0" value="&lt;b&gt;not their rows&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;permission denied&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;nothing returned&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-4-flow"><mxGeometry x="280" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-4-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-4-st1" target="lld-4-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-4-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="504" width="600" height="460" as="geometry" /></mxCell><mxCell id="lld-4-pb0" value="rpc ListVouchers(ListRequest)&lt;br&gt;returns (ListResponse)&lt;br&gt;metadata: x-brand-id, x-principal-id&lt;br&gt;&lt;br&gt;The principal is the customer.&lt;br&gt;An empty list is empty,&lt;br&gt;not NOT_FOUND." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-4-pn0"><mxGeometry x="16" y="40" width="568" height="404" as="geometry" /></mxCell><mxCell id="lld-4-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-4-pb1" value="No write.&lt;br&gt;&lt;br&gt;Reads vouchers&lt;br&gt;for (brand_id, customer_id)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-4-pn1"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-4-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-4-pb2" value="• Read only. No idempotency key.&lt;br&gt;• Deadline passed on from the BFF (P-02).&lt;br&gt;• A missing brand_id is INVALID_ARGUMENT." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-4-pn2"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-4-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="504" width="460" height="460" as="geometry" /></mxCell><mxCell id="lld-4-pb3" value="• One book per brand (D-11). Another brand's rows are not in this reply.&lt;br&gt;• Points and the card you scan are Loyalty." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-4-pn3"><mxGeometry x="16" y="40" width="428" height="404" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-5" name="6 · Schedule cron"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-5-t" value="Voucher LLD 6 — Schedule: open, close, and expire" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-5-s" value="*/5 * * * * means every 5 minutes, Asia/Bangkok. The job starts a campaign whose time has come, ends one whose time has passed, expires a hold the order never committed, and deletes outbox rows older than 7 days." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-5-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-5-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-5-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-5-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-5-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-5-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="360" as="geometry" /></mxCell><mxCell id="lld-5-st0" value="&lt;b&gt;1 · CronJob&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;*/5 * * * *&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Forbid&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Asia/Bangkok&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-5-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-5-st1" value="&lt;b&gt;2 · Find&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;start_at and end_at&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;holds still open&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;outbox older than 7 days&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-5-flow"><mxGeometry x="280" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-5-se1" value="scan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-5-st0" target="lld-5-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-5-st2" value="&lt;b&gt;3 · Commit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;status moves&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;hold released&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;outbox row deleted&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-5-flow"><mxGeometry x="544" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-5-st2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-5-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-5-se2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-5-st1" target="lld-5-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-5-st3" value="&lt;b&gt;4 · Done&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;no publish&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;safe to run twice&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-5-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-5-se3" value="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-5-st2" target="lld-5-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-5-f0" value="&lt;b&gt;already moved&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;skip the row&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;a second run is a no-op&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-5-flow"><mxGeometry x="544" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-5-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-5-st2" target="lld-5-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-5-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="504" width="600" height="460" as="geometry" /></mxCell><mxCell id="lld-5-pb0" value="schedule */5 * * * *&lt;br&gt;time zone Asia/Bangkok&lt;br&gt;concurrencyPolicy Forbid&lt;br&gt;&lt;br&gt;A hold is expired only when it is&lt;br&gt;still held and its order was never&lt;br&gt;committed. placed, cancelled, and&lt;br&gt;rejected are LLD 3.&lt;br&gt;&lt;br&gt;How long checkout may last is O-04.&lt;br&gt;The job uses that window. It does&lt;br&gt;not invent one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-5-pn0"><mxGeometry x="16" y="40" width="568" height="404" as="geometry" /></mxCell><mxCell id="lld-5-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-5-pb1" value="campaigns.status&lt;br&gt;&amp;nbsp;&amp;nbsp;scheduled → active → ended&lt;br&gt;holds.status = released&lt;br&gt;&amp;nbsp;&amp;nbsp;only rows still held&lt;br&gt;outbox delete where published_at&lt;br&gt;is older than 7 days (P-05)&lt;br&gt;&lt;br&gt;No outbox insert. Nothing is published." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-5-pn1"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-5-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-5-pb2" value="• Safe to run twice: a row already moved is skipped.&lt;br&gt;• No Kafka, so no Ack.&lt;br&gt;• P-07: a pod start every 5 minutes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-5-pn2"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-5-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="504" width="460" height="460" as="geometry" /></mxCell><mxCell id="lld-5-pb3" value="• The cron does not spend a hold. Only order.events{placed} does that.&lt;br&gt;• ponytail: one job for all three sweeps. Ceiling: a 5-minute delay. Upgrade: a tighter schedule if a campaign must start on the minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-5-pn3"><mxGeometry x="16" y="40" width="428" height="404" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-6" name="7 · IssueReward"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-1-t" value="Voucher LLD 7 — IssueReward: Loyalty asks for a code, and waits" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-1-s" value="Loyalty calls this from RedeemPoints, or after a level change. The caller is waiting. The key is the redemption id, so a retry cannot issue a second code. This is not the admin IssueVoucher write." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-1-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="360" as="geometry" /></mxCell><mxCell id="lld-1-st0" value="&lt;b&gt;1 · Loyalty&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;IssueReward&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;redemption id is the key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;campaign still open&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-1-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-st1" value="&lt;b&gt;2 · Check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;cap and campaign&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;a repeat returns&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;the first code&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-1-flow"><mxGeometry x="280" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-se1" value="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st0" target="lld-1-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-st2" value="&lt;b&gt;3 · Commit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;insert the voucher&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;status = issued&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;keyed by redemption id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-1-flow"><mxGeometry x="544" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-st2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-1-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-1-se2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st1" target="lld-1-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-st3" value="&lt;b&gt;4 · code back&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;voucher code&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;same key, same code&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-1-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-se3" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st2" target="lld-1-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-f0" value="&lt;b&gt;ended or full&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;failed precondition&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;no code written&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;Loyalty reverses the points&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-1-flow"><mxGeometry x="280" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-1-st1" target="lld-1-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-f1" value="&lt;b&gt;Postgres down&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;UNAVAILABLE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;nothing half-written&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;retry the same redemption id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-1-flow"><mxGeometry x="544" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-1-st2" target="lld-1-f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="504" width="600" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb0" value="rpc IssueReward(IssueRewardRequest)&lt;br&gt;returns (IssueRewardResponse)&lt;br&gt;&lt;br&gt;IssueRewardRequest&lt;br&gt;&amp;nbsp;&amp;nbsp;redemption_id&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id&lt;br&gt;&amp;nbsp;&amp;nbsp;campaign_id&lt;br&gt;&lt;br&gt;IssueRewardResponse&lt;br&gt;&amp;nbsp;&amp;nbsp;voucher_code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-1-pn0"><mxGeometry x="16" y="40" width="568" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb1" value="vouchers&lt;br&gt;&amp;nbsp;&amp;nbsp;voucher_id, brand_id, redemption_id&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id, campaign_id, code&lt;br&gt;&amp;nbsp;&amp;nbsp;status = issued&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE(brand_id, redemption_id)&lt;br&gt;No outbox row. The caller is waiting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn1"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb2" value="• A repeat with the same redemption_id returns the first code.&lt;br&gt;• Not the admin IssueVoucher grant.&lt;br&gt;• Deadline is the time Loyalty has left (P-02).&lt;br&gt;• No Ack. The caller is waiting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn2"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="504" width="460" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb3" value="• Staff IssueVoucher stays on the admin page.&lt;br&gt;• A level change uses the same door, keyed by brand, member, tier, and period.&lt;br&gt;• A failed issue does not leave a second code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn3"><mxGeometry x="16" y="40" width="428" height="404" as="geometry" /></mxCell></root></mxGraphModel></diagram>

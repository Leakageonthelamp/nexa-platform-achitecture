<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="24.0.0"><diagram id="lld-0" name="1 · EvaluateBasket"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-0-t" value="Voucher LLD 1 — EvaluateBasket: price the deals, change nothing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-0-s" value="Orders calls this on every cart read, after Catalog has priced the lines. The shopper is waiting. A code that does not apply comes back on the reply. Nothing is written, so there is no Ack." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-0-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-0-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-0-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-0-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-0-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-0-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="360" as="geometry" /></mxCell><mxCell id="lld-0-st0" value="&lt;b&gt;1 · Orders&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;EvaluateBasket&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;lines and codes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;prices already set&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-0-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-0-st1" value="&lt;b&gt;2 · Check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;brand_id required&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;codes are optional&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;no write&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-0-flow"><mxGeometry x="280" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-0-se1" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-0-st0" target="lld-0-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-0-st2" value="&lt;b&gt;3 · Read rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;active for this brand&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;fixed order&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;cap still open&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-0-flow"><mxGeometry x="544" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-0-st2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-0-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-0-se2" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-0-st1" target="lld-0-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-0-st3" value="&lt;b&gt;4 · Reply&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;allocations&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;rejected codes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;reasons&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-0-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-0-se3" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-0-st2" target="lld-0-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-0-f0" value="&lt;b&gt;no brand&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;invalid argument&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;nothing read for it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;the cart is unchanged&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-0-flow"><mxGeometry x="280" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-0-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-0-st1" target="lld-0-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-0-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="504" width="600" height="460" as="geometry" /></mxCell><mxCell id="lld-0-pb0" value="rpc EvaluateBasket(BasketRequest)&lt;br&gt;returns (BasketResponse)&lt;br&gt;&lt;br&gt;metadata: x-brand-id, x-principal-id, traceparent&lt;br&gt;&lt;br&gt;BasketRequest&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id&lt;br&gt;&amp;nbsp;&amp;nbsp;lines[]: sku_id, qty, unit_price_satang&lt;br&gt;&amp;nbsp;&amp;nbsp;voucher_codes[]&lt;br&gt;&lt;br&gt;BasketResponse&lt;br&gt;&amp;nbsp;&amp;nbsp;allocations[]: rule_id, amount_satang, label&lt;br&gt;&amp;nbsp;&amp;nbsp;rejected_codes[]: code, reason&lt;br&gt;&lt;br&gt;Prices arrive from Orders. This call does not ask Catalog." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-0-pn0"><mxGeometry x="16" y="40" width="568" height="404" as="geometry" /></mxCell><mxCell id="lld-0-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-0-pb1" value="No write.&lt;br&gt;&lt;br&gt;Reads campaigns, rules, vouchers and the open holds, to see what the cap still allows.&lt;br&gt;&lt;br&gt;A rejected code is a field on the reply, not a row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-0-pn1"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-0-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-0-pb2" value="• Read only. No idempotency key.&lt;br&gt;• Deadline is the time Orders has left (P-02).&lt;br&gt;• Retry only on UNAVAILABLE, at most twice.&lt;br&gt;• A bad code does not fail the call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-0-pn2"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-0-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="504" width="460" height="460" as="geometry" /></mxCell><mxCell id="lld-0-pb3" value="• O-21: fixed order, not a search for the best stack, and no margin floor.&lt;br&gt;• The menu does not call this. Deals are applied on the cart.&lt;br&gt;• Personal data stays off the reply (D-05)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-0-pn3"><mxGeometry x="16" y="40" width="428" height="404" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-1" name="2 · ReserveRedemptions"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-1-t" value="Voucher LLD 2 — ReserveRedemptions: hold the deals for one order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-1-s" value="The last call Orders makes before it commits the order. The shopper is waiting. The hold counts against the cap. Spending it waits for order.events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-1-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-1-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="360" as="geometry" /></mxCell><mxCell id="lld-1-st0" value="&lt;b&gt;1 · Orders&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;ReserveRedemptions&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;order_id is the key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;allocations to hold&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-1-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-st1" value="&lt;b&gt;2 · Re-check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;lock the budget rows&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;cap still covers it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;ignore the preview&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-1-flow"><mxGeometry x="280" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-se1" value="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st0" target="lld-1-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-st2" value="&lt;b&gt;3 · Commit hold&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;insert the hold&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;status = held&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;no redemption yet&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-1-flow"><mxGeometry x="544" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-st2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-1-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-1-se2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st1" target="lld-1-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-st3" value="&lt;b&gt;4 · hold_id back&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;hold_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;amount held&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;same key, same hold&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-1-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-se3" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-1-st2" target="lld-1-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-f0" value="&lt;b&gt;cap exceeded&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;failed precondition&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;no hold written&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;Orders shows the new total&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-1-flow"><mxGeometry x="280" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-1-st1" target="lld-1-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-f1" value="&lt;b&gt;Postgres down&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;UNAVAILABLE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;nothing half-written&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;retry the same order_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-1-flow"><mxGeometry x="544" y="188" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-1-fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-1-st2" target="lld-1-f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-1-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="504" width="600" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb0" value="rpc ReserveRedemptions(ReserveRequest)&lt;br&gt;returns (ReserveResponse)&lt;br&gt;&lt;br&gt;ReserveRequest&lt;br&gt;&amp;nbsp;&amp;nbsp;order_id&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id&lt;br&gt;&amp;nbsp;&amp;nbsp;allocations[]: rule_id, amount_satang&lt;br&gt;&lt;br&gt;ReserveResponse&lt;br&gt;&amp;nbsp;&amp;nbsp;hold_id&lt;br&gt;&amp;nbsp;&amp;nbsp;amount_satang&lt;br&gt;&lt;br&gt;idempotency key = order_id" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-1-pn0"><mxGeometry x="16" y="40" width="568" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb1" value="holds&lt;br&gt;&amp;nbsp;&amp;nbsp;hold_id, brand_id, order_id&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id, amount_satang&lt;br&gt;&amp;nbsp;&amp;nbsp;status = held, version&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE(brand_id, order_id)&lt;br&gt;&lt;br&gt;No outbox row. A hold is not a fact." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn1"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="504" width="410" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb2" value="• A repeat with the same order_id returns the first hold.&lt;br&gt;• SELECT … FOR UPDATE on the budget, then version + 1.&lt;br&gt;• Deadline is the time Orders has left (P-02).&lt;br&gt;• No Ack. The caller is waiting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn2"><mxGeometry x="16" y="40" width="378" height="404" as="geometry" /></mxCell><mxCell id="lld-1-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="504" width="460" height="460" as="geometry" /></mxCell><mxCell id="lld-1-pb3" value="• The hold is spent later, on order.events{placed}.&lt;br&gt;• A hold whose order never commits is expired by the cron (LLD 6).&lt;br&gt;• O-04 still sets how long checkout may take." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-1-pn3"><mxGeometry x="16" y="40" width="428" height="404" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-2" name="3 · order.events consumer"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-2-t" value="Voucher LLD 3 — order.events: spend the hold, or give it back" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-2-s" value="Nobody is waiting. placed writes the redemption. cancelled and rejected release the hold. Every other variant is an Ack with no work." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-2-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-2-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-2-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-2-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-2-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-2-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="400" as="geometry" /></mxCell><mxCell id="lld-2-st0" value="&lt;b&gt;1 · order.events&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;placed, cancelled, rejected&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;key brand_id:order_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;7 days&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="lld-2-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-st0i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-2-st0"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-2-st1" value="&lt;b&gt;2 · Dedupe&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;version newer?&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;else Ack&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;processed_event&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-2-flow"><mxGeometry x="280" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-se1" value="dedupe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-2-st0" target="lld-2-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-st2" value="&lt;b&gt;3 · Apply&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;placed spends it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;cancel or reject returns it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;other variants skip&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-2-flow"><mxGeometry x="544" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-se2" value="apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-2-st1" target="lld-2-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-st3" value="&lt;b&gt;4 · Commit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;redemption or release&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;hold status moves&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;version + 1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-2-flow"><mxGeometry x="808" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-st3i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-2-st3"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-2-se3" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-2-st2" target="lld-2-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-st4" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="lld-2-flow"><mxGeometry x="1120" y="76" width="72" height="28" as="geometry" /></mxCell><mxCell id="lld-2-se4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-2-st3" target="lld-2-st4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-f0" value="&lt;b&gt;same version&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;Ack&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;no second redemption&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-2-flow"><mxGeometry x="280" y="200" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-2-st1" target="lld-2-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-f1" value="&lt;b&gt;apply fails&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;retry 3× with backoff&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;then voucher.dlq&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;then Ack&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-2-flow"><mxGeometry x="808" y="200" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-2-fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-2-st3" target="lld-2-f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-2-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="544" width="600" height="420" as="geometry" /></mxCell><mxCell id="lld-2-pb0" value="topic order.events&lt;br&gt;key brand_id:order_id&lt;br&gt;&lt;br&gt;oneof: placed, accepted, rejected,&lt;br&gt;ready, completed, cancelled&lt;br&gt;&lt;br&gt;This consumer acts on placed,&lt;br&gt;cancelled, and rejected.&lt;br&gt;&lt;br&gt;headers: event_id, event_type, brand_id,&lt;br&gt;occurred_at, version, traceparent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-2-pn0"><mxGeometry x="16" y="40" width="568" height="364" as="geometry" /></mxCell><mxCell id="lld-2-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="544" width="410" height="420" as="geometry" /></mxCell><mxCell id="lld-2-pb1" value="On placed:&lt;br&gt;&amp;nbsp;&amp;nbsp;redemptions insert (append-only)&lt;br&gt;&amp;nbsp;&amp;nbsp;holds.status = committed&lt;br&gt;&lt;br&gt;On cancelled or rejected:&lt;br&gt;&amp;nbsp;&amp;nbsp;holds.status = released&lt;br&gt;&lt;br&gt;processed_event&lt;br&gt;&amp;nbsp;&amp;nbsp;event_id, or the stored version&lt;br&gt;&lt;br&gt;No outbox. Notification reads order.events itself." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-2-pn1"><mxGeometry x="16" y="40" width="378" height="364" as="geometry" /></mxCell><mxCell id="lld-2-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="544" width="410" height="420" as="geometry" /></mxCell><mxCell id="lld-2-pb2" value="• Facts dedupe on version (P-06).&lt;br&gt;• A missing hold on placed is a no-op, then Ack. Aggregator orders have no cart.&lt;br&gt;• Retry 3× inside the app, then voucher.dlq, then Ack.&lt;br&gt;• voucher.dlq is operational. It is not a business topic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-2-pn2"><mxGeometry x="16" y="40" width="378" height="364" as="geometry" /></mxCell><mxCell id="lld-2-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="544" width="460" height="420" as="geometry" /></mxCell><mxCell id="lld-2-pb3" value="• Principle 2: nobody is waiting, so this is not a gRPC commit.&lt;br&gt;• accepted, ready, and completed do no work.&lt;br&gt;• A redemption is not also a notification.requested send." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-2-pn3"><mxGeometry x="16" y="40" width="428" height="364" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-3" name="4 · Admin write"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-3-t" value="Voucher LLD 4 — Admin write: rules, vouchers, and the audience" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-3-s" value="admin-bff is waiting. A campaign or a voucher is written here. IssueVoucher is the staff write, not Loyalty's call. A send or a broadcast is an outbox row in that same commit. This domain does not deliver it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-3-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-3-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-3-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-3-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-3-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-3-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="460" as="geometry" /></mxCell><mxCell id="lld-3-st0" value="&lt;b&gt;1 · admin-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;upsert or issue&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;grant in X-Roles&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;version expected&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-3-flow"><mxGeometry x="16" y="48.0" width="200" height="84" as="geometry" /></mxCell><mxCell id="lld-3-st1" value="&lt;b&gt;2 · Check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;grant covers it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;version matches&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;SKUs via ListSkus&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-3-flow"><mxGeometry x="248" y="48.0" width="200" height="84" as="geometry" /></mxCell><mxCell id="lld-3-se1" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-st0" target="lld-3-st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-st2" value="&lt;b&gt;3 · Audience&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;broadcast only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;customer ids&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;file key comes back&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-3-flow"><mxGeometry x="480" y="48.0" width="200" height="84" as="geometry" /></mxCell><mxCell id="lld-3-st2i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-3-st2"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-3-se2" value="broadcast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-st1" target="lld-3-st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-st3" value="&lt;b&gt;4 · Commit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;the rule or the voucher&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;audit row&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;outbox if it sends&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="lld-3-flow"><mxGeometry x="712" y="48.0" width="220" height="84" as="geometry" /></mxCell><mxCell id="lld-3-st3i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-3-st3"><mxGeometry x="16" y="27.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-3-se3" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-st2" target="lld-3-st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-st4" value="&lt;b&gt;5 · id back&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;id and version&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;same key, same row&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-3-flow"><mxGeometry x="968" y="48.0" width="200" height="84" as="geometry" /></mxCell><mxCell id="lld-3-se4" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-st3" target="lld-3-st4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-f0" value="&lt;b&gt;refused&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;stale version → ABORTED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;Catalog down → UNAVAILABLE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px&quot;&gt;nothing is written&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="lld-3-flow"><mxGeometry x="248" y="188" width="220" height="84" as="geometry" /></mxCell><mxCell id="lld-3-fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lld-3-st1" target="lld-3-f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-b0" value="&lt;b&gt;Outbox relay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay, advisory lock&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;after the commit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="lld-3-flow"><mxGeometry x="712" y="300" width="220" height="84" as="geometry" /></mxCell><mxCell id="lld-3-be0" value="same commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-st3" target="lld-3-b0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-b1" value="&lt;b&gt;notification.requested&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;send or broadcast&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;no phone, no email&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;S3 key if broadcast&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="lld-3-flow"><mxGeometry x="968" y="300" width="280" height="84" as="geometry" /></mxCell><mxCell id="lld-3-b1i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="lld-3-b1"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell><mxCell id="lld-3-be1" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#7C3AED;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lld-3-b0" target="lld-3-b1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lld-3-pn0" value="Contract · fields (draft)" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="604" width="600" height="360" as="geometry" /></mxCell><mxCell id="lld-3-pb0" value="rpc UpsertCampaign / IssueVoucher&lt;br&gt;&lt;br&gt;metadata: x-brand-id, x-roles, traceparent&lt;br&gt;&lt;br&gt;expected version on the aggregate&lt;br&gt;idempotency_key on IssueVoucher&lt;br&gt;&lt;br&gt;broadcast audience:&lt;br&gt;&amp;nbsp;&amp;nbsp;customer_id list, written to S3&lt;br&gt;&amp;nbsp;&amp;nbsp;the command carries the key only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" vertex="1" parent="lld-3-pn0"><mxGeometry x="16" y="40" width="568" height="304" as="geometry" /></mxCell><mxCell id="lld-3-pn1" value="Writes · tables and outbox" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="632" y="604" width="410" height="360" as="geometry" /></mxCell><mxCell id="lld-3-pb1" value="campaigns, rules, vouchers&lt;br&gt;&amp;nbsp;&amp;nbsp;version + 1, brand_id&lt;br&gt;audit_log in the same transaction&lt;br&gt;&lt;br&gt;outbox, only when a message leaves:&lt;br&gt;&amp;nbsp;&amp;nbsp;topic notification.requested&lt;br&gt;&amp;nbsp;&amp;nbsp;send: template, customer_id&lt;br&gt;&amp;nbsp;&amp;nbsp;broadcast: s3 key&lt;br&gt;&lt;br&gt;A plain rule edit has no outbox row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-3-pn1"><mxGeometry x="16" y="40" width="378" height="304" as="geometry" /></mxCell><mxCell id="lld-3-pn2" value="Dedupe · deadline · retry" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1058" y="604" width="410" height="360" as="geometry" /></mxCell><mxCell id="lld-3-pb2" value="• Stale version returns ABORTED (the caller reloads).&lt;br&gt;• IssueVoucher repeats return the first voucher.&lt;br&gt;• ListSkus is skipped when the rule names no items.&lt;br&gt;• The relay is the one in P-05. This page has no Ack: admin is waiting, and Notification Acks the command." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-3-pn2"><mxGeometry x="16" y="40" width="378" height="304" as="geometry" /></mxCell><mxCell id="lld-3-pn3" value="Notes · decisions cited" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1484" y="604" width="460" height="360" as="geometry" /></mxCell><mxCell id="lld-3-pb3" value="• D-05: the audience file and the command carry customer_id only.&lt;br&gt;• Message delivery is Notification.&lt;br&gt;• GetDisplayPromos is not a method. The menu does not ask here (O-21)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" vertex="1" parent="lld-3-pn3"><mxGeometry x="16" y="40" width="428" height="304" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="lld-4" name="5 · Reads"><mxGraphModel dx="1980" dy="980" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lld-4-t" value="Voucher LLD 5 — ListVouchers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="lld-4-s" value="customer-bff reads the shopper's own vouchers. The card you scan is Loyalty. A shopper never writes. No Kafka, so there is no Ack." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="lld-4-p0" value="gRPC · sync, the caller waits" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-4-p1" value="HTTP · edge or third party" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-4-p2" value="Kafka command · .requested" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="776" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-4-p3" value="Kafka fact · after the commit" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1152" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-4-p4" value="Failure exit · status or DLQ" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#DC2626;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="1528" y="86" width="360" height="28" as="geometry" /></mxCell><mxCell id="lld-4-flow" value="Flow" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FFFDF5;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="1948" height="360" as="geometry" /></mxCell><mxCell id="lld-4-st0" value="&lt;b&gt;1 · customer-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;ListVouchers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;own principal&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;this brand only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lld-4-flow"><mxGeometry x="16" y="48.0" width="216" height="84" as="geometry" /></mxCell><mxCell id="lld-4-st1" val
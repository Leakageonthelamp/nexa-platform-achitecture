<mxfile host="Electron" pages="1">
  <diagram id="admin-partner-hld" name="Admin &amp; Partner HLD">
    <mxGraphModel dx="1088" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1604" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="Admin &amp; Partner — login is sync, and the bus is not involved" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0F172A;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
        <mxCell id="n4" value="Two engines in one domain: Admin owns the principal, the grant, and the session. Partner owns the OAuth client. The caller is always waiting, so nothing here is a topic. The bus never carries a token, a secret, or a client assertion." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>
        <mxCell id="n5" value="gRPC  ·  login · grant · token (client waits)" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#EA580C;fillColor=#FFF7ED;strokeColor=#EA580C;" parent="1" vertex="1"><mxGeometry x="24" y="86" width="540" height="28" as="geometry" /></mxCell>
        <mxCell id="n6" value="JWKS / HTTP  ·  Kong PEP · Azure AD" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#2563EB;fillColor=#EFF6FF;strokeColor=#2563EB;" parent="1" vertex="1"><mxGeometry x="596" y="86" width="460" height="28" as="geometry" /></mxCell>
        <mxCell id="n7" value="Kafka command  ·  none · an admin is waiting" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#7C3AED;fillColor=#F5F3FF;strokeColor=#7C3AED;" parent="1" vertex="1"><mxGeometry x="1068" y="86" width="540" height="28" as="geometry" /></mxCell>
        <mxCell id="n8" value="Kafka fact  ·  none · audit stays in Postgres" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#059669;fillColor=#ECFDF5;strokeColor=#059669;" parent="1" vertex="1"><mxGeometry x="1620" y="86" width="320" height="28" as="geometry" /></mxCell>
        <mxCell id="n9" value="1. Callers" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" parent="1" vertex="1"><mxGeometry x="16" y="128" width="360" height="584" as="geometry" /></mxCell>
        <mxCell id="n10" value="2. Kafka in" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F5F3FF;strokeColor=#7C3AED;" parent="1" vertex="1"><mxGeometry x="16" y="728" width="360" height="408" as="geometry" /></mxCell>
        <mxCell id="n11" value="3. Admin &amp; Partner · Go" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FEF9C3;strokeColor=#EAB308;" parent="1" vertex="1"><mxGeometry x="440" y="128" width="780" height="1008" as="geometry" /></mxCell>
        <mxCell id="n12" value="4. Facts out" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#ECFDF5;strokeColor=#059669;" parent="1" vertex="1"><mxGeometry x="1284" y="520" width="300" height="616" as="geometry" /></mxCell>
        <mxCell id="n13" value="5. Consumers" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" parent="1" vertex="1"><mxGeometry x="1680" y="520" width="376" height="616" as="geometry" /></mxCell>
        <mxCell id="n14" value="6. Data · commit here. No fact follows" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" parent="1" vertex="1"><mxGeometry x="16" y="1240" width="500" height="350" as="geometry" /></mxCell>
        <mxCell id="n15" value="Decisions · why this, and what it costs" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" parent="1" vertex="1"><mxGeometry x="532" y="1240" width="688" height="350" as="geometry" /></mxCell>
        <mxCell id="n16" value="Not this domain" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" parent="1" vertex="1"><mxGeometry x="1284" y="1240" width="772" height="350" as="geometry" /></mxCell>
        <mxCell id="n17" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;bot · WAF · TLS&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" parent="n9" vertex="1"><mxGeometry x="40" y="44" width="304" height="52" as="geometry" /></mxCell>
        <mxCell id="n18" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n17" vertex="1"><mxGeometry x="16" y="11" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Kong · only PEP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;JWKS · the two Vault public keys&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;customer iss is rejected here&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" parent="n9" vertex="1"><mxGeometry x="40" y="112" width="304" height="68" as="geometry" /></mxCell>
        <mxCell id="n20" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n19" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n21" value="&lt;b&gt;Azure AD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;token endpoint · MFA stays here&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;only the Azure adapter calls it&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;dashPattern=6 4;" parent="n9" vertex="1"><mxGeometry x="40" y="364" width="304" height="68" as="geometry" /></mxCell>
        <mxCell id="n22" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n21" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n23" value="&lt;b&gt;admin-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;auth code + PKCE · S256&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;grant · revoke · session&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" parent="n9" vertex="1"><mxGeometry x="40" y="280" width="304" height="68" as="geometry" /></mxCell>
        <mxCell id="n24" value="&lt;b&gt;partner-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;client_credentials&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;private_key_jwt&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" parent="n9" vertex="1"><mxGeometry x="40" y="196" width="304" height="68" as="geometry" /></mxCell>
        <mxCell id="n25" value="No customer token on these routes. Identity owns that key and that world." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1D4ED8;" parent="n9" vertex="1"><mxGeometry x="40" y="448" width="304" height="56" as="geometry" /></mxCell>
        <mxCell id="n26" value="No Kafka in. Every call on this page has a person or a partner waiting for the result, so it is gRPC." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B21B6;" parent="n10" vertex="1"><mxGeometry x="40" y="44" width="304" height="64" as="geometry" /></mxCell>
        <mxCell id="n27" value="A grant, a revoke, a rotate, and a login are not commands. Publishing them would put a security event on the bus for no consumer that cannot read Postgres." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B21B6;" parent="n10" vertex="1"><mxGeometry x="40" y="120" width="304" height="80" as="geometry" /></mxCell>
        <mxCell id="n28" value="&lt;b&gt;Admin principal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;IdP subject · email · name&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;first login has no grants&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="48" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Partner client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;client_id · brand_ids · scopes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;public key only · no API key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="418" y="48" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n30" value="&lt;b&gt;Azure adapter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one provider · the port stays&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;OIDC and SAML are not shipped&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="148" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n31" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n30" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n32" value="&lt;b&gt;private_key_jwt&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;verify the assertion&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;then drop it · never store it&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="418" y="148" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n33" value="&lt;b&gt;Admin JWT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;iss=admin · ES512 · short TTL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;roles[] fixed until next token&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="248" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n34" value="&lt;b&gt;Partner JWT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;iss=partner · other ES512 key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;5 min · no refresh token&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="418" y="248" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Grant change&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;gRPC · assign · revoke · update&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;does not rewrite a live JWT&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="448" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n36" value="&lt;b&gt;Register · rotate · suspend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;gRPC · writes the client row&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;same tx as audit_log · grace on the old key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="418" y="348" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n37" value="&lt;b&gt;audit_log&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;same transaction as the write&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;the lake reads Postgres, not the bus&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFFFFF;strokeColor=#EAB308;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="548" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n38" value="&lt;b&gt;Refresh family&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;admin session · Valkey&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;reuse kills the family&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="348" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n39" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n38" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n40" value="&lt;b&gt;Vault · admin key&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;admin-es512&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;not the customer key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="16" y="648" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n41" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n40" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n42" value="&lt;b&gt;Vault · partner key&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;partner-es512&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;a different key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n11" vertex="1"><mxGeometry x="418" y="548" width="346" height="68" as="geometry" /></mxCell>
        <mxCell id="n43" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n42" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n44" value="An admin revoke kills the refresh family and bites at the next refresh. A partner suspend bites on the next token request. Either way a stolen access token can live out its 5 minutes." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" parent="n11" vertex="1"><mxGeometry x="16" y="732" width="748" height="56" as="geometry" /></mxCell>
        <mxCell id="n45" value="No facts. A login, a grant, and a token are not domain events. The audit row is the record." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#047857;" parent="n12" vertex="1"><mxGeometry x="16" y="48" width="268" height="72" as="geometry" /></mxCell>
        <mxCell id="n46" value="Nothing secret on the bus, because this domain does not publish." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#047857;" parent="n12" vertex="1"><mxGeometry x="16" y="132" width="268" height="48" as="geometry" /></mxCell>
        <mxCell id="n47" value="No consumers. Kong does not project a denylist from this domain." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" parent="n13" vertex="1"><mxGeometry x="16" y="48" width="344" height="48" as="geometry" /></mxCell>
        <mxCell id="n48" value="There is no fraud worker. A grant spike is an audit query, not a stream processor." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" parent="n13" vertex="1"><mxGeometry x="16" y="108" width="344" height="48" as="geometry" /></mxCell>
        <mxCell id="n49" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;one cluster · admin schema · partner schema&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;principal · grant · client · audit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n14" vertex="1"><mxGeometry x="16" y="44" width="468" height="68" as="geometry" /></mxCell>
        <mxCell id="n50" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n49" vertex="1"><mxGeometry x="16" y="19" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n51" value="&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;refresh family · one-time auth code&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;PKCE verifier&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n14" vertex="1"><mxGeometry x="16" y="124" width="226" height="84" as="geometry" /></mxCell>
        <mxCell id="n52" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n51" vertex="1"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n53" value="&lt;b&gt;Vault&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;admin-es512 · partner-es512&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;not the customer key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" parent="n14" vertex="1"><mxGeometry x="254" y="124" width="230" height="84" as="geometry" /></mxCell>
        <mxCell id="n54" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," parent="n53" vertex="1"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n55" value="• &lt;b&gt;Zero topics.&lt;/b&gt; The caller is waiting, and a token on the bus is a secret we would then have to redact.&lt;br&gt;• &lt;b&gt;No denylist projector.&lt;/b&gt; Access tokens live 5 minutes. Revoke kills the refresh family. Cost: a revoked session works until the access token expires.&lt;br&gt;• &lt;b&gt;No fraud worker.&lt;/b&gt; Nothing downstream acts on a score. An audit query covers the investigation.&lt;br&gt;• &lt;b&gt;Azure only.&lt;/b&gt; The adapter port stays. A provider registry table ships when a second IdP is real.&lt;br&gt;• &lt;b&gt;One Aurora, two schemas.&lt;/b&gt; Two clusters would double the ops for one domain.&lt;br&gt;• &lt;b&gt;No brand on the principal.&lt;/b&gt; The grant carries brand_id (P-30). Cost: one person can hold many brands, and the principal is not stored per brand.&lt;br&gt;• &lt;b&gt;No partner refresh.&lt;/b&gt; client_credentials asks again. The refresh family is the admin session only. Cost: a stolen partner token lives 5 minutes." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" parent="n15" vertex="1"><mxGeometry x="16" y="44" width="656" height="290" as="geometry" /></mxCell>
        <mxCell id="n56" value="&lt;b&gt;Identity&lt;/b&gt; — the customer. minor_id, social login, OTP, and the customer signing key stay there. This edge rejects that JWT.&lt;br&gt;&lt;b&gt;Catalog, Order, Payment&lt;/b&gt; — they trust the headers Kong already injected. They do not call Admin to re-check the token.&lt;br&gt;&lt;b&gt;Break-glass admin&lt;/b&gt; — seeded outside this login path.&lt;br&gt;&lt;b&gt;Kong JWKS&lt;/b&gt; — the public half of admin-es512 and partner-es512. Kong does not call Azure AD.&lt;br&gt;&lt;b&gt;O-09&lt;/b&gt; — which partners use this token, rather than partner-adapter, is still open." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" parent="n16" vertex="1"><mxGeometry x="16" y="44" width="724" height="260" as="geometry" /></mxCell>
        <mxCell id="n57" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Login, grant, revoke, rotate, and token are gRPC. Kong is the only PEP. No topic, no Ack, no token on the bus. Audit is Postgres.&lt;/font&gt;" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="532" y="1148" width="1412" height="48" as="geometry" /></mxCell>
        <mxCell id="n58" value="A customer token is rejected at Kong. Downstream reads headers only. A grant shows up on the next admin token. A partner token has no refresh; the client asks again." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="532" y="1200" width="1412" height="28" as="geometry" /></mxCell>
      <mxCell id="a500" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n9" source="n17" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a503" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n9" source="n19" target="n24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a504" value="upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n30" target="n28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a505" value="issue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n30" target="n33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a507" value="same tx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n35" target="n37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a509" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n32" target="n29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a510" value="issue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n32" target="n34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a508" value="sign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n33" target="n40"><mxGeometry relative="1" as="geometry" x="0.0"><Array as="points"><mxPoint x="818.0" y="410" /><mxPoint x="818.0" y="810" /></Array></mxGeometry></mxCell><mxCell id="a513" value="sign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n34" target="n42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842.0" y="410.0" /><mxPoint x="842.0" y="710.0" /></Array></mxGeometry></mxCell><mxCell id="data_rel" value="commit · read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0.0333;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="n59" value="No refresh token. The client sends a new assertion each time. A suspend bites on the next request, and a live token lasts at most 5 minutes." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#854D0E;" parent="n11" vertex="1"><mxGeometry x="418" y="448" width="346" height="84" as="geometry" /></mxCell><mxCell id="a530" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n19" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="32" y="274" /><mxPoint x="32" y="442" /></Array></mxGeometry></mxCell><mxCell id="a531" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="n30" target="n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="392" y="327" /><mxPoint x="392" y="526" /></Array></mxGeometry></mxCell><mxCell id="a532" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n23" target="n30"><mxGeometry relative="1" as="geometry" x="0.65"><Array as="points"><mxPoint x="408" y="442" /><mxPoint x="408" y="293" /></Array></mxGeometry></mxCell><mxCell id="a533" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n23" target="n38"><mxGeometry relative="1" as="geometry" x="0.7"><Array as="points"><mxPoint x="408" y="442" /><mxPoint x="408" y="510" /></Array></mxGeometry></mxCell><mxCell id="a534" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n23" target="n35"><mxGeometry relative="1" as="geometry" x="0.75"><Array as="points"><mxPoint x="408" y="442" /><mxPoint x="408" y="610" /></Array></mxGeometry></mxCell><mxCell id="a535" value="refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="n11" source="n33" target="n38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a536" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n24" target="n32"><mxGeometry relative="1" as="geometry" x="-0.85"><Array as="points"><mxPoint x="424" y="358" /><mxPoint x="424" y="168" /><mxPoint x="826" y="168" /><mxPoint x="826" y="310" /></Array></mxGeometry></mxCell><mxCell id="a537" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="n23" target="n36"><mxGeometry relative="1" as="geometry" x="0.7"><Array as="points"><mxPoint x="416" y="442" /><mxPoint x="416" y="460" /><mxPoint x="1031" y="460" /></Array></mxGeometry></mxCell></root>

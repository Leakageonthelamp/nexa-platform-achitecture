<mxCell id="p0-v32" parent="p0-v31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc StartLogin(StartLoginRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (StartLoginResponse);   // authorize_url&lt;br&gt;rpc CompleteLogin(CompleteLoginRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (TokenPair);&lt;br&gt;&lt;br&gt;message CompleteLoginRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string code = 1; string state = 2;&lt;br&gt;}&lt;br&gt;message TokenPair {&lt;br&gt;&amp;nbsp;&amp;nbsp;string access_token  = 1;  // admin JWT&lt;br&gt;&amp;nbsp;&amp;nbsp;string refresh_token = 2;  // opaque&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  expires_in    = 3;  // 300&lt;br&gt;}&lt;br&gt;admin JWT claims&lt;br&gt;&amp;nbsp;&amp;nbsp;iss=admin · sub=principal_id · brand_ids[]&lt;br&gt;&amp;nbsp;&amp;nbsp;roles[] · exp (5 min) · jti" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v33" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v34" parent="p0-v33" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="admin_principals&lt;br&gt;&amp;nbsp;&amp;nbsp;principal_id · idp_subject UNIQUE&lt;br&gt;&amp;nbsp;&amp;nbsp;email · name · last_login_at · version&lt;br&gt;&amp;nbsp;&amp;nbsp;no brand_id (P-30)&lt;br&gt;&lt;br&gt;admin_sessions&lt;br&gt;&amp;nbsp;&amp;nbsp;session_id · principal_id · family_id&lt;br&gt;&amp;nbsp;&amp;nbsp;created_at · revoked_at · version&lt;br&gt;&lt;br&gt;audit_log: same transaction&lt;br&gt;&lt;br&gt;Valkey&lt;br&gt;&amp;nbsp;&amp;nbsp;login:{state}  verifier · TTL 10 min&lt;br&gt;&amp;nbsp;&amp;nbsp;family:{id}    current refresh hash" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v35" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v36" parent="p0-v35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• The state and verifier are deleted on first use, so a replayed callback fails.&lt;br&gt;• Azure call: one try inside the deadline. The admin retries the login." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v37" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v38" parent="p0-v37" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Only Admin &amp;amp; Partner calls Azure AD, through a port. No other domain imports the Azure SDK.&lt;br&gt;• The admin key (admin-es512) is not the customer key.&lt;br&gt;• Kong picks the JWKS by iss and rejects a customer token on admin routes.&lt;br&gt;• No topic: a login is not a domain event. The audit row is the record.&lt;br&gt;• The principal and the session have no brand_id. The grant does (P-30)." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · Refresh and revoke" id="lld-1"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="p1-v1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Admin &amp; Partner LLD 2 — Refresh and revoke: the refresh-token family" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
<mxCell id="p1-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="Every 5 minutes admin-bff swaps the refresh token for a new pair. Using an old refresh token twice kills the whole family. Revoke deletes the family; the access token dies within 5 minutes.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

<mxCell id="p0-v25" parent="p0-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;MFA fails&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;stays in Azure&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;no callback&lt;/font&gt;" vertex="1"><mxGeometry x="544" y="172" width="216" height="84" as="geometry" /></mxCell>

<mxCell id="p4-v28" parent="p4-v27" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic brand.changed  key brand_id            compacted&lt;br&gt;&amp;nbsp;&amp;nbsp;{ brand_id, live, lifecycle, version }&lt;br&gt;topic store.changed  key brand_id:store_id   compacted&lt;br&gt;&amp;nbsp;&amp;nbsp;{ Store … status, version }   see Brand &amp;amp; Store LLD 1&lt;br&gt;&lt;br&gt;Catalog reads only&lt;br&gt;&amp;nbsp;&amp;nbsp;brand.changed : live&lt;br&gt;&amp;nbsp;&amp;nbsp;store.changed : status = hidden | closed" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>

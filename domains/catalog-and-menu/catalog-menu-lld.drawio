<mxCell id="p4-v30" parent="p4-v29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="menus&lt;br&gt;&amp;nbsp;&amp;nbsp;hidden_by_brand · hidden_by_store&lt;br&gt;&lt;br&gt;source_versions&lt;br&gt;&amp;nbsp;&amp;nbsp;source (brand | store) · id · version&lt;br&gt;&lt;br&gt;No outbox. Nothing is published." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>

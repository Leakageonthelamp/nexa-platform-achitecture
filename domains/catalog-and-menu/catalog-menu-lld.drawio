<mxCell id="p2-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="Voucher calls ListSkus only when a rule names items. The reply is ids, not a menu. Nothing is written, so there is no Ack.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

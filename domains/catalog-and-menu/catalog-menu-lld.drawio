<mxCell id="p1-v35" parent="p1-v34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic catalog.requested&lt;br&gt;&amp;nbsp;&amp;nbsp;key brand_id:store_id:sku_id   7 days&lt;br&gt;&lt;br&gt;message CatalogRequested {&lt;br&gt;&amp;nbsp;&amp;nbsp;string store_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string sku_id   = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;oneof request {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SoldOut sold_out = 10;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;BackIn  back_in  = 11;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 pos_at_unix = 3;&lt;br&gt;}&lt;br&gt;&lt;br&gt;topic catalog.availability.changed&lt;br&gt;&amp;nbsp;&amp;nbsp;key brand_id:store_id:sku_id   compacted&lt;br&gt;&amp;nbsp;&amp;nbsp;{ store_id, sku_id, available, version }" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>

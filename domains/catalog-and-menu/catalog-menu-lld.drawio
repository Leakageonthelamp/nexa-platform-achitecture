<mxCell id="p2-v33" parent="p2-v32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc ListSkus(ListSkusRequest) returns (ListSkusResponse);&lt;br&gt;&lt;br&gt;message GetMenuRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string store_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string channel  = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  menu_version = 3;  // optional: exact version&lt;br&gt;}&lt;br&gt;message GetMenuResponse {&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  menu_version = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated Category categories = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated string sold_out_sku_ids = 3;&lt;br&gt;}&lt;br&gt;&lt;br&gt;Valkey keys&lt;br&gt;&amp;nbsp;&amp;nbsp;menu:{brand}:{menu}:{version}   no TTL&lt;br&gt;&amp;nbsp;&amp;nbsp;ptr:{brand}:{menu}:{channel}&lt;br&gt;&amp;nbsp;&amp;nbsp;soldout:{brand}:{store}         set" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v34" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v35" parent="p2-v34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="Nothing in Postgres. Read only.&lt;br&gt;&lt;br&gt;Valkey on a miss&lt;br&gt;&amp;nbsp;&amp;nbsp;menu JSON by version (immutable)&lt;br&gt;&amp;nbsp;&amp;nbsp;sold-out set rebuilt from rows" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v36" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v37" parent="p2-v36" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Reads are safe to retry.&lt;br&gt;• Deadline from the BFF. Budget is O-02 (GetMenu p99).&lt;br&gt;• A version key never goes stale, so the lunch peak hits cache." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v38" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v39" parent="p2-v38" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• D-07: Voucher calls ListSkus and does not subscribe to an item topic.&lt;br&gt;• guest-bff may call only ListNearest and GetMenu.&lt;br&gt;• No OpenSearch: a store menu is under 1,000 items.&lt;br&gt;• Images are served from the Cloudflare CDN by image key." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>

<mxCell id="p3-v26" parent="p3-v25" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc PriceLines(PriceLinesRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (PriceLinesResponse);&lt;br&gt;&lt;br&gt;message PriceLinesRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string store_id = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;string channel  = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated Line lines = 3;   // sku_id · qty · modifier_ids&lt;br&gt;}&lt;br&gt;message PriceLinesResponse {&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 menu_version = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated PricedLine lines = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 total_satang = 3;&lt;br&gt;}&lt;br&gt;message PricedLine {&lt;br&gt;&amp;nbsp;&amp;nbsp;string sku_id = 1; int32 qty = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 unit_satang = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;repeated PricedModifier modifiers = 4;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 line_satang = 5;&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>

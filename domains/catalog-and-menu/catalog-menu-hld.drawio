        <mxCell id="n77" parent="n72" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=100;spacingRight=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;" value="&lt;b&gt;S3 + Cloudflare CDN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot; style=&quot;font-size:11px&quot;&gt;presigned PUT · browser to S3&lt;br&gt;Catalog stores the image key&lt;br&gt;served from the CDN&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="254" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n78" parent="n77" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="35" as="geometry" />
        </mxCell>
        <mxCell id="n79" parent="n77" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="30" width="30" x="54" y="35" as="geometry" />
        </mxCell>
        <mxCell id="n80" parent="n72" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="OpenSearch is not in this domain. A store menu is under 1,000 items." vertex="1">
          <mxGeometry height="36" width="468" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="n117" edge="1" parent="n72" source="n73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=8;" target="n75" value="project">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n118" edge="1" parent="n72" source="n73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#2563EB;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=8;" target="n77" value="image key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n81" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="772" x="1284" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="n82" parent="n81" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Brand &amp; Store&lt;/b&gt; — tenant, live?, hours, zone. Catalog keeps brand_id and store_id only&lt;br&gt;&lt;b&gt;Order&lt;/b&gt; — cart, checkout, POS ticket, the order price lines&lt;br&gt;&lt;b&gt;Payment&lt;/b&gt; — gateway keys&lt;br&gt;&lt;b&gt;Admin &amp;amp; Partner&lt;/b&gt; — Azure AD, the role, the grant. JWT roles[] is fixed until the next token&lt;br&gt;&lt;b&gt;Voucher&lt;/b&gt; — calls ListSkus over gRPC. It does not subscribe.&lt;br&gt;&lt;b&gt;Inventory&lt;/b&gt; — not built. Sold-out is a flag here until a stock count is needed&lt;br&gt;&lt;b&gt;Aggregators&lt;/b&gt; — Grab, LINE MAN, Shopee Food. The partner-adapter calls them, Catalog does not" vertex="1">
          <mxGeometry height="290" width="724" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n83" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="Decisions  ·  why this, and what it costs" vertex="1">
          <mxGeometry height="350" width="688" x="532" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="n84" parent="n83" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="• &lt;b&gt;One engine.&lt;/b&gt; Menu and product are one database. A split is a second deploy and a network hop.&lt;br&gt;• &lt;b&gt;Valkey keyed by version.&lt;/b&gt; The menu JSON never changes, so the lunch peak hits cache. Only the pointer and the sold-out set move.&lt;br&gt;• &lt;b&gt;Thin catalog.menu.published.&lt;/b&gt; A full menu can pass Kafka&#39;s 1 MB default. Consumers call GetMenu(version).&lt;br&gt;• &lt;b&gt;Two compacted facts.&lt;/b&gt; catalog.menu.published and catalog.availability.changed. No item topic. Voucher calls ListSkus.&lt;br&gt;• &lt;b&gt;Import is a worker.&lt;/b&gt; No import topic. Outbox in the app. No Debezium and no Kafka Connect." vertex="1">
          <mxGeometry height="140" width="608" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n85" parent="n83" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" value="• &lt;b&gt;Live brand and store lookup, no copy.&lt;/b&gt; Catalog stores brand_id and store_id only. Cost: create waits on Brand &amp;amp; Store and fails if it is down.&lt;br&gt;• &lt;b&gt;No OpenSearch.&lt;/b&gt; A store menu is under 1,000 items. Search can be fed from these facts later.&lt;br&gt;• &lt;b&gt;PriceLines is sync.&lt;/b&gt; One place owns price. Order stores the price lines it was given.&lt;br&gt;• &lt;b&gt;Sold-out is a flag, not a stock count.&lt;/b&gt; No Inventory service until we need one.&lt;br&gt;• &lt;b&gt;Aggregators stay behind the partner-adapter.&lt;/b&gt; Rate limits and retries stay out of Catalog.&lt;br&gt;• &lt;b&gt;Images are a presigned S3 PUT&lt;/b&gt; plus the Cloudflare CDN. No image service." vertex="1">
          <mxGeometry height="150" width="608" x="16" y="184" as="geometry" />
        </mxCell>
        <mxCell id="n91" edge="1" parent="1" source="n15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" target="n35" value="">

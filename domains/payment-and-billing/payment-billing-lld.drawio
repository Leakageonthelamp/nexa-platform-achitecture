<mxCell id="p2-v40" parent="p2-v39" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Command, so dedupe on event_id.&lt;br&gt;• The gateway worker takes the job with SKIP LOCKED. Omise capture is safe to repeat on the same charge.&lt;br&gt;• Omise 5xx: 3× with backoff, then status failed and an alert.&lt;br&gt;• The Ack waits only for the first commit. Nobody waits on Omise." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p2-v41" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p2-v42" parent="p2-v41" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• The gateway call is a worker, not a topic (§10).&lt;br&gt;• O-05 is open: what happens when capture fails after the kitchen accepted.&lt;br&gt;• An authorization hold expires at the gateway; the capture window is part of O-04.&lt;br&gt;• Statement is a mode of this app and runs after the same commit." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="4 · Refund" id="lld-3"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="p3-v1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Payment LLD 4 — Refund: admin gRPC, then the gateway worker" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
<mxCell id="p3-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="A CSC agent refunds part or all of a captured payment. The admin waits for &quot;pending&quot;, not for Omise. The gateway worker sends the refund after the commit. A wallet tender calls Wallet Refund instead of Omise.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>
<mxCell id="p3-v3" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" value="gRPC  ·  sync, the caller waits" vertex="1"><mxGeometry x="24" y="86" width="360" height="28" as="geometry" /></mxCell>

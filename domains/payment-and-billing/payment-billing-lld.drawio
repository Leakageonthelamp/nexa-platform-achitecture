<mxCell id="p2-v36" parent="p2-v35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="message Capture {&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 amount_satang = 1;  // ≤ authorized&lt;br&gt;}&lt;br&gt;message Void {&lt;br&gt;&amp;nbsp;&amp;nbsp;string reason = 1;  // pos_rejected&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// pos_timeout&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// payment_timeout&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// late_authorize&lt;br&gt;}&lt;br&gt;&lt;br&gt;gateway job (outbox row, kind = gateway)&lt;br&gt;&amp;nbsp;&amp;nbsp;transaction_id · action · attempt&lt;br&gt;&amp;nbsp;&amp;nbsp;next_at · last_error&lt;br&gt;&lt;br&gt;Omise: POST /charges/{id}/capture&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;POST /charges/{id}/reverse" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>

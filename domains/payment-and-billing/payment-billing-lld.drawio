<mxCell id="p0-e22" edge="1" parent="1" source="p0-v18" target="p0-v21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="return"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="p0-v23" parent="p0-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;key already used&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;return the first response&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;no second charge&lt;/font&gt;" vertex="1"><mxGeometry x="280" y="172" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="p0-e24" edge="1" parent="1" source="p0-v10" target="p0-v23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="p0-v25" parent="p0-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;Omise 5xx or timeout&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;attempt = failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;UNAVAILABLE to Order&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;retry same key → new attempt&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="172" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="p0-e26" edge="1" parent="1" source="p0-v15" target="p0-v25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#DC2626;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="p0-v27" parent="p0-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;shopper never finishes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;no webhook arrives&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot; style=&quot;font-size:11px&quot;&gt;Order sweeper voids&lt;/font&gt;" vertex="1"><mxGeometry x="1336" y="172" width="216" height="84" as="geometry" /></mxCell>

<mxCell id="p1-v31" parent="p1-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Outbox relay · worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay per domain&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;publishes after the commit&lt;/font&gt;" vertex="1"><mxGeometry x="1336" y="172" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="p1-e32" edge="1" parent="1" source="p1-v20" target="p1-v31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="async"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n81" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;customer-bff and Order call Quote. partner-bff calls CreateDelivery. admin-bff calls ops and rider admin. Delivery consumes order.events, delivery.requested, store.changed, and payment.events. It publishes delivery.events and payment.requested{payout}. gRPC has no Ack.&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="1514" x="430" y="1084" as="geometry" />
        </mxCell>
        <mxCell id="n82" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;" value="A replay of the same version or event_id is a no-op. A missing brand_id is INVALID_ARGUMENT. Rider rows use brand_id = mfg (P-23)." vertex="1">
          <mxGeometry height="24" width="1514" x="430" y="1136" as="geometry" />
        </mxCell>
        <mxCell id="n83" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="6. Data · commit here, then the fact" vertex="1">
          <mxGeometry height="350" width="500" x="16" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="n84" parent="n83" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;deliveries · quotes · riders&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;earnings · shifts · outbox&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;schema delivery · one role&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="468" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n85" parent="n84" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," value="" vertex="1">
          <mxGeometry height="30" width="30" x="16" y="35" as="geometry" />
        </mxCell>
        <mxCell id="n86" parent="n83" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="Valkey is not the delivery. S3 holds rider documents, the shift file, and exports. Vault holds provider secrets. Amounts are integer satang." vertex="1">
          <mxGeometry height="56" width="468" x="16" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n87" parent="n83" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="ponytail: no allocation engine of our own. ZEEK allocates the rider. Ceiling: dispatch quality is the provider&#39;s. Upgrade: our own rider app, added as one more FleetProvider." vertex="1">
          <mxGeometry height="64" width="468" x="16" y="230" as="geometry" />
        </mxCell>
        <mxCell id="n88" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="Decisions · why this, and what it costs" vertex="1">
          <mxGeometry height="350" width="640" x="532" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="n89" parent="n88" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• &lt;b&gt;P-18 one port.&lt;/b&gt; A ZEEK account is config. Cost: two small places know the provider.&lt;br&gt;• &lt;b&gt;P-19 ordered list.&lt;/b&gt; Next provider on create-fail or timeout. Cost: no time-of-day schedule.&lt;br&gt;• &lt;b&gt;P-20 seven states.&lt;/b&gt; Rank guard. Cost: sub-steps live on the status log.&lt;br&gt;• &lt;b&gt;P-22 Quote.&lt;/b&gt; Order calls GetQuote. Cost: a fourth sync hop for Order.&lt;br&gt;• &lt;b&gt;P-23 riders are mfg.&lt;/b&gt; Exception to one brand per row. Cost: written down here.&lt;br&gt;• &lt;b&gt;P-25 pay on delivered.&lt;/b&gt; One payout per trip. Cost: it waits on Payment.&lt;br&gt;• &lt;b&gt;P-28 no Zendesk.&lt;/b&gt; A claim is an adjust. Cost: CSC types the ticket id.&lt;br&gt;• &lt;b&gt;P-29 quote stays local.&lt;/b&gt; Cost: ETA firms up at rider_assigned." vertex="1">
          <mxGeometry height="290" width="608" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n90" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="756" x="1188" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="n91" parent="n90" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="&lt;b&gt;Order&lt;/b&gt; — the order, and the moment it is accepted. Dispatch starts there.&lt;br&gt;&lt;b&gt;Brand and Store&lt;/b&gt; — the zone and the store. Delivery does not copy it.&lt;br&gt;&lt;b&gt;Identity&lt;/b&gt; — the address and the phone, read at dispatch.&lt;br&gt;&lt;b&gt;Payment&lt;/b&gt; — TrueMoney, the payout, and the FAAS invoice.&lt;br&gt;&lt;b&gt;Notification&lt;/b&gt; — the shopper message. It reads delivery.events.&lt;br&gt;&lt;b&gt;partner-adapter&lt;/b&gt; — the signature and the provider mapping.&lt;br&gt;No in-house rider app, no fleet-priority service, and no report app on this database." vertex="1">
          <mxGeometry height="250" width="724" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n92" edge="1" parent="1" source="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0;" target="n27" value="gRPC">

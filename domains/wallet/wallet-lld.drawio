<mxCell id="p5-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="customer-bff reads the caller&#x27;s own wallet. admin-bff may pass any customer_id. Nothing is written.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

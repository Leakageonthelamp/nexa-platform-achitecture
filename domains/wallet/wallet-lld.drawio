<mxCell id="p5-v17" parent="p5-v16" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc GetWallet(GetWalletRequest) returns (Wallet);&lt;br&gt;rpc ListEntries(ListEntriesRequest)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;returns (ListEntriesResponse);&lt;br&gt;&lt;br&gt;message GetWalletRequest { string customer_id = 1; }&lt;br&gt;message Wallet {&lt;br&gt;&amp;nbsp;&amp;nbsp;bool  exists           = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 balance_amount   = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 held_amount      = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 available_amount = 4; // derived&lt;br&gt;}&lt;br&gt;message ListEntriesRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string customer_id    = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  after_entry_id = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int32  page_size      = 3;&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p5-v18" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p5-v19" parent="p5-v18" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="no writes&lt;br&gt;&lt;br&gt;read&lt;br&gt;&amp;nbsp;&amp;nbsp;wallets by (brand_id, customer_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;wallet_entries&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;where wallet_id = ?&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and entry_id &amp;gt; after_entry_id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;order by entry_id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;limit page_size" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p5-v20" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p5-v21" parent="p5-v20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• A read. No idempotency key.&lt;br&gt;• Keyset on entry_id, so a page does not drift when a credit arrives.&lt;br&gt;• No Kafka, so no Ack." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p5-v22" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p5-v23" parent="p5-v22" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• available = balance - held. It is computed, not stored.&lt;br&gt;• A missing wallet returns exists = false and zeros. It never inserts a row.&lt;br&gt;• customer-bff: customer_id must equal x-principal-id.&lt;br&gt;• No contact data in the response (D-05)." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="7 · Reconciliation cron" id="lld-6"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="p6-v1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontFamily=Arial;fontStyle=1;" value="Wallet LLD 7 — Reconciliation: entries must match the balance, then purge the outbox" vertex="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell>
<mxCell id="p6-v2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#64748B;fontFamily=Arial;" value="Daily at 03:00. Check every wallet, flag holds open too long, and delete outbox rows published more than 7 days ago. Nothing is repaired.  Draft LLD: field names and status values are to be aligned with the business." vertex="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell>

<mxCell id="p4-v26" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields (draft)" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry" /></mxCell>
<mxCell id="p4-v27" parent="p4-v26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc Refund(RefundRequest) returns (RefundResponse);&lt;br&gt;&lt;br&gt;message RefundRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string idempotency_key = 1; // refund_id&lt;br&gt;&amp;nbsp;&amp;nbsp;string transaction_id  = 2; // the spend&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  amount   = 3; // partial allowed&lt;br&gt;}&lt;br&gt;message RefundResponse {&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 entry_id       = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64 balance_amount = 2;&lt;br&gt;}&lt;br&gt;// A top-up is not refunded here (P-17)." vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p4-v28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p4-v29" parent="p4-v28" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="wallet_entries&lt;br&gt;&amp;nbsp;&amp;nbsp;kind = refund · direction = credit&lt;br&gt;&amp;nbsp;&amp;nbsp;source = payment&lt;br&gt;&amp;nbsp;&amp;nbsp;source_ref = refund_id&lt;br&gt;&lt;br&gt;wallets&lt;br&gt;&amp;nbsp;&amp;nbsp;balance += amount · version + 1&lt;br&gt;&lt;br&gt;outbox  template wallet.refunded" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p4-v30" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p4-v31" parent="p4-v30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• UNIQUE(brand_id, source, source_ref) on refund_id. A repeat returns the first credit (P-01).&lt;br&gt;• Sum of refund entries for that transaction_id cannot exceed its spend entry.&lt;br&gt;• No Ack. Payment publishes payment.events{refunded} from its own outbox." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p4-v32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p4-v33" parent="p4-v32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• D-09: Payment owns the refund. Wallet only moves stored value.&lt;br&gt;• D-10: refunding a card top-up is Payment&#x27;s job and does not touch this ledger (P-17).&lt;br&gt;• Partial refunds are allowed, same as a card refund." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="6 · GetWallet and ListEntries" id="lld-5"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />

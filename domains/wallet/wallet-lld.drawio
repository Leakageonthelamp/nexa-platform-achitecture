<mxCell id="p0-v21" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Contract  ·  fields (draft)" vertex="1"><mxGeometry x="16" y="544" width="600" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v22" parent="p0-v21" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc Hold(HoldRequest) returns (HoldResponse);&lt;br&gt;// metadata: x-brand-id, x-principal-id, traceparent&lt;br&gt;&lt;br&gt;message HoldRequest {&lt;br&gt;&amp;nbsp;&amp;nbsp;string idempotency_key = 1; // transaction_id&lt;br&gt;&amp;nbsp;&amp;nbsp;string customer_id     = 2;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  amount   = 3;&lt;br&gt;&amp;nbsp;&amp;nbsp;string currency        = 4; // THB&lt;br&gt;&amp;nbsp;&amp;nbsp;string purpose         = 5; // order|voucher|&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// membercard|coupon&lt;br&gt;&amp;nbsp;&amp;nbsp;string reference_id    = 6;&lt;br&gt;}&lt;br&gt;message HoldResponse {&lt;br&gt;&amp;nbsp;&amp;nbsp;string hold_id          = 1;&lt;br&gt;&amp;nbsp;&amp;nbsp;int64  available_amount = 2;&lt;br&gt;}" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v23" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v24" parent="p0-v23" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="holds&lt;br&gt;&amp;nbsp;&amp;nbsp;hold_id · brand_id · wallet_id&lt;br&gt;&amp;nbsp;&amp;nbsp;transaction_id · purpose · reference_id&lt;br&gt;&amp;nbsp;&amp;nbsp;amount · status = held&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE(brand_id, transaction_id)&lt;br&gt;&lt;br&gt;wallets&lt;br&gt;&amp;nbsp;&amp;nbsp;held_amount += amount · version + 1&lt;br&gt;&amp;nbsp;&amp;nbsp;no row → refuse, do not insert&lt;br&gt;&lt;br&gt;wallet_entries: nothing&lt;br&gt;outbox: nothing" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v25" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v26" parent="p0-v25" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• UNIQUE(brand_id, transaction_id). A repeat returns the stored hold.&lt;br&gt;• SELECT … FOR UPDATE on the wallet, then version + 1.&lt;br&gt;• Deadline is whatever Payment has left. Wallet does not reset it (P-02).&lt;br&gt;• No Kafka on this path, so no Ack." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p0-v27" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p0-v28" parent="p0-v27" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• D-09: Payment is the only caller. Order, Voucher, and MemberCard do not call Wallet.&lt;br&gt;• P-16: one tender. A short balance is FAILED_PRECONDITION, never a partial hold.&lt;br&gt;• P-14: no hold timer. Payment&#x27;s capture or void closes it; Order&#x27;s sweeper drives the void (P-10).&lt;br&gt;• A missing wallet is a zero balance. The row is created on the first credit." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · Capture and release" id="lld-1"><mxGraphModel dx="1980" dy="960" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />

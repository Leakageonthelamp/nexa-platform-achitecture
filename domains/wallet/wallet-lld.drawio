<mxCell id="p6-v18" parent="p6-v17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="schedule           0 3 * * *&lt;br&gt;timezone           Asia/Bangkok&lt;br&gt;concurrencyPolicy  Forbid&lt;br&gt;&lt;br&gt;per wallet&lt;br&gt;&amp;nbsp;&amp;nbsp;balance_amount = sum(credit) - sum(debit)&lt;br&gt;&amp;nbsp;&amp;nbsp;held_amount    = sum(holds where status = held)&lt;br&gt;&lt;br&gt;flag&lt;br&gt;&amp;nbsp;&amp;nbsp;holds where status = held&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and created_at &amp;lt; now() - 24h&lt;br&gt;&lt;br&gt;outbox&lt;br&gt;&amp;nbsp;&amp;nbsp;delete where published_at &amp;lt; now() - 7d" vertex="1"><mxGeometry x="16" y="44" width="568" height="344" as="geometry" /></mxCell>
<mxCell id="p6-v19" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1"><mxGeometry x="632" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p6-v20" parent="p6-v19" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="no balance writes&lt;br&gt;&lt;br&gt;on a mismatch or an old hold&lt;br&gt;&amp;nbsp;&amp;nbsp;log error · metric&lt;br&gt;&amp;nbsp;&amp;nbsp;wallet_id · brand_id · hold_id&lt;br&gt;&amp;nbsp;&amp;nbsp;no contact data&lt;br&gt;&lt;br&gt;outbox&lt;br&gt;&amp;nbsp;&amp;nbsp;delete published rows&lt;br&gt;&amp;nbsp;&amp;nbsp;older than 7 days (P-05)" vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p6-v21" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1"><mxGeometry x="1058" y="544" width="410" height="400" as="geometry" /></mxCell>
<mxCell id="p6-v22" parent="p6-v21" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• A read-only check plus a delete of rows already published. Safe to run twice (P-07).&lt;br&gt;• A mismatch never writes a correcting entry. CSC follows the runbook.&lt;br&gt;• No Kafka, so no Ack." vertex="1"><mxGeometry x="16" y="44" width="378" height="344" as="geometry" /></mxCell>
<mxCell id="p6-v23" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1"><mxGeometry x="1484" y="544" width="460" height="400" as="geometry" /></mxCell>
<mxCell id="p6-v24" parent="p6-v23" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• P-14: this is the only place an old hold is noticed. CSC asks Payment to void it.&lt;br&gt;• ponytail: one entries table, not double-entry. Upgrade when finance asks (D-10).&lt;br&gt;• P-05: the relay&#x27;s published rows are purged after 7 days.&lt;br&gt;• Retention of the entries themselves is O-07." vertex="1"><mxGeometry x="16" y="44" width="428" height="344" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>

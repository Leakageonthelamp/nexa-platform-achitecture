<mxCell id="p4-v21" parent="p4-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Outbox relay · worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay per domain&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;publishes after the commit&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="172" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="p4-e22" edge="1" parent="1" source="p4-v14" target="p4-v21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="async"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="p4-v23" parent="p4-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;" value="&lt;b&gt;notification.requested&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:11px&quot;&gt;send&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:11px&quot;&gt;template wallet.refunded&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:11px&quot;&gt;customer_id only&lt;/font&gt;" vertex="1"><mxGeometry x="808" y="296" width="216" height="84" as="geometry" /></mxCell>
<mxCell id="p4-v24" parent="p4-v23" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell>

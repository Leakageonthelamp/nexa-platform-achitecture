<mxCell id="p4-v17" parent="p4-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;" value="&lt;b&gt;5 · result back&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;entry_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;to Payment&lt;/font&gt;" vertex="1"><mxGeometry x="1072" y="48" width="216" height="84" as="geometry" /></mxCell>

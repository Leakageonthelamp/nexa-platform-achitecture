lEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-148" parent="1" edge="1" source="v2-129" target="v2-145" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-149" parent="1" edge="1" source="v2-144" target="v2-25" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3580" y="116"/><mxPoint x="585" y="116"/><mxPoint x="585" y="628"/></Array></mxGeometry></mxCell><mxCell id="v2-150" parent="1" vertex="1" value='&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order_raw · audit only&lt;br&gt;TTL 180 d · best-effort&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="2100" y="1205" width="210" height="95" as="geometry"/></mxCell><mxCell id="v2-151" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="2116" y="1237.5" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-152" parent="1" vertex="1" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order schema&lt;br&gt;orders · subs · history · outbox&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="2340" y="1205" width="175" height="95" as="geometry"/></mxCell><mxCell id="v2-153" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="2356" y="1237.5" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-154" parent="1" edge="1" source="v2-89" target="v2-150" value="W raw · outside TX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1880" y="545"/><mxPoint x="1880" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v2-155" parent="1" edge="1" source="v2-92" target="v2-152" value="W tx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2522" y="545"/><mxPoint x="2522" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v2-156" parent="1" edge="1" source="v2-94" target="v2-152" value="R outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=1 3;strokeColor=#3949ab;strokeWidth=2;fontColor=#1a237e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-157" parent="1" vertex="1" value='&lt;b&gt;What changed vs v1 (page 1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;partner-bff is the single ingress&lt;/b&gt; for every partner webhook: Grab / LINE MAN orders and status, BSL / SDM webhooks. It only verifies, routes and writes raw to Kafka.&lt;br&gt;2. &lt;b&gt;Many topics, delay tiers and retry tiers → 4 topics + one DLQ per consumer:&lt;/b&gt; fa.raw.v1, pos.raw.v1, oms.inbound.v1, order.events.v1.&lt;br&gt;3. &lt;b&gt;Order create and status for one order share one topic and key (order ref_id).&lt;/b&gt; A cancel is never handled before its create. "Park early status" goes away.&lt;br&gt;4. &lt;b&gt;Delayed create lives in fa-channel-adapter (fa_hold table + release job), not in delay topics.&lt;/b&gt; A cancel inside the window marks the hold CANCELLED, so the order never reaches OMS or POS. Delay topics cannot do this because a message on a topic cannot be removed.&lt;br&gt;5. &lt;b&gt;aggregator-adapter → fa-channel-adapter.&lt;/b&gt; One per channel. A new channel = new adapter publishing the same oms.inbound.v1 contract.&lt;br&gt;6. &lt;b&gt;Status mapping lives only in OMS&lt;/b&gt; (status_mappings). Adapters pass raw status as-is, so a new vendor code is a DB row, not a deploy.&lt;br&gt;7. &lt;b&gt;No retry topics.&lt;/b&gt; Transient errors retry in place (keeps order). POS submit retry is DB-driven (next_attempt_at).&lt;br&gt;8. &lt;b&gt;PostgreSQL is the only decision store in OMS.&lt;/b&gt; One TX writes order + history + outbox. Mongo raw log is audit only, outside the TX.&lt;br&gt;9. store-registry (phase 2) and admin-bff are unchanged and left on page 1.' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="20" y="1400" width="1800" height="330" as="geometry"/></mxCell><mxCell id="v2-158" parent="1" vertex="1" value="&lt;b&gt;oms.inbound.v1 contract&lt;/b&gt; (every channel adapter and pos-gateway)&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;type: OrderPlaced | ChannelStatusChanged | PosStatusChanged,&lt;br&gt;&amp;nbsp;&amp;nbsp;source: GRAB | LINEMAN | BSL | SDM,&lt;br&gt;&amp;nbsp;&amp;nbsp;ref_id: &quot;grab_{merchant_id}_{order_id}&quot;,  // Kafka key&lt;br&gt;&amp;nbsp;&amp;nbsp;sub_ref: &quot;{ref_id}#{seq}&quot; | null,  // POS events only&lt;br&gt;&amp;nbsp;&amp;nbsp;event_id, occurred_at, raw_status?,&lt;br&gt;&amp;nbsp;&amp;nbsp;data: StandardOrder | null&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;fa_hold&lt;/b&gt; row: ref_id (PK) · brand_id · store_id · state HELD | RELEASED | CANCELLED · fire_at · payload (StandardOrder) · created_at · released_at · cancelled_at.&lt;br&gt;Partial index on (fire_at) WHERE state = 'HELD'. Purge rows older than 7 d." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1850" y="1400" width="1840" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram>

  <diagram name="v3 · OMS hold" id="v3-oms-hold"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v3-1" parent="1" vertex="1" value="Aggregator Order Flow — v3 · single ingress (partner-bff) · hold and cancel as an OMS feature for every channel · pilot: The Coffee Club (Grab · LINE MAN)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#212121;"><mxGeometry x="20" y="10" width="3000" height="44" as="geometry"/></mxCell><mxCell id="v3-2" parent="1" vertex="1" value="🛵 External platform / POS" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="20" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-3" parent="1" vertex="1" value="🌐 HTTP endpoint" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="216" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-4" parent="1" vertex="1" value="📥 Kafka consumer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontColor=#3d1150;"><mxGeometry x="412" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-5" parent="1" vertex="1" value="⚙️ Business logic" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="608" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-6" parent="1" vertex="1" value="🧠 Domain core" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#f9a825;fontColor=#4d3800;"><mxGeometry x="804" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-7" parent="1" vertex="1" value="📤 Producer / client" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="1000" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-8" parent="1" vertex="1" value="📨 Kafka topic" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="1196" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-9" parent="1" vertex="1" value="🗄️ Database" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="1392" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-10" parent="1" vertex="1" value="⏱ Scheduled job" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#560027;"><mxGeometry x="1588" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-11" parent="1" vertex="1" value="🚨 DLQ" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;fillColor=#ffebee;strokeColor=#c62828;fontColor=#5d0000;"><mxGeometry x="1784" y="64" width="186" height="32" as="geometry"/></mxCell><mxCell id="v3-12" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="1980" y="63" width="80" height="34" as="geometry"/></mxCell><mxCell id="v3-13" parent="1" vertex="1" value='━━ sync call   ┅┅ async event   &lt;font color="#3949ab"&gt;data: ━▶ write  ┈▷ read  ◀━▶ read + write&lt;/font&gt;   ①–⑪ steps' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#424242;"><mxGeometry x="2076" y="64" width="560" height="32" as="geometry"/></mxCell><mxCell id="v3-14" parent="1" vertex="1" value="External" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="20" y="130" width="220" height="1010" as="geometry"/></mxCell><mxCell id="v3-15" parent="1" vertex="1" value="&lt;b&gt;Grab&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="36" y="200" width="188" height="56" as="geometry"/></mxCell><mxCell id="v3-16" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="52" y="213.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-17" parent="1" vertex="1" value="&lt;b&gt;LINE MAN&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="36" y="270" width="188" height="56" as="geometry"/></mxCell><mxCell id="v3-18" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="52" y="283.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-19" parent="1" vertex="1" value='&lt;b&gt;🏚 Old flow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;legacy webhook API → RabbitMQ → agg-consumer&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="36" y="380" width="188" height="70" as="geometry"/></mxCell><mxCell id="v3-20" parent="1" vertex="1" value="partner-bff · Node.js / Elysia · single ingress · stateless" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="270" y="130" width="300" height="1010" as="geometry"/></mxCell><mxCell id="v3-21" parent="1" vertex="1" value='&lt;b&gt;🌐 POST /fa/{platform}/…&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;orders · order-state (status, cancel)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="290" y="200" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-22" parent="1" vertex="1" value='&lt;b&gt;⚙️ Verify signature · route&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;store flag NEW / LEGACY · cache 60 s&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="290" y="290" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-23" parent="1" vertex="1" value='&lt;b&gt;📤 Legacy forwarder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;proxy request as-is&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="380" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-24" parent="1" vertex="1" value='&lt;b&gt;📤 Produce FA raw&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;key = ref_id · 200 only after Kafka ack&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="470" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-25" parent="1" vertex="1" value='&lt;b&gt;🌐 POST /webhooks/pos/{pos}&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;BSL · SDM&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="290" y="600" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-26" parent="1" vertex="1" value="&lt;b&gt;⚙️ Verify HMAC&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="290" y="690" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-27" parent="1" vertex="1" value='&lt;b&gt;📤 Produce POS raw&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;key = order ref_id (strip #seq)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="780" width="260" height="56" as="geometry"/></mxCell><mxCell id="v3-28" parent="1" vertex="1" value="&lt;b&gt;Ingress rule&lt;/b&gt;&lt;br&gt;Every partner webhook lands here. It only verifies, routes and writes the raw body to Kafka. No business logic.&lt;br&gt;&lt;br&gt;Kafka down → reply 5xx so the partner retries. Never reply 200 before the Kafka ack." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="290" y="880" width="260" height="140" as="geometry"/></mxCell><mxCell id="v3-29" parent="1" edge="1" source="v3-15" target="v3-21" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-30" parent="1" edge="1" source="v3-17" target="v3-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="252" y="298"/><mxPoint x="252" y="239"/></Array></mxGeometry></mxCell><mxCell id="v3-31" parent="1" edge="1" source="v3-21" target="v3-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-32" parent="1" edge="1" source="v3-22" target="v3-23" value="LEGACY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-33" parent="1" edge="1" source="v3-23" target="v3-19" value="as-is" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="408"/><mxPoint x="260" y="415"/></Array></mxGeometry></mxCell><mxCell id="v3-34" parent="1" edge="1" source="v3-22" target="v3-24" value="NEW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="318"/><mxPoint x="560" y="498"/></Array></mxGeometry></mxCell><mxCell id="v3-35" parent="1" edge="1" source="v3-25" target="v3-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-36" parent="1" edge="1" source="v3-26" target="v3-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-37" parent="1" vertex="1" value="Kafka · raw · key = order ref_id" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="600" y="130" width="230" height="1010" as="geometry"/></mxCell><mxCell id="v3-38" parent="1" vertex="1" value='&lt;b&gt;📨 fa.raw.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order + status · same key&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="610" y="470" width="210" height="56" as="geometry"/></mxCell><mxCell id="v3-39" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="626" y="483.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-40" parent="1" vertex="1" value='&lt;b&gt;📨 pos.raw.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;POS webhooks&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="610" y="780" width="210" height="56" as="geometry"/></mxCell><mxCell id="v3-41" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="626" y="793.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-42" parent="1" edge="1" source="v3-24" target="v3-38" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-43" parent="1" edge="1" source="v3-27" target="v3-40" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-44" parent="1" vertex="1" value="fa-channel-adapter · Node.js · stateless · normalize only" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="860" y="130" width="560" height="1010" as="geometry"/></mxCell><mxCell id="v3-45" parent="1" vertex="1" value="&lt;b&gt;📥 fa.raw.v1 consumer&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontColor=#3d1150;"><mxGeometry x="880" y="200" width="250" height="56" as="geometry"/></mxCell><mxCell id="v3-46" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="896" y="213.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-47" parent="1" vertex="1" value='&lt;b&gt;⚙️ Derive keys · dedup&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ref_id · event_id&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="290" width="250" height="56" as="geometry"/></mxCell><mxCell id="v3-48" parent="1" vertex="1" value='&lt;b&gt;🧩 Map platform → standard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Grab · LINE MAN mappers · raw status as-is&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="380" width="250" height="56" as="geometry"/></mxCell><mxCell id="v3-49" parent="1" vertex="1" value='&lt;b&gt;⚙️ Enrich order&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Minor store · menu&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="470" width="250" height="56" as="geometry"/></mxCell><mxCell id="v3-50" parent="1" vertex="1" value='&lt;b&gt;📤 Publish OrderPlaced&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;→ oms.inbound.v1 · no hold here&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="880" y="560" width="250" height="56" as="geometry"/></mxCell><mxCell id="v3-51" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="965" y="650" width="80" height="34" as="geometry"/></mxCell><mxCell id="v3-52" parent="1" vertex="1" value='&lt;b&gt;📤 Publish ChannelStatusChanged&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;status · cancel · raw as-is&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="1180" y="380" width="220" height="56" as="geometry"/></mxCell><mxCell id="v3-53" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="1250" y="470" width="80" height="34" as="geometry"/></mxCell><mxCell id="v3-54" parent="1" vertex="1" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;• Transient (legacy API, Kafka): retry in place with backoff. The partition pauses, so order is kept.&lt;br&gt;• Unknown store / menu / bad payload: → fa.raw.dlq + alert. Replay from admin.&lt;br&gt;• No database, no hold, no timers. Hold and cancel-before-POS are an OMS feature for every channel." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="880" y="760" width="520" height="150" as="geometry"/></mxCell><mxCell id="v3-55" parent="1" edge="1" source="v3-38" target="v3-45" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="498"/><mxPoint x="845" y="228"/></Array></mxGeometry></mxCell><mxCel
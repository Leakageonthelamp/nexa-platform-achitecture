font-size:10px"&gt;candidate&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="3345" y="590" width="190" height="56" as="geometry"/></mxCell><mxCell id="v3-133" parent="1" vertex="1" value='&lt;b&gt;🧾 SDM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;candidate&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#f5f5f5;strokeColor=#757575;fontColor=#212121;"><mxGeometry x="3345" y="660" width="190" height="56" as="geometry"/></mxCell><mxCell id="v3-134" parent="1" vertex="1" value="BSL vs SDM still open. Both sit behind the same POS port.&lt;br&gt;&lt;br&gt;New POS = new adapter. OMS and topics do not change." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="3345" y="740" width="190" height="120" as="geometry"/></mxCell><mxCell id="v3-135" parent="1" edge="1" source="v3-116" target="v3-132" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-136" parent="1" edge="1" source="v3-117" target="v3-133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-137" parent="1" edge="1" source="v3-132" target="v3-25" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3440" y="116"/><mxPoint x="585" y="116"/><mxPoint x="585" y="628"/></Array></mxGeometry></mxCell><mxCell id="v3-138" parent="1" vertex="1" value='&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order_raw · audit only&lt;br&gt;TTL 180 d · best-effort&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="1960" y="1205" width="210" height="95" as="geometry"/></mxCell><mxCell id="v3-139" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1976" y="1237.5" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-140" parent="1" vertex="1" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order schema&lt;br&gt;orders · subs · history&lt;br&gt;outbox · hold_policies&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="2200" y="1205" width="175" height="95" as="geometry"/></mxCell><mxCell id="v3-141" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="2216" y="1237.5" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-142" parent="1" edge="1" source="v3-77" target="v3-138" value="W raw · outside TX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="545"/><mxPoint x="1740" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v3-143" parent="1" edge="1" source="v3-80" target="v3-140" value="W tx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2382" y="545"/><mxPoint x="2382" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v3-144" parent="1" edge="1" source="v3-82" target="v3-140" value="R outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=1 3;strokeColor=#3949ab;strokeWidth=2;fontColor=#1a237e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-145" parent="1" vertex="1" value="&lt;b&gt;v3 vs v2&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Hold moved from fa-channel-adapter into OMS.&lt;/b&gt; The adapter is stateless again: no fa_hold table, no release job.&lt;br&gt;2. &lt;b&gt;Hold and cancel-before-POS is now an OMS feature for every channel.&lt;/b&gt; A new channel gets it by publishing OrderPlaced. Config is one row in hold_policies.&lt;br&gt;3. &lt;b&gt;New status HELD (rank 5).&lt;/b&gt; Held orders are visible in admin and reports. A cancel in the window ends as CANCELLED with reason HELD_CANCELLED. POS never sees it.&lt;br&gt;4. &lt;b&gt;Release is safer than v2.&lt;/b&gt; HELD → RECEIVED and the FulfillmentRequested outbox row commit in one PG TX. There is no publish-then-mark gap.&lt;br&gt;5. &lt;b&gt;The due poller does all timed work&lt;/b&gt;: hold release, POS submit retry, stuck orders. One job, one place to monitor.&lt;br&gt;6. &lt;b&gt;Brand delay source resolved:&lt;/b&gt; OMS owns hold_policies, edited through the Admin API.&lt;br&gt;&lt;br&gt;&lt;b&gt;Unchanged from v2:&lt;/b&gt; partner-bff single ingress · 4 topics + DLQ · one key (order ref_id) per order · status mapping only in OMS · outbox · no retry or delay topics." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="20" y="1400" width="1740" height="300" as="geometry"/></mxCell><mxCell id="v3-146" parent="1" vertex="1" value="&lt;b&gt;OMS schema additions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;order_statuses += ('HELD', rank 5, is_terminal false)&lt;br&gt;orders += release_at timestamptz NULL  -- set only while HELD&lt;br&gt;INDEX orders (release_at) WHERE status = 'HELD'&lt;br&gt;&lt;br&gt;hold_policies (&lt;br&gt;&amp;nbsp;&amp;nbsp;channel text,  brand_id text NULL,  -- NULL brand = channel default&lt;br&gt;&amp;nbsp;&amp;nbsp;delay_sec int NOT NULL,  is_active bool,  updated_by, updated_at,&lt;br&gt;&amp;nbsp;&amp;nbsp;UNIQUE (channel, brand_id) )&lt;/font&gt;&lt;br&gt;&lt;br&gt;Lookup: (channel, brand) → (channel, NULL) → 0 s. The policy is read at create time and copied into release_at, so a policy edit never moves orders already held." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1790" y="1400" width="1760" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram>

</mxfile>

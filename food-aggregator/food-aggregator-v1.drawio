status / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-62" parent="1" edge="1" source="v3-52" target="v3-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-63" parent="1" vertex="1" value="Data stores · only OMS owns order data · bff, adapters and gateway are stateless" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="20" y="1170" width="3530" height="200" as="geometry"/></mxCell><mxCell id="v3-64" parent="1" vertex="1" value='&lt;b&gt;⚙️ mfg-agg-service (legacy)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GET /v1/stores · menu map&lt;br&gt;callers: partner-bff (flag) · fa-adapter (enrich)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="370" y="1220" width="250" height="72" as="geometry"/></mxCell><mxCell id="v3-65" parent="1" vertex="1" value='&lt;b&gt;🐬 Aggregator DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;MariaDB · legacy, shared&lt;br&gt;sites · routing · menu&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="660" y="1205" width="150" height="95" as="geometry"/></mxCell><mxCell id="v3-66" parent="1" edge="1" source="v3-64" target="v3-65" value="R" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=1 3;strokeColor=#3949ab;strokeWidth=2;fontColor=#1a237e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-67" parent="1" edge="1" source="v3-22" target="v3-64" value="store flag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="318"/><mxPoint x="280" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v3-68" parent="1" edge="1" source="v3-49" target="v3-64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="868" y="498"/><mxPoint x="868" y="1150"/><mxPoint x="500" y="1150"/></Array></mxGeometry></mxCell><mxCell id="v3-69" parent="1" vertex="1" value="Kafka · key = order ref_id" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="1450" y="130" width="250" height="1010" as="geometry"/></mxCell><mxCell id="v3-70" parent="1" vertex="1" value='&lt;b&gt;📨 oms.inbound.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;OrderPlaced&lt;br&gt;ChannelStatusChanged&lt;br&gt;PosStatusChanged&lt;br&gt;one topic → per-order ordering&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="1460" y="470" width="230" height="150" as="geometry"/></mxCell><mxCell id="v3-71" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1476" y="530.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-72" parent="1" vertex="1" value='&lt;b&gt;🚨 *.dlq&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one per consumer group&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffebee;strokeColor=#c62828;fontColor=#5d0000;"><mxGeometry x="1460" y="960" width="230" height="56" as="geometry"/></mxCell><mxCell id="v3-73" parent="1" edge="1" source="v3-52" target="v3-70" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-74" parent="1" edge="1" source="v3-50" target="v3-70" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-75" parent="1" vertex="1" value="order-service (OMS) · Go hexagonal · source of truth · state machine" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="1730" y="130" width="660" height="1010" as="geometry"/></mxCell><mxCell id="v3-76" parent="1" vertex="1" value="&lt;b&gt;State machine&lt;/b&gt; (one status column, rank only moves forward)&lt;br&gt;&lt;b&gt;HELD&lt;/b&gt; (rank 5) → RECEIVED → CONFIRMED → PREPARING → READY → OUT_FOR_DELIVERY → DELIVERED → COMPLETED&lt;br&gt;Terminal: CANCELLED · REJECTED · FAILED. Raw status → normalized via &lt;b&gt;status_mappings&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hold feature · every channel&lt;/b&gt;&lt;br&gt;• Create: look up &lt;b&gt;hold_policies&lt;/b&gt; (channel, brand). delay &amp;gt; 0 → status HELD, release_at = placed_at + delay. No event to POS yet.&lt;br&gt;• Cancel while HELD → CANCELLED, reason HELD_CANCELLED. No CancellationRequested, because POS never had it.&lt;br&gt;• Release (due poller): HELD → RECEIVED + FulfillmentRequested in one TX.&lt;br&gt;• Release and cancel both update WHERE status = 'HELD', so exactly one wins." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1750" y="160" width="620" height="260" as="geometry"/></mxCell><mxCell id="v3-77" parent="1" vertex="1" value="&lt;b&gt;📥 oms.inbound.v1 consumer&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontColor=#3d1150;"><mxGeometry x="1750" y="517" width="190" height="56" as="geometry"/></mxCell><mxCell id="v3-78" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1766" y="530.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-79" parent="1" vertex="1" value="🧠 &lt;b&gt;Order Core&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create order · idempotent on ref_id&lt;br&gt;Hold policy → HELD + release_at&lt;br&gt;Map raw status&lt;br&gt;Apply transition · rank forward&lt;br&gt;Cancel while HELD → no POS call&lt;br&gt;Route store → POS&lt;br&gt;Request fulfillment / cancel" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=24;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#fff2cc;strokeColor=#f9a825;fontColor=#4d3800;"><mxGeometry x="1975" y="435" width="210" height="220" as="geometry"/></mxCell><mxCell id="v3-80" parent="1" vertex="1" value='&lt;b&gt;📤 Order repo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one PG TX: order · subs · history · outbox&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="2220" y="517" width="150" height="56" as="geometry"/></mxCell><mxCell id="v3-81" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="2255" y="435" width="80" height="34" as="geometry"/></mxCell><mxCell id="v3-82" parent="1" vertex="1" value='&lt;b&gt;📤 Outbox relay&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;→ order.events.v1&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="2220" y="660" width="150" height="56" as="geometry"/></mxCell><mxCell id="v3-83" parent="1" vertex="1" value='&lt;b&gt;⏱ Due poller · 5 s&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;release due HELD · POS submit retry · stuck orders · SKIP LOCKED&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#560027;"><mxGeometry x="1750" y="760" width="170" height="80" as="geometry"/></mxCell><mxCell id="v3-84" parent="1" vertex="1" value='&lt;b&gt;🌐 Admin API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;release now · extend / cancel hold · hold_policies CRUD · DLQ replay&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="1990" y="760" width="190" height="70" as="geometry"/></mxCell><mxCell id="v3-85" parent="1" vertex="1" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;• Duplicate event: UNIQUE(source, event_id) in history → skip, still Ack.&lt;br&gt;• Release crash: nothing lost. Status and outbox commit together; the next tick retries.&lt;br&gt;• Unknown raw status / stale or backward rank: history applied=false, no transition.&lt;br&gt;• POS submit failed: attempt_count++ and next_attempt_at set. The due poller re-emits FulfillmentRequested. After N tries → FAILED + alert.&lt;br&gt;• PG down: no Ack, consumer retries in place." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1750" y="870" width="450" height="175" as="geometry"/></mxCell><mxCell id="v3-86" parent="1" edge="1" source="v3-70" target="v3-77" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-87" parent="1" edge="1" source="v3-77" target="v3-79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-88" parent="1" edge="1" source="v3-79" target="v3-80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-89" parent="1" edge="1" source="v3-80" target="v3-81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-90" parent="1" edge="1" source="v3-83" target="v3-79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1835" y="730"/><mxPoint x="2027" y="730"/></Array></mxGeometry></mxCell><mxCell id="v3-91" parent="1" edge="1" source="v3-84" target="v3-79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-92" parent="1" vertex="1" value="Kafka · key = order ref_id" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="2420" y="130" width="250" height="1010" as="geometry"/></mxCell><mxCell id="v3-93" parent="1" vertex="1" value='&lt;b&gt;📨 order.events.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;OrderCreated&lt;br&gt;OrderStatusChanged&lt;br&gt;FulfillmentRequested&lt;br&gt;CancellationRequested&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="2430" y="630" width="230" height="130" as="geometry"/></mxCell><mxCell id="v3-94" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="2446" y="680.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v3-95" parent="1" vertex="1" value='&lt;b&gt;🚨 *.dlq&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one per consumer group&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffebee;strokeColor=#c62828;fontColor=#5d0000;"><mxGeometry x="2430" y="960" width="230" height="56" as="geometry"/></mxCell><mxCell id="v3-96" parent="1" edge="1" source="v3-82" target="v3-93" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3-97" parent="1" vertex="1" value="pos-gateway · Go · stateless · POS adapters (both directions)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="2700" y="130" width="600" height="1010" as="geometry"/></mxCell><mxCell id="v3-98" parent="1" vertex="1" value="📨 pos.raw.v1 ↻" style="rounded=1;arcSize=50;whiteSpace=
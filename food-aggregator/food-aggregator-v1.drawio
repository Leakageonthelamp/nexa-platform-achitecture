e=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="270" y="130" width="300" height="1010" as="geometry"/></mxCell><mxCell id="v2-21" parent="1" vertex="1" value='&lt;b&gt;🌐 POST /fa/{platform}/…&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;orders · order-state (status, cancel)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="290" y="200" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-22" parent="1" vertex="1" value='&lt;b&gt;⚙️ Verify signature · route&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;store flag NEW / LEGACY · cache 60 s&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="290" y="290" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-23" parent="1" vertex="1" value='&lt;b&gt;📤 Legacy forwarder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;proxy request as-is&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="380" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-24" parent="1" vertex="1" value='&lt;b&gt;📤 Produce FA raw&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;key = ref_id · 200 only after Kafka ack&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="470" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-25" parent="1" vertex="1" value='&lt;b&gt;🌐 POST /webhooks/pos/{pos}&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;BSL · SDM&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="290" y="600" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-26" parent="1" vertex="1" value="&lt;b&gt;⚙️ Verify HMAC&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="290" y="690" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-27" parent="1" vertex="1" value='&lt;b&gt;📤 Produce POS raw&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;key = order ref_id (strip #seq)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="290" y="780" width="260" height="56" as="geometry"/></mxCell><mxCell id="v2-28" parent="1" vertex="1" value="&lt;b&gt;Ingress rule&lt;/b&gt;&lt;br&gt;Every partner webhook lands here. It only verifies, routes and writes the raw body to Kafka. No business logic.&lt;br&gt;&lt;br&gt;Kafka down → reply 5xx so the partner retries. Never reply 200 before the Kafka ack." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="290" y="880" width="260" height="140" as="geometry"/></mxCell><mxCell id="v2-29" parent="1" edge="1" source="v2-15" target="v2-21" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-30" parent="1" edge="1" source="v2-17" target="v2-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="252" y="298"/><mxPoint x="252" y="239"/></Array></mxGeometry></mxCell><mxCell id="v2-31" parent="1" edge="1" source="v2-21" target="v2-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-32" parent="1" edge="1" source="v2-22" target="v2-23" value="LEGACY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-33" parent="1" edge="1" source="v2-23" target="v2-19" value="as-is" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="408"/><mxPoint x="260" y="415"/></Array></mxGeometry></mxCell><mxCell id="v2-34" parent="1" edge="1" source="v2-22" target="v2-24" value="NEW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="318"/><mxPoint x="560" y="498"/></Array></mxGeometry></mxCell><mxCell id="v2-35" parent="1" edge="1" source="v2-25" target="v2-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-36" parent="1" edge="1" source="v2-26" target="v2-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-37" parent="1" vertex="1" value="Kafka · raw · key = order ref_id" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="600" y="130" width="230" height="1010" as="geometry"/></mxCell><mxCell id="v2-38" parent="1" vertex="1" value='&lt;b&gt;📨 fa.raw.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;order + status · same key&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="610" y="470" width="210" height="56" as="geometry"/></mxCell><mxCell id="v2-39" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="626" y="483.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-40" parent="1" vertex="1" value='&lt;b&gt;📨 pos.raw.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;POS webhooks&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="610" y="780" width="210" height="56" as="geometry"/></mxCell><mxCell id="v2-41" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="626" y="793.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-42" parent="1" edge="1" source="v2-24" target="v2-38" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-43" parent="1" edge="1" source="v2-27" target="v2-40" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-44" parent="1" vertex="1" value="fa-channel-adapter · Node.js · normalize + delayed create (hold)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="860" y="130" width="700" height="1010" as="geometry"/></mxCell><mxCell id="v2-45" parent="1" vertex="1" value="&lt;b&gt;📥 fa.raw.v1 consumer&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontColor=#3d1150;"><mxGeometry x="880" y="200" width="250" height="56" as="geometry"/></mxCell><mxCell id="v2-46" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="896" y="213.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-47" parent="1" vertex="1" value='&lt;b&gt;⚙️ Derive keys · dedup&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ref_id · event_id&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="290" width="250" height="56" as="geometry"/></mxCell><mxCell id="v2-48" parent="1" vertex="1" value='&lt;b&gt;🧩 Map platform → standard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Grab · LINE MAN mappers · raw status as-is&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="380" width="250" height="56" as="geometry"/></mxCell><mxCell id="v2-49" parent="1" vertex="1" value='&lt;b&gt;⚙️ Enrich order&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Minor store · menu · brand delay&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="470" width="250" height="56" as="geometry"/></mxCell><mxCell id="v2-50" parent="1" vertex="1" value='&lt;b&gt;⚙️ Hold order&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;INSERT HELD · fire_at = placed_at + brand delay&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="880" y="560" width="250" height="56" as="geometry"/></mxCell><mxCell id="v2-51" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="965" y="650" width="80" height="34" as="geometry"/></mxCell><mxCell id="v2-52" parent="1" vertex="1" value='&lt;b&gt;⏱ Release job · every 5 s&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;due HELD rows · FOR UPDATE SKIP LOCKED · publish, then mark RELEASED&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#560027;"><mxGeometry x="880" y="760" width="250" height="70" as="geometry"/></mxCell><mxCell id="v2-53" parent="1" vertex="1" value='&lt;b&gt;⚙️ Apply to hold&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;cancel + HELD → CANCELLED = order gone&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="1200" y="380" width="330" height="56" as="geometry"/></mxCell><mxCell id="v2-54" parent="1" vertex="1" value='&lt;b&gt;📤 Forward ChannelStatusChanged&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;always · OMS drops unknown ref_id&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="1200" y="470" width="330" height="56" as="geometry"/></mxCell><mxCell id="v2-55" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="1325" y="560" width="80" height="34" as="geometry"/></mxCell><mxCell id="v2-56" parent="1" vertex="1" value='&lt;b&gt;fa_hold&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;PG schema · owner: this adapter&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="1200" y="620" width="160" height="90" as="geometry"/></mxCell><mxCell id="v2-57" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1216" y="650.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-58" parent="1" vertex="1" value='&lt;b&gt;📤 Publish OrderPlaced&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;→ oms.inbound.v1&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="1200" y="860" width="330" height="56" as="geometry"/></mxCell><mxCell id="v2-59" parent="1" vertex="1" value="&lt;b&gt;Delayed create&lt;/b&gt; (per brand, e.g. 0 / 1 / 3 min)&lt;br&gt;• Cancel inside the window: HELD → CANCELLED. OMS and POS never see the order.&lt;br&gt;• Release and cancel both lock the same row, so only one wins.&lt;br&gt;• Cancel after release: OMS cancels normally (CancellationRequested → POS).&lt;br&gt;• Same key on fa.raw.v1, so a cancel is never handled before its create." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="880" y="960" width="320" height="170" as="geometry"/></mxCell><mxCell id="v2-60" parent="1" vertex="1" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;• Transient (legacy API, PG, Kafka): retry in place with backoff. The partition pauses, so order is kept.&lt;br&gt;• Unknown store / menu / bad payload: → fa.raw.dlq + alert. Replay from admin.&lt;br&gt;• Release crash after publish: row stays HELD and is re-published. OMS is idempotent on ref_id." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1220" y="960" width="320" height="170" as="geometry"/></mxCell><mxCell id="v2-61" parent="1" vertex="1" value="⚠️ &lt;b&gt;Brand delay source TBD&lt;/b&gt;&lt;br&gt;mfg-agg-service brand config, or a brand_delay table in fa_hold. Delay 0 = next tick (≤ 5 s)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#fff8e1;strokeColor=#f9a825;"><mxGeometry x="1375" y="610" width="170" height="135" as="geometry"/></mxCell><mxCell id="v2-62" parent="1" edge="1" source="v2-38" target="v2-45" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="498"/><mxPoint x="845" y="228"/></Array></mxGeometry></mxCell><mxCell id="v2-63" parent="1" edge="1" source="v2-45" target="v2-47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-64" parent="1" edge="1" source="v2-47" target="v2-48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-65" parent="1" edge="1" source="v2-48" target="v2-49" value="order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-66" parent="1" edge="1" source="v2-49" target="v2-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-67" parent="1" edge="1" source="v2-50" target="v2-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-68" parent="1" edge="1" source="v2-48" target="v2-53" value="status / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-69" parent="1" edge="1" source="v2-53" target="v2-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-70" parent="1" edge="1" source="v2-54" target="v2-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-71" parent="1" edge="1" source="v2-50" target="v2-56" value="W" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="588"/><mxPoint x="1165" y="678"/></Array></mxGeometry></mxCell><mxCell id="v2-72" parent="1" edge="1" source="v2-53" target="v2-56" value="W" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="425"/><mxPoint x="1185" y="651"/></Array></mxGeometry></mxCell><mxCell id="v2-73" parent="1" edge="1" source="v2-52" target="v2-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#3949ab;strokeWidth=1.5;fontColor=#1a237e;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="781"/></Array></mxGeometry></mxCell><mxCell id="v2-74" parent="1" edge="1" source="v2-52" target="v2-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="816"/><mxPoint x="1170" y="888"/></Array></mxGeometry></mxCell><mxCell id="v2-75" parent="1" vertex="1" value="Data stores" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="20" y="1170" width="3670" height="200" as="geometry"/></mxCell><mxCell id="v2-76" parent="1" vertex="1" value='&lt;b&gt;⚙️ mfg-agg-service (legacy)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GET /v1/stores · menu map · brand config?&lt;br&gt;callers: partner-bff (flag) · fa-adapter (enrich)&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#dae8fc;strokeColor=#1565c0;fontColor=#0d2a52;"><mxGeometry x="370" y="1220" width="250" height="72" as="geometry"/></mxCell><mxCell id="v2-77" parent="1" vertex="1" value='&lt;b&gt;🐬 Aggregator DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;MariaDB · legacy, shared&lt;br&gt;sites · routing · menu&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#e8eaf6;strokeColor=#3949ab;fontColor=#1a237e;"><mxGeometry x="660" y="1205" width="150" height="95" as="geometry"/></mxCell><mxCell id="v2-78" parent="1" edge="1" source="v2-76" target="v2-77" value="R" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=1 3;strokeColor=#3949ab;strokeWidth=2;fontColor=#1a237e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-79" parent="1" edge="1" source="v2-22" target="v2-76" value="store flag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="318"/><mxPoint x="280" y="1252"/></Array></mxGeometry></mxCell><mxCell id="v2-80" parent="1" edge="1" source="v2-49" target="v2-76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="868" y="498"/><mxPoint x="868" y="1150"/><mxPoint x="500" y="1150"/></Array></mxGeometry></mxCell><mxCell id="v2-81" parent="1" vertex="1" value="Kafka · key = order ref_id" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="1590" y="130" width="250" height="1010" as="geometry"/></mxCell><mxCell id="v2-82" parent="1" vertex="1" value='&lt;b&gt;📨 oms.inbound.v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;OrderPlaced&lt;br&gt;ChannelStatusChanged&lt;br&gt;PosStatusChanged&lt;br&gt;one topic → per-order ordering&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#424242;strokeColor=#212121;fontColor=#ffffff;"><mxGeometry x="1600" y="470" width="230" height="150" as="geometry"/></mxCell><mxCell id="v2-83" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1616" y="530.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-84" parent="1" vertex="1" value='&lt;b&gt;🚨 *.dlq&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one per consumer group&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffebee;strokeColor=#c62828;fontColor=#5d0000;"><mxGeometry x="1600" y="960" width="230" height="56" as="geometry"/></mxCell><mxCell id="v2-85" parent="1" edge="1" source="v2-54" target="v2-82" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-86" parent="1" edge="1" source="v2-58" target="v2-82" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1575" y="888"/><mxPoint x="1575" y="590"/></Array></mxGeometry></mxCell><mxCell id="v2-87" parent="1" vertex="1" value="order-service (OMS) · Go hexagonal · source of truth · state machine" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#fafafa;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#212121;"><mxGeometry x="1870" y="130" width="660" height="1010" as="geometry"/></mxCell><mxCell id="v2-88" parent="1" vertex="1" value="&lt;b&gt;State machine&lt;/b&gt; (one status column, rank only moves forward)&lt;br&gt;RECEIVED → CONFIRMED → PREPARING → READY → OUT_FOR_DELIVERY → DELIVERED → COMPLETED&lt;br&gt;Terminal: CANCELLED · REJECTED · FAILED&lt;br&gt;Raw status → normalized via &lt;b&gt;status_mappings&lt;/b&gt; (source, raw_status). Mapping lives only here." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1890" y="180" width="620" height="120" as="geometry"/></mxCell><mxCell id="v2-89" parent="1" vertex="1" value="&lt;b&gt;📥 oms.inbound.v1 consumer&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=left;spacingLeft=62;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontColor=#3d1150;"><mxGeometry x="1890" y="517" width="190" height="56" as="geometry"/></mxCell><mxCell id="v2-90" parent="1" vertex="1" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;"><mxGeometry x="1906" y="530.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="v2-91" parent="1" vertex="1" value="🧠 &lt;b&gt;Order Core&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create order · idempotent on ref_id&lt;br&gt;Map raw status&lt;br&gt;Apply transition · rank forward&lt;br&gt;Route store → POS&lt;br&gt;Request fulfillment / cancel&lt;br&gt;Unknown ref_id → drop" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=24;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#fff2cc;strokeColor=#f9a825;fontColor=#4d3800;"><mxGeometry x="2115" y="435" width="210" height="220" as="geometry"/></mxCell><mxCell id="v2-92" parent="1" vertex="1" value='&lt;b&gt;📤 Order repo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one PG TX: order · subs · history · outbox&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="2360" y="517" width="150" height="56" as="geometry"/></mxCell><mxCell id="v2-93" parent="1" vertex="1" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=12;"><mxGeometry x="2395" y="435" width="80" height="34" as="geometry"/></mxCell><mxCell id="v2-94" parent="1" vertex="1" value='&lt;b&gt;📤 Outbox relay&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;→ order.events.v1&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#ffe0b2;strokeColor=#ef6c00;fontColor=#4a2400;"><mxGeometry x="2360" y="660" width="150" height="56" as="geometry"/></mxCell><mxCell id="v2-95" parent="1" vertex="1" value='&lt;b&gt;⏱ Due poller · 30 s&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;POS submit retry (next_attempt_at) · stuck orders&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#560027;"><mxGeometry x="1890" y="760" width="170" height="70" as="geometry"/></mxCell><mxCell id="v2-96" parent="1" vertex="1" value='&lt;b&gt;🌐 Admin API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;orders · holds · DLQ replay · manual actions&lt;/font&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;spacing=4;align=center;fillColor=#d5e8d4;strokeColor=#2e7d32;fontColor=#1b3d1f;"><mxGeometry x="2130" y="760" width="180" height="56" as="geometry"/></mxCell><mxCell id="v2-97" parent="1" vertex="1" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;• Duplicate event: UNIQUE(source, event_id) in history → skip, still Ack.&lt;br&gt;• Unknown raw status / stale or backward rank: history applied=false, no transition.&lt;br&gt;• POS submit failed: attempt_count++ and next_attempt_at set. The due poller re-emits FulfillmentRequested. After N tries → FAILED + alert.&lt;br&gt;• PG down: no Ack, consumer retries in place." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fontColor=#212121;fillColor=#ffffff;strokeColor=#bdbdbd;"><mxGeometry x="1890" y="870" width="450" height="175" as="geometry"/></mxCell><mxCell id="v2-98" parent="1" edge="1" source="v2-82" target="v2-89" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;strokeColor=#757575;strokeWidth=1.5;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-99" parent="1" edge="1" source="v2-89" target="v2-91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-100" parent="1" edge="1" source="v2-91" target="v2-92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-101" parent="1" edge="1" source="v2-92" target="v2-93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v2-102" parent="1" edge="1" source="v2-95" target="v2-91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#424242;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1975" y="730"/><mxPoint x="2167" y="730"/></Array
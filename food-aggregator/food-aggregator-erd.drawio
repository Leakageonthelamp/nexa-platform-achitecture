        <mxCell id="mongo-v22" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;Why one document per message&lt;/b&gt;&lt;br&gt;• Avoids unbounded array growth and the 16 MB cap.&lt;br&gt;• Insert-only + unique (source, event_id, stage) = simple idempotency.&lt;br&gt;• TTL expires per message.&lt;br&gt;• No &lt;code&gt;track&lt;/code&gt; field — single status model." vertex="1">
          <mxGeometry height="150" width="420" x="1120" y="120" as="geometry" />
        </mxCell>
        <mxCell id="mongo-v23" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;Write order&lt;/b&gt;&lt;br&gt;1. Insert raw (order_id may be null).&lt;br&gt;2. PG transaction updates order + history + outbox.&lt;br&gt;3. Best-effort back-fill of order_id; reconcile retries.&lt;br&gt;Mongo failure must not block PostgreSQL." vertex="1">
          <mxGeometry height="150" width="420" x="1120" y="300" as="geometry" />
        </mxCell>
        <mxCell id="mongo-v24" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Helvetica;" value="&lt;b&gt;PII&lt;/b&gt;: mask phone and address before insert. 180-day TTL is the upper bound." vertex="1">
          <mxGeometry height="80" width="420" x="1120" y="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="life-v4" value="&lt;b style=&#39;color:#2e7d32;font-size:14px&#39;&gt;① Grab delivery — happy path&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39; style=&#39;font-size:12px&#39;&gt;RECEIVED&amp;nbsp;&amp;nbsp;→&amp;nbsp;CONFIRMED&amp;nbsp;&amp;nbsp;→&amp;nbsp;PREPARING&amp;nbsp;&amp;nbsp;→&amp;nbsp;READY&lt;br&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;OUT_FOR_DELIVERY&amp;nbsp;&amp;nbsp;→&amp;nbsp;DELIVERED&amp;nbsp;&amp;nbsp;→&amp;nbsp;COMPLETED&lt;/font&gt;&lt;br&gt;&lt;br&gt;Create (SYSTEM) → BSL TBD_ACCEPTED → TBD_COOKING → TBD_READY&lt;br&gt;→ &lt;b&gt;GRAB COLLECTED&lt;/b&gt; → &lt;b&gt;GRAB DELIVERED&lt;/b&gt; → close&lt;br&gt;Order: &lt;code&gt;grab_4y25f-tcc-siam_A-7XKQ&lt;/code&gt; · The Coffee Club Siam" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="619" width="690" height="200" as="geometry" />
        </mxCell>
        <mxCell id="life-v5" value="&lt;b style=&#39;color:#c62828;font-size:14px&#39;&gt;② POS reject&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39; style=&#39;font-size:12px&#39;&gt;RECEIVED&amp;nbsp;&amp;nbsp;→&amp;nbsp;CONFIRMED&amp;nbsp;&amp;nbsp;→&amp;nbsp;REJECTED&lt;/font&gt;&lt;br&gt;&lt;br&gt;POS accepts then kitchen cannot fulfill (stock out).&lt;br&gt;BSL reject code &lt;i&gt;(TBD)&lt;/i&gt; → status REJECTED.&lt;br&gt;Channel notified; prepaid refund owned by Grab / LINE MAN." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="754" y="619" width="690" height="200" as="geometry" />
        </mxCell>
        <mxCell id="life-v6" value="&lt;b style=&#39;color:#c62828;font-size:14px&#39;&gt;③ Grab cancel&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39; style=&#39;font-size:12px&#39;&gt;RECEIVED&amp;nbsp;&amp;nbsp;→&amp;nbsp;…&amp;nbsp;&amp;nbsp;→&amp;nbsp;READY&amp;nbsp;&amp;nbsp;→&amp;nbsp;CANCELLED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GRAB CANCELLED&lt;/b&gt; is final for the customer.&lt;br&gt;If food already picked up: stay CANCELLED,&lt;br&gt;set &lt;code&gt;status_reason = POS_CANCEL_AFTER_PICKUP&lt;/code&gt; for ops." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1468" y="619" width="690" height="200" as="geometry" />
        </mxCell>
        <mxCell id="life-v7" value="* = reserved / rare path. LINE MAN, BSL, SDM raw codes are TBD placeholders. Only Grab public codes above are confirmed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">

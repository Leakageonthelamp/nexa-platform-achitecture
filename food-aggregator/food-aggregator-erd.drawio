nt-size:12px;vertical-align:top;width:320px;line-height:1.35&#39;&gt;BSL TBD_READY (TBD)&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:280px;line-height:1.35&#39;&gt;OUT_FOR_DELIVERY, COMPLETED, CANCELLED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:55px;line-height:1.35&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:80px;line-height:1.35&#39;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e8f5e9&#39;&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:90px;line-height:1.35&#39;&gt;&lt;b style=&#39;color:#37474f&#39;&gt;Delivery&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:150px;line-height:1.35&#39;&gt;OUT_FOR_DELIVERY&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:48px;line-height:1.35&#39;&gt;60&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:200px;line-height:1.35&#39;&gt;Rider en route&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:320px;line-height:1.35&#39;&gt;GRAB COLLECTED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:280px;line-height:1.35&#39;&gt;DELIVERED, CANCELLED*, FAILED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:55px;line-height:1.35&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:80px;line-height:1.35&#39;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;bac
        <mxCell id="life-v3" value="&lt;div style=&#39;font-size:15px;font-weight:bold;color:#1a237e;margin:0 0 6px 0;font-family:Helvetica&#39;&gt;order_statuses lifecycle&lt;/div&gt;&lt;table style=&#39;width:100%;table-layout:fixed;border-collapse:collapse;font-family:Helvetica&#39;&gt;&lt;tr&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:90px&#39;&gt;Phase&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:150px&#39;&gt;Status&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:48px&#39;&gt;Rank&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:200px&#39;&gt;Meaning&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:320px&#39;&gt;Entered by (source → raw)&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:280px&#39;&gt;Allowed next&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:55px&#39;&gt;Term?&lt;/th&gt;&lt;th style=&#39;background:#3949ab;color:#fff;padding:8px 10px;text-align:left;font-size:12px;font-weight:bold;border:none;width:80px&#39;&gt;Active?&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#e3f2fd&#39;&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:90px;line-height:1.35&#39;&gt;&lt;b style=&#39;color:#37474f&#39;&gt;Intake&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:150px;line-height:1.35&#39;&gt;RECEIVED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:48px;line-height:1.35&#39;&gt;10&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:200px;line-height:1.35&#39;&gt;Accepted into OMS&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:320px;line-height:1.35&#39;&gt;SYSTEM create order&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:280px;line-height:1.35&#39;&gt;CONFIRMED, CANCELLED, FAILED, PENDING_PAYMENT*&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:55px;line-height:1.35&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:80px;line-height:1.35&#39;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f3e5f5&#39;&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:90px;line-height:1.35&#39;&gt;&lt;b style=&#39;color:#37474f&#39;&gt;Reserved&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:150px;line-height:1.35&#39;&gt;PENDING_PAYMENT&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:48px;line-height:1.35&#39;&gt;15&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:200px;line-height:1.35&#39;&gt;Waiting authorize (own channel)&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:320px;line-height:1.35&#39;&gt;PAYMENT → TBD_successful*&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:280px;line-height:1.35&#39;&gt;CONFIRMED, CANCELLED, FAILED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:55px;line-height:1.35&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:80px;line-height:1.35&#39;&gt;Reserved&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#fce4ec&#39;&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:90px;line-height:1.35&#39;&gt;&lt;b style=&#39;color:#37474f&#39;&gt;Kitchen&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:150px;line-height:1.35&#39;&gt;CONFIRMED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:48px;line-height:1.35&#39;&gt;30&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:200px;line-height:1.35&#39;&gt;POS ticket confirmed&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:320px;line-height:1.35&#39;&gt;BSL TBD_ACCEPTED / SDM UpdateOrder:OK&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:280px;line-height:1.35&#39;&gt;PREPARING, CANCELLED, REJECTED&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:55px;line-height:1.35&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:80px;line-height:1.35&#39;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#fce4ec&#39;&gt;&lt;td style=&#39;padding:7px 10px;border-bottom:1px solid #e0e4ea;font-size:12px;vertical-align:top;width:90px;line-h
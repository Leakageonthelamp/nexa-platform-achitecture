        <mxCell id="mongo-e20" edge="1" parent="1" source="mongo-v6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#7e57c2;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;fontSize=10;fontFamily=Helvetica;fontColor=#5e35b1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.85;entryX=1;entryY=0.08;" target="mongo-v3" value="first_raw_id = _id">

        <mxCell id="mongo-e21" edge="1" parent="1" source="mongo-v14" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;dashPattern=6 4;strokeColor=#7e57c2;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;fontSize=10;fontFamily=Helvetica;fontColor=#5e35b1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.72;" target="mongo-v3" value="raw_id = _id">
          <mxGeometry relative="1" x="0.6" as="geometry" />

        <mxCell id="n45" parent="n13" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1D4ED8;" value="Statement does not subscribe. It is a mode of this app and it runs after the same commit." vertex="1">
          <mxGeometry height="56" width="344" x="16" y="216" as="geometry" />
        </mxCell>
        <mxCell id="n73" parent="n13" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;paid_out · payout_failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;settles the trip row&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="260" x="16" y="288" as="geometry" />
        </mxCell>
        <mxCell id="n74" parent="n13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" value="Ack" vertex="1">
          <mxGeometry height="28" width="72" x="288" y="308" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="6. Data · commit here, then the fact" vertex="1">
          <mxGeometry height="350" width="500" x="16" y="1296" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="n14" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;transactions · attempts · brand config&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;outbox · processed_event · audit&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="468" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n47" parent="n46" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">
          <mxGeometry height="30" width="30" x="16" y="19" as="geometry" />
        </mxCell>
        <mxCell id="n48" parent="n14" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingLeft=62;spacingRight=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;tax invoice · receipt&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;written by Statement mode&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="226" x="16" y="124" as="geometry" />
        </mxCell>
        <mxCell id="n49" parent="n48" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1">
          <mxGeometry height="30" width="30" x="16" y="19" as="geometry" />
        </mxCell>
        <mxCell id="n50" parent="n14" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="Keys live in brand config, not on the bus and not in Brand." vertex="1">
          <mxGeometry height="80" width="230" x="254" y="124" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" value="Decisions · why this, and what it costs" vertex="1">
          <mxGeometry height="350" width="688" x="532" y="1296" as="geometry" />
        </mxCell>
        <mxCell id="n51" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• &lt;b&gt;Charge is gRPC.&lt;/b&gt; The shopper is waiting for authorize_url. A command topic cannot return it. Order is the caller; a retry with the same idempotency_key never charges twice.&lt;br&gt;• &lt;b&gt;One command.&lt;/b&gt; Capture, void, the webhook, and payout share a key, so they stay in order.&lt;br&gt;• &lt;b&gt;Refund is gRPC.&lt;/b&gt; An admin is waiting. The gateway call is the outbox worker.&lt;br&gt;• &lt;b&gt;Omise charges. TrueMoney pays the rider.&lt;/b&gt; 2C2P is still the unshipped charge port. There is no bank-failover path.&lt;br&gt;• &lt;b&gt;Statement is a mode,&lt;/b&gt; not a service. The ledger is the transactions table." vertex="1">
          <mxGeometry height="230" width="608" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n52" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="Cost: a consumer that starts late only sees 7 days of payment.events. Older rows are read from Postgres, not replayed." vertex="1">
          <mxGeometry height="56" width="608" x="16" y="286" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="772" x="1284" y="1296" as="geometry" />
        </mxCell>
        <mxCell id="n53" parent="n16" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="&lt;b&gt;Order&lt;/b&gt; — the saga. It calls CreateTransaction and later publishes capture or void.&lt;br&gt;&lt;b&gt;Brand&lt;/b&gt; — who the brand is. Payment config here holds that brand&#39;s gateway account.&lt;br&gt;&lt;b&gt;Wallet&lt;/b&gt; — balance. It reads payment.events where the purpose is a top-up.&lt;br&gt;&lt;b&gt;Catalog&lt;/b&gt; — price. Payment stores the amount it was given.&lt;br&gt;&lt;b&gt;Identity&lt;/b&gt; — the shopper.&lt;br&gt;&lt;b&gt;Delivery&lt;/b&gt; — the rider and the trip. It publishes payout and reads paid_out." vertex="1">
          <mxGeometry height="260" width="724" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n54" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Order calls CreateTransaction at checkout, customer-bff calls it for a top-up, and admin-bff calls Refund. All three are gRPC with an idempotency_key. payment.requested is capture, void, webhook, and payout. Delivery publishes payout with brand_id = mfg. The worker calls Omise or TrueMoney. payment.events adds paid_out and payout_failed. Statement does not subscribe.&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="1412" x="532" y="1188" as="geometry" />
        </mxCell>
        <mxCell id="n55" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="A webhook with a bad signature dies at the edge and never reaches the topic. A replay of the same event_id is a no-op." vertex="1">
          <mxGeometry height="28" width="1412" x="532" y="1256" as="geometry" />
        </mxCell>

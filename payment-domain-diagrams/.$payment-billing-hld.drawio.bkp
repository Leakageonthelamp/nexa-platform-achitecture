        <mxCell id="n40" parent="n12" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#047857;" value="Wallet keeps the records whose purpose is a top-up. Delivery keeps paid_out and payout_failed. There is no wallet topic." vertex="1">
          <mxGeometry height="56" width="268" x="16" y="180" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="5. Consumers" vertex="1">

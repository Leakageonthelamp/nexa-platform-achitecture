        </mxCell>
        <mxCell id="n43" parent="n13" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;payment.events · purpose = top-up&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;not an order payment&lt;/font&gt;" vertex="1">

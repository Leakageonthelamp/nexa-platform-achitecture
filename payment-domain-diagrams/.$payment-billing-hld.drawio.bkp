        <mxCell id="n44" parent="n13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" value="Ack" vertex="1">

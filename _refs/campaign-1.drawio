        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#475569;fontStyle=1;" value="&lt;b&gt;3. Ownership&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="1900" x="488" y="832" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-23" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#0F172A;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" value="&lt;b&gt;Campaign owns&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;rules, stacking, budgets, reservations, redemption ledger&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="488" y="866" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-24" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" value="&lt;b&gt;Cart owns&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;cart contents, merge, pricing_version&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="964" y="866" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-25" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" value="&lt;b&gt;Order owns&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;order_id, locked prices, guest snapshot, payment status&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="1440" y="866" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-26" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=13;fontColor=#0F172A;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" value="&lt;b&gt;Campaign never&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;stores cart lines, calls POS/Payment/Order directly, creates orders, talks to the client directly&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="460" x="1916" y="866" as="geometry" />
        </mxCell>
      </root>

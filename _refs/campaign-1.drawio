          <mxGeometry height="130" width="10" x="460" y="184" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1D4ED8;fontStyle=1;" value="&lt;b&gt;1. Caller&lt;/b&gt; — Cart is the only caller, Campaign is never called by App / BFF directly" vertex="1">
          <mxGeometry height="26" width="1900" x="488" y="192" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" value="&lt;b&gt;Cart Domain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;Go · orchestrates pricing · calls Campaign via gRPC for EvaluateBasket / ValidateVoucher / Reserve / Commit / Release&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="500" x="488" y="226" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-7" edge="1" parent="1" source="POF7ETg37rVwDWWVX6qP-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontColor=#334155;fontFamily=Arial;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="POF7ETg37rVwDWWVX6qP-8" value="gRPC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-8" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;" value="" vertex="1">
          <mxGeometry height="430" width="1944" x="460" y="354" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-9" parent="1" style="rounded=0;fillColor=#EA580C;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="430" width="10" x="460" y="354" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-10" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#9A3412;fontStyle=1;" value="&lt;b&gt;2. Campaign core&lt;/b&gt; (Bun/Elysia) — modes: api · consumer · worker · cron" vertex="1">
          <mxGeometry height="26" width="1900" x="488" y="362" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-11" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" value="&lt;b&gt;Campaign Domain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9A3412&quot; style=&quot;font-size:10px&quot;&gt;Bun/Elysia · modes: api · consumer · worker · cron&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;stores campaign rules, promo conditions, vouchers, redemption ledger&lt;br&gt;evaluates baskets, validates vouchers, reserves / commits / releases redemptions&lt;br&gt;never calls Cart, Order, or POS — pure responder&lt;/font&gt;" vertex="1">
          <mxGeometry height="372" width="480" x="488" y="396" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-12" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;campaign:lock:{voucher_code} TTL 10s — distributed lock during Reserve, stops concurrent over-redeem&lt;br&gt;hot rule cache for EvaluateBasket (short TTL)&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="460" x="992" y="396" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-13" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" value="&lt;b&gt;PostgreSQL (own DB)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;campaigns, promo_rules, vouchers, redemptions (immutable ledger), redemption_reservations (TTL) — no shared DB with other domains&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="460" x="992" y="492" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-14" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;" value="&lt;b&gt;Kafka consumer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;order.created → confirm commit (idempotent)&lt;br&gt;order.cancelled / payment_failed → release reservation&lt;br&gt;safety net if Cart&#39;s direct Commit/Release call never arrives&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="460" x="992" y="588" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-15" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;" value="&lt;b&gt;Worker &amp; Cron&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px&quot;&gt;worker: activate/deactivate campaigns at start_at/end_at, recompute budget spend&lt;br&gt;cron (nightly): expire orphaned reservations past TTL, reconcile ledger vs Order records&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="460" x="992" y="684" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-16" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=12;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;" value="&lt;b&gt;API surface (gRPC, Cart-only)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;GetDisplayPromos(skus[]) — cached, display only&lt;br&gt;EvaluateBasket(lines, prices, vouchers) — automatic promos (BOGO, bundle, free-ship)&lt;br&gt;ValidateVoucher(code, user, basket) — dry-run, no side effects&lt;br&gt;ReserveRedemption(id) — soft lock, TTL 10 min&lt;br&gt;CommitRedemption(reservation_id, order_id) — idempotent, writes permanent ledger row&lt;br&gt;ReleaseRedemption(reservation_id) — frees usage cap on checkout failure&lt;br&gt;&lt;br&gt;&lt;b&gt;Publishes:&lt;/b&gt; campaign.redemption.committed, campaign.budget.updated → Kafka → S3 sink for reporting&lt;/font&gt;" vertex="1">
          <mxGeometry height="372" width="900" x="1476" y="396" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-17" edge="1" parent="1" source="POF7ETg37rVwDWWVX6qP-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#475569;fontColor=#475569;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="POF7ETg37rVwDWWVX6qP-12" value="lock / cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-18" edge="1" parent="1" source="POF7ETg37rVwDWWVX6qP-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#475569;fontColor=#475569;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="POF7ETg37rVwDWWVX6qP-13" value="read / write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-19" edge="1" parent="1" source="POF7ETg37rVwDWWVX6qP-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#4F46E5;fontColor=#4F46E5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="POF7ETg37rVwDWWVX6qP-11" value="consume order.*">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-20" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;" value="" vertex="1">

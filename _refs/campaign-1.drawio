        <mxCell id="POF7ETg37rVwDWWVX6qP-2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#64748B;" value="Column layout · edges only to neighbors · Campaign never calls Cart, Order, or POS — pure responder · async order.* consumption is a safety net, not the primary commit path" vertex="1">
          <mxGeometry height="22" width="1944" x="460" y="148" as="geometry" />
        </mxCell>
        <mxCell id="POF7ETg37rVwDWWVX6qP-3" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;" value="" vertex="1">

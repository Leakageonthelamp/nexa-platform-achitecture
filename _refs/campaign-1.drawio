        <mxCell id="POF7ETg37rVwDWWVX6qP-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#0F172A;fontStyle=1;" value="Campaign Domain HLD — Bun/Elysia · own Postgres + Redis + Kafka consumer · called only by Cart (gRPC) · v1" vertex="1">
          <mxGeometry height="32" width="1944" x="460" y="110" as="geometry" />

<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="24.0.0"><diagram id="voucher-campaign-hld" name="Voucher &amp; Campaign HLD"><mxGraphModel dx="1980" dy="1540" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="Voucher &amp; Campaign — deals, vouchers, and member cards, settled when the order is placed" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1920" height="32" as="geometry" /></mxCell><mxCell id="t2" value="One Go engine. Orders calls EvaluateBasket and ReserveRedemptions while the shopper waits. order.events spends or returns the hold. notification.requested carries a send or a broadcast. brand_id is on every hop." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1920" height="34" as="geometry" /></mxCell><mxCell id="p1" value="gRPC · EvaluateBasket · ReserveRedemptions · admin writes · reads" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#C2410C;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="24" y="86" width="620" height="28" as="geometry" /></mxCell><mxCell id="p2" value="HTTP · none · the edge stops at the BFFs" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#1D4ED8;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="660" y="86" width="380" height="28" as="geometry" /></mxCell><mxCell id="p3" value="Kafka command · notification.requested out" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#6D28D9;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1056" y="86" width="480" height="28" as="geometry" /></mxCell><mxCell id="p4" value="Kafka fact · order.events in" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#047857;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1552" y="86" width="392" height="28" as="geometry" /></mxCell><mxCell id="lane-call" value="1. Callers" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="16" y="128" width="360" height="556" as="geometry" /></mxCell><mxCell id="c-basket" value="&lt;b&gt;Cart &amp; Order · basket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;EvaluateBasket&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;codes on the cart&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;nothing is spent&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;dashPattern=6 4;" vertex="1" parent="lane-call"><mxGeometry x="16" y="44" width="328" height="84" as="geometry" /></mxCell><mxCell id="c-hold" value="&lt;b&gt;Cart &amp; Order · hold&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;ReserveRedemptions&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;keyed by order_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;at PlaceOrder&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;dashPattern=6 4;" vertex="1" parent="lane-call"><mxGeometry x="16" y="160" width="328" height="84" as="geometry" /></mxCell><mxCell id="c-admin" value="&lt;b&gt;admin-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;campaigns and vouchers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;member cards&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;audience is customer ids&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;dashPattern=6 4;" vertex="1" parent="lane-call"><mxGeometry x="16" y="276" width="328" height="84" as="geometry" /></mxCell><mxCell id="c-reads" value="&lt;b&gt;customer-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;own vouchers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;own member card&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;never writes&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;dashPattern=6 4;" vertex="1" parent="lane-call"><mxGeometry x="16" y="392" width="328" height="84" as="geometry" /></mxCell><mxCell id="c-note" value="The app never calls this domain. Catalog is asked only when a rule names a SKU." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" vertex="1" parent="lane-call"><mxGeometry x="16" y="488" width="328" height="52" as="geometry" /></mxCell><mxCell id="lane-in" value="2. Kafka in" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="16" y="700" width="360" height="360" as="geometry" /></mxCell><mxCell id="in-topic" value="&lt;b&gt;order.events&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;placed · cancelled · rejected&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;key brand_id:order_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;7 days&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="lane-in"><mxGeometry x="16" y="128" width="328" height="108" as="geometry" /></mxCell><mxCell id="in-logo" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="in-topic"><mxGeometry x="16" y="39" width="30" height="30" as="geometry" /></mxCell><mxCell id="in-note" value="accepted, ready, and completed are an Ack with no work. A second delivery of the same version is a no-op. There is no voucher command topic. Every write has a caller waiting, so it is gRPC." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" vertex="1" parent="lane-in"><mxGeometry x="16" y="252" width="328" height="92" as="geometry" /></mxCell><mxCell id="lane-eng" value="3. Voucher engine · Go" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#FEF9C3;strokeColor=#EAB308;" vertex="1" parent="1"><mxGeometry x="392" y="128" width="780" height="944" as="geometry" /></mxCell><mxCell id="d-basket" value="&lt;b&gt;Basket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;EvaluateBasket&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;fixed rule order&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;a bad code is on the reply&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lane-eng"><mxGeometry x="16" y="44" width="220" height="84" as="geometry" /></mxCell><mxCell id="d-hold" value="&lt;b&gt;Hold&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;ReserveRedemptions&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;unique on order_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;re-checks the cap&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lane-eng"><mxGeometry x="16" y="160" width="220" height="84" as="geometry" /></mxCell><mxCell id="d-admin" value="&lt;b&gt;Admin write&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;grant in X-Roles&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;asks Catalog for SKUs&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;audit in the same commit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lane-eng"><mxGeometry x="16" y="276" width="220" height="84" as="geometry" /></mxCell><mxCell id="d-reads" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;own customer only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;vouchers and the card&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;a shopper never writes&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="lane-eng"><mxGeometry x="16" y="392" width="220" height="84" as="geometry" /></mxCell><mxCell id="d-cons" value="&lt;b&gt;Order facts&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;consumes order.events&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;placed spends the hold&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;cancel or reject returns it&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="lane-eng"><mxGeometry x="16" y="712" width="220" height="84" as="geometry" /></mxCell><mxCell id="ack-in" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane-eng"><mxGeometry x="90" y="812" width="72" height="28" as="geometry" /></mxCell><mxCell id="book" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#EAB308;" vertex="1" parent="lane-eng"><mxGeometry x="284" y="44" width="230" height="432" as="geometry" /></mxCell><mxCell id="bk1" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;campaigns and the cap&lt;/font&gt;" style="text;fontFamily=Arial;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F172A;" vertex="1" parent="book"><mxGeometry x="14" y="16" width="202" height="40" as="geometry" /></mxCell><mxCell id="bk2" value="&lt;b&gt;Holds&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one row per order&lt;/font&gt;" style="text;fontFamily=Arial;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F172A;" vertex="1" parent="book"><mxGeometry x="14" y="132" width="202" height="40" as="geometry" /></mxCell><mxCell id="bk3" value="&lt;b&gt;Issued&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;vouchers and member cards&lt;/font&gt;" style="text;fontFamily=Arial;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F172A;" vertex="1" parent="book"><mxGeometry x="14" y="248" width="202" height="40" as="geometry" /></mxCell><mxCell id="bk4" value="&lt;b&gt;One brand&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;a shopper only reads&lt;/font&gt;" style="text;fontFamily=Arial;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F172A;" vertex="1" parent="book"><mxGeometry x="14" y="372" width="202" height="40" as="geometry" /></mxCell><mxCell id="cron" value="&lt;b&gt;Schedule · cron&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;*/5 * * * *&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;open, close, expire&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;purge outbox after 7 days&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#EAB308;" vertex="1" parent="lane-eng"><mxGeometry x="562" y="160" width="202" height="84" as="geometry" /></mxCell><mxCell id="outbox" value="&lt;b&gt;Outbox relay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay per domain&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;send or broadcast&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;after the commit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#EAB308;" vertex="1" parent="lane-eng"><mxGeometry x="562" y="276" width="202" height="84" as="geometry" /></mxCell><mxCell id="lane-out" value="4. Facts out" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1188" y="360" width="320" height="280" as="geometry" /></mxCell><mxCell id="out-topic" value="&lt;b&gt;notification.requested&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;send · customer_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;broadcast · S3 key only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;never a phone or email&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="lane-out"><mxGeometry x="16" y="32" width="288" height="108" as="geometry" /></mxCell><mxCell id="out-logo" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="out-topic"><mxGeometry x="16" y="39" width="30" height="30" as="geometry" /></mxCell><mxCell id="out-note" value="No campaign fact. Notification already reads order.events, so a redemption is not a second send." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" vertex="1" parent="lane-out"><mxGeometry x="16" y="156" width="288" height="96" as="geometry" /></mxCell><mxCell id="lane-cons" value="5. Consumers" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1524" y="360" width="420" height="280" as="geometry" /></mxCell><mxCell id="cons" value="&lt;b&gt;Notification&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;notification.requested&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;delivers the send&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot; style=&quot;font-size:11px&quot;&gt;or the broadcast&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingRight=8;strokeWidth=1.5;spacingLeft=10;fillColor=#F5F3FF;strokeColor=#7C3AED;dashed=1;dashPattern=6 4;" vertex="1" parent="lane-cons"><mxGeometry x="16" y="46" width="300" height="80" as="geometry" /></mxCell><mxCell id="ack-out" value="Ack" style="ellipse;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Arial;" vertex="1" parent="lane-cons"><mxGeometry x="332" y="72" width="72" height="28" as="geometry" /></mxCell><mxCell id="cons-note" value="No other consumer. Orders already know the hold, because they asked for it." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" vertex="1" parent="lane-cons"><mxGeometry x="16" y="156" width="388" height="80" as="geometry" /></mxCell><mxCell id="contract" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Orders calls EvaluateBasket and ReserveRedemptions. admin-bff writes. customer-bff reads. This domain consumes order.events and sends notification.requested. gRPC has no Ack. Ack follows each consume.&lt;/font&gt;" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="430" y="1084" width="1514" height="52" as="geometry" /></mxCell><mxCell id="contract2" value="A replay of the same order_id or event_id is a no-op. A missing brand_id is INVALID_ARGUMENT." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="430" y="1136" width="1514" height="24" as="geometry" /></mxCell><mxCell id="lane-data" value="6. Data · commit here, then the fact" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="16" y="1176" width="500" height="350" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;rules · vouchers · member cards&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;holds · redemptions · outbox&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;schema voucher · one role&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="lane-data"><mxGeometry x="16" y="44" width="468" height="100" as="geometry" /></mxCell><mxCell id="pg-logo" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="pg"><mxGeometry x="16" y="35" width="30" height="30" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;broadcast audience file&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;customer ids only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=left;spacingRight=8;strokeWidth=1.5;spacingLeft=62;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="lane-data"><mxGeometry x="16" y="160" width="468" height="84" as="geometry" /></mxCell><mxCell id="s3-logo" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;selectable=0;image=data:image/svg+xml," vertex="1" parent="s3"><mxGeometry x="16" y="27" width="30" height="30" as="geometry" /></mxCell><mxCell id="data-note" value="No Valkey. A hold is a Postgres row, so a cache miss cannot double-spend it (D-04). Amounts are integer satang." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" vertex="1" parent="lane-data"><mxGeometry x="16" y="260" width="468" height="72" as="geometry" /></mxCell><mxCell id="lane-dec" value="Decisions · why this, and what it costs" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="532" y="1176" width="640" height="350" as="geometry" /></mxCell><mxCell id="dec" value="• &lt;b&gt;O-21, deals on the cart.&lt;/b&gt; v1 applies rules in a fixed order. No best-stack search and no margin floor. Cost: the shopper may not get the cheapest mix, and the menu has no deal badge.&lt;br&gt;• &lt;b&gt;Settle on the fact.&lt;/b&gt; The hold is spent on order.events, not by a second gRPC call. Cost: a hold whose order was never committed waits for the cron.&lt;br&gt;• &lt;b&gt;No campaign topic.&lt;/b&gt; A send or a broadcast is notification.requested. Cost: nothing else can subscribe to a redemption.&lt;br&gt;• &lt;b&gt;No Redis lock.&lt;/b&gt; The hold is unique on (brand_id, order_id). Cost: reserve takes a row lock.&lt;br&gt;• &lt;b&gt;ponytail:&lt;/b&gt; one redemption table. Ceiling: no optimizer. Upgrade: the best stack, when O-21 is answered." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" vertex="1" parent="lane-dec"><mxGeometry x="16" y="44" width="608" height="290" as="geometry" /></mxCell><mxCell id="lane-not" value="Not this domain" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1188" y="1176" width="756" height="350" as="geometry" /></mxCell><mxCell id="not" value="&lt;b&gt;Orders&lt;/b&gt; — the cart, the price lines, and the total the shopper agreed.&lt;br&gt;&lt;b&gt;Catalog&lt;/b&gt; — the menu price. This domain calls ListSkus only when a rule names items.&lt;br&gt;&lt;b&gt;Loyalty&lt;/b&gt; — points and tier. A member card here is not a points balance.&lt;br&gt;&lt;b&gt;Payment&lt;/b&gt; — the charge. This domain does not consume payment.events, so a payment does not issue a voucher.&lt;br&gt;&lt;b&gt;Notification&lt;/b&gt; — delivery. &lt;b&gt;Identity&lt;/b&gt; — the customer. The bus carries customer_id only (D-05)." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;" vertex="1" parent="lane-not"><mxGeometry x="16" y="44" width="724" height="280" as="geometry" /></mxCell><mxCell id="e1" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-basket" target="d-basket"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-hold" target="d-hold"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-admin" target="d-admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#EA580C;fontColor=#EA580C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-reads" target="d-reads"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="in-topic" target="d-cons"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-cons" target="ack-in"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.097;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-basket" target="book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="reserve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.366;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-hold" target="book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.634;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-admin" target="book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.903;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-reads" target="book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="commit · release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d-cons" target="book"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="791" y="882" /></Array></mxGeometry></mxCell><mxCell id="e12" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.366;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="book"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="same commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#854D0E;fontColor=#854D0E;exitX=1;exitY=0.634;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="book" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#7C3AED;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="outbox" target="out-topic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#7C3AED;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="out-topic" target="cons"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#059669;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cons" target="ack-out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="commit · read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;fontSize=10;fontFamily=Arial;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;fontColor=#64748B;exitX=0;exitY=0.98;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lane-eng" target="lane-data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="266" y="1120" /></Array><mxPoint as="offset" x="-78" y="-36" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
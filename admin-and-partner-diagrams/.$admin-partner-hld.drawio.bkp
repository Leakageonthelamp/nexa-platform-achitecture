        <mxCell id="title" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" value="&lt;b&gt;Admin &amp;amp; Partner — left to right: command in, engine, fact out&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="2200" x="16" y="8" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="Commands sit left of the engine that consumes them. Facts sit right, after the Postgres commit. Sync authorize and token skip Kafka. No token, secret, or assertion on the bus." vertex="1">
          <mxGeometry height="28" width="2260" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ch1" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#EA580C;fillColor=#FFF7ED;strokeColor=#EA580C;" value="gRPC  ·  authorize / token  (client waits, not on the bus)" vertex="1">

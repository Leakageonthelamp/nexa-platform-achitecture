        </mxCell>
        <mxCell id="ch2" parent="1" style="rounded=1;arcSize=20;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;spacingLeft=14;fontSize=11;strokeWidth=2;fontColor=#0F766E;fillColor=#F0FDFA;strokeColor=#0F766E;" value="JWKS / HTTP  ·  Kong PEP  ·  adapter → Azure AD" vertex="1">

          <mxGeometry height="80" width="306" x="16" y="187" as="geometry" />
        </mxCell>
        <mxCell id="grant" parent="admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;Role + grant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;brand_id or *&lt;br&gt;empty until assigned&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="306" x="338" y="187" as="geometry" />
        </mxCell>
        <mxCell id="sess" parent="admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;Session + JWT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A16207&quot; style=&quot;font-size:11px&quot;&gt;iss=admin · ES512&lt;br&gt;roles[] is a snapshot&lt;/font&gt;" vertex="1">

  <diagram id="admin-partner-hld" name="Admin &amp; Partner HLD">
    <mxGraphModel dx="978" dy="733" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1260" math="0" shadow="0">

        <mxCell id="edge" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;" value="1. Edge  ·  Cloudflare + Kong (only PEP)" vertex="1">

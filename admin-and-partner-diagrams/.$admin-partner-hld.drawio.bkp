        <mxCell id="kong" parent="edge" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;" value="" vertex="1">

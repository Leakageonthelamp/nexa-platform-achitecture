          <mxGeometry height="30" width="30" x="16" y="35" as="geometry" />
        </mxCell>
        <mxCell id="kong-t" parent="kong" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Kong&lt;/b&gt;  ·  only PEP&lt;br&gt;&lt;font color=&quot;#0F766E&quot; style=&quot;font-size:11px&quot;&gt;iss picks the JWKS&lt;br&gt;admin route ≠ partner route&lt;br&gt;iss=identity is rejected&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="160" x="62" y="4" as="geometry" />
        </mxCell>
        <mxCell id="edge-n" parent="edge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;fontColor=#0F172A;" value="&lt;b&gt;Not on the bus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;Authorize and token are sync gRPC. Downstream trusts headers only.&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="236" x="12" y="224" as="geometry" />
        </mxCell>
        <mxCell id="oauth" parent="edge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;OAuth 2.1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0F172A&quot; style=&quot;font-size:11px&quot;&gt;Admin console: auth code + PKCE&lt;br&gt;Partner: client_credentials + private_key_jwt&lt;br&gt;Refresh rotates · reuse kills the family&lt;br&gt;No implicit · no password grant&lt;br&gt;No long-lived API key&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="236" x="12" y="308" as="geometry" />
        </mxCell>
        <mxCell id="edge-id" parent="edge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;fontColor=#0F172A;" value="&lt;b&gt;Customer world stays out&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px&quot;&gt;Identity owns minor_id, social login, OTP, and the customer key. This edge never accepts that JWT.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="236" x="12" y="480" as="geometry" />
        </mxCell>
        <mxCell id="ad" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;admin-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;code + PKCE · S256&lt;br&gt;X-Principal-Id · X-Roles&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="368" x="308" y="324" as="geometry" />
        </mxCell>
        <mxCell id="pa" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;partner-bff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot; style=&quot;font-size:11px&quot;&gt;client_credentials&lt;br&gt;private_key_jwt&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="368" x="308" y="994" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" value="Admin Engine     api · consumer     SoT for principal · role · grant · session · audit" vertex="1">
          <mxGeometry height="490" width="660" x="756" y="120" as="geometry" />
        </mxCell>
        <mxCell id="admin-n" parent="admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1;fontColor=#065F46;" value="&lt;b&gt;Never mints minor_id.&lt;/b&gt;  First Azure login writes a principal and an audit row with no grants. Break-glass admin is seeded outside this path." vertex="1">
          <mxGeometry height="52" width="628" x="16" y="42" as="geometry" />
        </mxCell>
        <mxCell id="sso" parent="admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;fontFamily=Arial;fontSize=12;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;" value="&lt;b&gt;SSO adapter&lt;/b&gt;  ·  a port, not a service&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:11px&quot;&gt;registry selects the provider · azure_ad is the only one enabled&lt;br&gt;core sees subject · email · name · amr&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="628" x="16" y="106" as="geometry" />

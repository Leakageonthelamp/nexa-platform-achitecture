        <mxCell id="title" value="MFG ePlatform — one shared platform runs every brand, from menu to doorstep" style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1536" height="38" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="TPC, SW, BC and every other brand run on the same platform as data, not as separate systems. Customers order in our apps or through aggregators; we take the payment, send the ticket to the kitchen, and get the food to the door." style="fontFamily=Arial;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="32" y="60" width="1536" height="40" as="geometry"/></mxCell>

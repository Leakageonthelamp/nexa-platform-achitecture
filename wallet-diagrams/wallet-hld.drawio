          <mxGeometry height="350" width="640" x="532" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="n44" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="• &lt;b&gt;D-09 provider port.&lt;/b&gt; Payment calls Hold, Capture, Release, and Refund. Cost: a wallet checkout fails when Wallet is down.&lt;br&gt;• &lt;b&gt;D-10 separate ledger.&lt;/b&gt; Stored value is only here. Cost: finance reconciles two ledgers.&lt;br&gt;• &lt;b&gt;D-11 one wallet per brand.&lt;/b&gt; Not tied to the loyalty profile. Cost: no transfer between brands.&lt;br&gt;• &lt;b&gt;P-14 no hold timer.&lt;/b&gt; Order&#39;s sweeper voids, and the void releases. Cost: a hold Payment never closes waits for CSC.&lt;br&gt;• &lt;b&gt;P-15 grant and limit, no freeze.&lt;/b&gt; Cost: one agent acts alone up to the limit. Audit is the control.&lt;br&gt;• &lt;b&gt;P-16 one tender.&lt;/b&gt; Cost: a short balance means the shopper pays all by card.&lt;br&gt;• &lt;b&gt;ponytail:&lt;/b&gt; one entries table, one row lock. Ceiling: no double-entry ledger. Upgrade when finance asks." vertex="1">
          <mxGeometry height="250" width="608" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n45" parent="n15" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="Also P-17: a top-up is captured at authorize and is not refunded to the card." vertex="1">
          <mxGeometry height="32" width="608" x="16" y="300" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#0F172A;horizontal=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;" value="Not this domain" vertex="1">
          <mxGeometry height="350" width="756" x="1188" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="n16" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;" value="&lt;b&gt;Payment&lt;/b&gt; — Omise, the top-up charge, a refund back to a card, the tender row, and the tax invoice.&lt;br&gt;&lt;b&gt;Order, Voucher, MemberCard&lt;/b&gt; — what is bought, and the checkout timeout (P-10).&lt;br&gt;&lt;b&gt;Loyalty&lt;/b&gt; — points, tier, and the loyalty profile. One per brand per customer; this wallet does not reference it.&lt;br&gt;&lt;b&gt;Identity&lt;/b&gt; — the customer and their contact details.&lt;br&gt;&lt;b&gt;Notification&lt;/b&gt; — delivery." vertex="1">
          <mxGeometry height="220" width="724" x="16" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n47" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#0F172A;" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;Payment calls Hold, Capture, Release, and Refund. admin-bff calls Adjust. customer-bff reads. Wallet consumes payment.events (captured top-ups) and sends notification.requested. There is no wallet topic, and gRPC paths have no Ack.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="1552" x="430" y="1078" as="geometry" />
        </mxCell>
        <mxCell id="n48" parent="1" style="text;fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748B;" value="A replay of the same Payment id or idempotency_key is a no-op. A missing brand_id is INVALID_ARGUMENT." vertex="1">
          <mxGeometry height="24" width="1552" x="430" y="1136" as="geometry" />
        </mxCell>

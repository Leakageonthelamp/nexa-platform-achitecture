<mxCell id="p5-v17" parent="p5-v16" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc GetMember(GetMemberRequest) returns (Member);&lt;br&gt;rpc GetBalance(GetBalanceRequest) returns (Balance);&lt;br&gt;rpc ListPostings(ListPostingsRequest) returns (Postings);&lt;br&gt;rpc GetCard(GetCardRequest) returns (Card);&lt;br&gt;&lt;br&gt;Member: brand_id, customer_id, tier, card&lt;br&gt;Balance: points = sum of postings&lt;br&gt;Card: card id, qr, status&lt;br&gt;&lt;br&gt;metadata: x-brand-id, x-principal-id&lt;br&gt;a shopper never passes another customer_id" vertex="1">
<mxGeometry x="16" y="44" width="568" height="344" as="geometry" />
</mxCell>
<mxCell id="p5-v18" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">
<mxGeometry x="632" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p5-v19" parent="p5-v18" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="no writes&lt;br&gt;&lt;br&gt;read&lt;br&gt;members by (brand_id, customer_id)&lt;br&gt;cards by member&lt;br&gt;postings by member, keyset&lt;br&gt;&lt;br&gt;no outbox&lt;br&gt;no personal data in the response&lt;br&gt;beyond the card and the points" vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>
<mxCell id="p5-v20" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1">
<mxGeometry x="1058" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p5-v21" parent="p5-v20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• A read. No idempotency key.&lt;br&gt;• Keyset on posting id, so a page does not shift when a new posting arrives.&lt;br&gt;• Deadline from the BFF. No retry of a NOT_FOUND." vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>
<mxCell id="p5-v22" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
<mxGeometry x="1484" y="544" width="460" height="400" as="geometry" />
</mxCell>
<mxCell id="p5-v23" parent="p5-v22" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Points are computed as the sum of postings. They are not a stored column.&lt;br&gt;• A missing member is NOT_FOUND, not a zero balance. A guest has no row.&lt;br&gt;• GetCard returns the card that identifies the member. It does not return a voucher code." vertex="1">
<mxGeometry x="16" y="44" width="428" height="344" as="geometry" />
</mxCell>
</root>
</mxGraphModel>
</diagram>

<mxCell id="p2-v25" parent="p2-v8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;container=1;collapsible=0;fontFamily=Arial;fontSize=12;fontColor=#0F172A;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=8;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.5;" value="&lt;b&gt;Outbox relay · worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;one relay per domain&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#854D0E&quot; style=&quot;font-size:11px&quot;&gt;publishes after the commit&lt;/font&gt;" vertex="1">

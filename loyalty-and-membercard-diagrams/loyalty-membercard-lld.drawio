<mxGeometry x="16" y="544" width="600" height="400" as="geometry" />
</mxCell>
<mxCell id="p2-v31" parent="p2-v30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="topic order.events&lt;br&gt;key brand_id:order_id&lt;br&gt;headers event_id, event_type, brand_id,&lt;br&gt;occurred_at, version, traceparent&lt;br&gt;&lt;br&gt;fields used: order_id, brand_id, store_id,&lt;br&gt;customer_id, status, total_satang, lines&lt;br&gt;&lt;br&gt;out notification.requested&lt;br&gt;send, template loyalty.points_earned&lt;br&gt;or loyalty.points_reversed&lt;br&gt;customer_id only — no phone, no email" vertex="1">
<mxGeometry x="16" y="44" width="568" height="344" as="geometry" />
</mxCell>
<mxCell id="p2-v32" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">
<mxGeometry x="632" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p2-v33" parent="p2-v32" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="processed_event&lt;br&gt;event_id PK, topic, applied_at&lt;br&gt;&lt;br&gt;members&lt;br&gt;UNIQUE(brand_id, customer_id)&lt;br&gt;insert on the first completed order&lt;br&gt;card issued in the same commit&lt;br&gt;&lt;br&gt;receipts&lt;br&gt;UNIQUE(brand_id, order_id)&lt;br&gt;status posted or rejected or reversed&lt;br&gt;&lt;br&gt;postings&lt;br&gt;kind earn or reverse&lt;br&gt;idem_key = brand:order:kind&lt;br&gt;&lt;br&gt;outbox&lt;br&gt;the send, same transaction" vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>
<mxCell id="p2-v34" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Dedupe  ·  deadline  ·  retry" vertex="1">
<mxGeometry x="1058" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p2-v35" parent="p2-v34" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• processed_event in the same transaction. A conflict means already done, then Ack.&lt;br&gt;• UNIQUE(brand_id, order_id) and the version. An older version is a no-op.&lt;br&gt;• A guest (no customer_id) is rejected(guest). No points in v1.&lt;br&gt;• No rule set: rejected(no_rule_set), alert, Ack. Re-applied when a matching rule set is published.&lt;br&gt;• DB error: no commit, no Ack. Three retries, then loyalty.dlq, then Ack.&lt;br&gt;• Cancelled: a reversing posting only if points were posted. The row is never edited." vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>
<mxCell id="p2-v36" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
<mxGeometry x="1484" y="544" width="460" height="400" as="geometry" />
</mxCell>
<mxCell id="p2-v37" parent="p2-v36" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• Enrol only here. Identity publishes no join fact, so the first completed order with a customer_id creates the member and the card.&lt;br&gt;• A line that carries a plan_id activates or extends a paid membership in the same commit.&lt;br&gt;• No loyalty.events. The outbox sends notification.requested.&lt;br&gt;• A refund on payment.events is not consumed. Points stay until the registry adds Loyalty.&lt;br&gt;• D-11: one member per brand. Points do not cross brands (O-20)." vertex="1">
<mxGeometry x="16" y="44" width="428" height="344" as="geometry" />
</mxCell>
</root>
</mxGraphModel>
</diagram>

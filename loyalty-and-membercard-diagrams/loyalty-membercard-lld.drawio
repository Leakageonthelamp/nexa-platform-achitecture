<mxCell id="p3-v27" parent="p3-v26" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="rpc AdjustPoints(AdjustPointsRequest)&lt;br&gt;returns (AdjustPointsResponse);&lt;br&gt;&lt;br&gt;message AdjustPointsRequest {&lt;br&gt;string idempotency_key = 1;&lt;br&gt;string brand_id = 2;&lt;br&gt;string customer_id = 3;&lt;br&gt;int64 points = 4;&lt;br&gt;string reason_code = 5;&lt;br&gt;}&lt;br&gt;&lt;br&gt;metadata: x-brand-id, x-roles, traceparent&lt;br&gt;the grant loyalty.adjust carries the limit&lt;br&gt;&lt;br&gt;card replace is the same commit:&lt;br&gt;old card voided, new card issued,&lt;br&gt;counters move" vertex="1">
<mxGeometry x="16" y="44" width="568" height="344" as="geometry" />
</mxCell>
<mxCell id="p3-v28" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">

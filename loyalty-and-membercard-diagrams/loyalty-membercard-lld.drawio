<mxCell id="p6-v18" parent="p6-v17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="schedule 0 2 * * *&lt;br&gt;timezone Asia/Bangkok&lt;br&gt;concurrencyPolicy Forbid&lt;br&gt;&lt;br&gt;per member&lt;br&gt;window = trailing 12 months&lt;br&gt;one brand at a time&lt;br&gt;&lt;br&gt;IssueVoucher&lt;br&gt;idempotency_key = brand:member:tier:period&lt;br&gt;void the previous benefit first&lt;br&gt;&lt;br&gt;out notification.requested&lt;br&gt;template loyalty.tier_changed&lt;br&gt;customer_id only" vertex="1">

<mxCell id="p6-v18" parent="p6-v17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="schedule 0 1 * * *&lt;br&gt;timezone Asia/Bangkok&lt;br&gt;concurrencyPolicy Forbid&lt;br&gt;&lt;br&gt;per account&lt;br&gt;buckets with expires_on ≤ today&lt;br&gt;posting kind = expire&lt;br&gt;idem_key = brand:bucket:expire&lt;br&gt;&lt;br&gt;notice, 14 days ahead&lt;br&gt;notification.requested only&lt;br&gt;template loyalty.points_expiring&lt;br&gt;no posting on the notice run" vertex="1">
<mxGeometry x="16" y="44" width="568" height="344" as="geometry" />
</mxCell>
<mxCell id="p6-v19" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Writes  ·  tables and outbox" vertex="1">
<mxGeometry x="632" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p6-v20" parent="p6-v19" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Courier New;" value="postings&lt;br&gt;kind = expire&lt;br&gt;one account per transaction&lt;br&gt;&lt;br&gt;expiry_buckets&lt;br&gt;status closed&lt;br&gt;&lt;br&gt;outbox&lt;br&gt;template loyalty.points_expired&lt;br&gt;customer_id only&lt;br&gt;&lt;br&gt;no edit of an earn posting" vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>

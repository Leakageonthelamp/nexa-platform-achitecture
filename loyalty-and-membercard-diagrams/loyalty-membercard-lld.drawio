<mxGeometry x="1058" y="544" width="410" height="400" as="geometry" />
</mxCell>
<mxCell id="p6-v22" parent="p6-v21" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• idem_key = brand:bucket:expire, so a second run does nothing.&lt;br&gt;• Safe to run twice (P-07). SKIP LOCKED lets a crashed run continue.&lt;br&gt;• A DB error rolls back that account only. The job does not Ack a Kafka record; it is a cron." vertex="1">
<mxGeometry x="16" y="44" width="378" height="344" as="geometry" />
</mxCell>
<mxCell id="p6-v23" parent="1" style="swimlane;startSize=32;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#64748B;swimlaneFillColor=#F8FAFC;strokeWidth=1.5;fontColor=#0F172A;" value="Notes  ·  decisions cited" vertex="1">
<mxGeometry x="1484" y="544" width="460" height="400" as="geometry" />
</mxCell>
<mxCell id="p6-v24" parent="p6-v23" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#0F172A;fontFamily=Arial;" value="• The notice run sends notification.requested and writes nothing else.&lt;br&gt;• No loyalty.events. The data lake does not see a daily snapshot until a fact exists.&lt;br&gt;• Birthday vouchers are not on this job. birth_month is not on the bus." vertex="1">
<mxGeometry x="16" y="44" width="428" height="344" as="geometry" />
</mxCell>
</root>
